<%- include('../partials/dash-top', { user: user, active: active, title: '교육생 자료집' }) %>

<style>
  /* 자료집 — 대시보드 색을 그대로 따른다 */
  .gd-top { display:flex; align-items:center; justify-content:space-between; gap:12px;
            flex-wrap:wrap; margin-bottom:16px; }
  .gd-search { display:flex; gap:8px; flex:1; min-width:220px; max-width:420px; }
  .gd-search input { flex:1; padding:11px 13px; border:1px solid var(--beige);
    border-radius:10px; font-size:15px; font-family:inherit; background:var(--card); color:var(--ink); outline:none; }
  .gd-search input:focus { border-color:var(--gold); }
  .gd-search button { padding:11px 16px; border:1px solid var(--beige); background:var(--card);
    border-radius:10px; font-size:14px; font-weight:600; color:#6B6656; cursor:pointer; font-family:inherit; }

  .gd-prev { display:flex; align-items:center; gap:5px; flex-wrap:wrap;
    background:var(--navy); border-radius:12px; padding:10px 14px; margin-bottom:12px; }
  .gd-prev .lb { font-size:11.5px; font-weight:800; color:#C9BDA8; margin-right:4px; }
  .gd-prev a { padding:6px 12px; border-radius:100px; font-size:12.5px; font-weight:700;
    color:#E8E3D6; text-decoration:none; background:rgba(255,255,255,.12); }
  .gd-prev a:hover { background:rgba(255,255,255,.24); }
  .gd-prev a.on { background:var(--gold); color:#fff; }
  .gd-prev .now { font-size:11.5px; color:#E8D3A8; margin-left:6px; }

  .gd-note { background:#FBF8F1; border:1px solid var(--beige); border-left:3px solid var(--gold);
    border-radius:0 12px 12px 0; padding:14px 17px; margin-bottom:16px;
    font-size:14px; line-height:1.8; color:#4A4438; word-break:keep-all; }
  .gd-note b { color:var(--ink); }
  .gd-note a { color:#8A6F3C; font-weight:700; }

  .gd-weeks { margin-bottom:8px; }
  .gd-weeks .gd-cat { background:#FBF6EC; border-color:#E9E0CF; color:#8A6F3C; }
  .gd-weeks .gd-cat.on { background:var(--gold); border-color:var(--gold); color:#fff; }

  .gd-cats { display:flex; gap:6px; overflow-x:auto; padding-bottom:4px; margin-bottom:18px; }
  .gd-cats::-webkit-scrollbar { display:none; }
  .gd-cat { flex:0 0 auto; padding:9px 15px; border-radius:100px; border:1px solid var(--beige);
    background:var(--card); color:#6B6656; font-size:14px; font-weight:600; text-decoration:none;
    display:flex; align-items:center; gap:6px; white-space:nowrap; }
  .gd-cat .n { font-size:11px; opacity:.6; font-weight:700; }
  .gd-cat.on { background:var(--navy); border-color:var(--navy); color:#fff; }
  .gd-cat.on .n { color:rgba(255,255,255,.65); }

  .gd-item { display:block; text-decoration:none; color:inherit; background:var(--card);
    border:1px solid var(--beige); border-radius:14px; padding:16px 18px; margin-bottom:9px;
    transition:border-color .15s, box-shadow .15s; }
  .gd-item:hover { border-color:var(--gold); box-shadow:0 4px 14px rgba(24,34,52,.06); }
  .gd-item .t { font-size:16px; font-weight:700; letter-spacing:-.01em;
    display:flex; align-items:center; gap:7px; flex-wrap:wrap; }
  .gd-pin { font-size:11px; font-weight:700; color:#fff; background:var(--gold);
    padding:2px 8px; border-radius:100px; }
  .gd-item.lock { opacity:.55; }
  .gd-item.lock .t:after { content:' 🔒'; font-size:13px; }
  .wk { font-size:11px; font-weight:800; padding:2px 9px; border-radius:100px; }
  .wk.on { background:#E8F3ED; color:#2E7D5B; }
  .wk.off { background:#F4EFE3; color:#8A6F3C; }
  .dleft { font-size:11px; font-weight:700; color:#A8332B; }

  /* 총정리 자료집 안내 */
  .gd-total { background:#fff; border:1px solid var(--beige); border-left:3px solid var(--gold);
    border-radius:0 14px 14px 0; padding:16px 18px; margin-bottom:14px; }
  .gd-total .tt { font-size:16px; font-weight:800; display:flex; align-items:center;
    gap:9px; flex-wrap:wrap; }
  .gd-total .lk { font-size:11.5px; font-weight:700; color:#A8332B;
    background:#FBF1EF; padding:3px 10px; border-radius:100px; }
  .gd-total .td { font-size:13.5px; color:#6B6656; margin-top:6px; line-height:1.7;
    word-break:keep-all; }
  .gd-total .tl { display:flex; flex-wrap:wrap; gap:6px; margin-top:11px; }
  .gd-total .ti { font-size:12.5px; font-weight:700; color:#8A6F3C;
    background:#F4EFE3; padding:5px 12px; border-radius:100px; }

  .gd-item .meta { margin-top:7px; font-size:11.5px; color:#9A9384; display:flex; gap:10px; flex-wrap:wrap; }
  .gd-tag { background:#F4EFE3; color:#8A6F3C; padding:2px 8px; border-radius:5px; font-weight:600; }

  .gd-empty { text-align:center; padding:56px 20px; color:#9A9384; font-size:14px; line-height:1.8; }
  .gd-write { padding:11px 18px; background:var(--navy); color:#fff; border:0; border-radius:10px;
    font-size:14px; font-weight:700; text-decoration:none; display:inline-block; }
</style>

<div class="gd-top">
  <form class="gd-search" method="get" action="/guide/all">
    <input type="search" name="q" value="<%= q || '' %>" placeholder="제목·내용 찾기">
    <button type="submit">찾기</button>
  </form>
  <% if (user.role === 'admin') { %>
    <a href="/admin/guide" class="gd-write">자료집 관리</a>
  <% } %>
</div>

<% if (user.role === 'admin') { %>
  <div class="gd-prev">
    <span class="lb">교육생 눈으로 보기</span>
    <a href="/guide/all" class="<%= !preview ? 'on' : '' %>">관리자</a>
    <% [1,2,3,4,5].forEach(function (w) { %>
      <a href="/guide/all?week=<%= w %>" class="<%= preview === w ? 'on' : '' %>">
        <%= w === 5 ? '전체' : w + '주차' %>
      </a>
    <% }); %>
    <% if (preview) { %><span class="now">지금 <%= preview === 5 ? '전체 공개' : preview + '주차' %> 교육생 화면입니다</span><% } %>
  </div>
<% } %>

<% var wkf = (typeof wkFilter !== 'undefined') ? wkFilter : null; %>
<div class="gd-note">
  <% if (wkf === 5) { %>
    <b>총정리 자료집입니다.</b>
    상담 중에 급하게 찾아보셔야 할 때, 분류나 검색으로 바로 찾아보세요.
    주차별 강의는 <a href="/guide">주차 목록</a>에서 보실 수 있습니다.
  <% } else { %>
  <b>주차별 자료를 한곳에 모아둔 페이지입니다.</b>
  상담 중에 급하게 찾아보셔야 할 때, 분류나 검색으로 바로 찾아보세요.
  처음 배우실 때는 <a href="/guide">주차별로 하나씩</a> 따라오시는 편이 훨씬 잘 익혀집니다.
  <% if (typeof myWeek !== 'undefined' && myWeek && myWeek < 5) { %>
    <br>지금은 <b><%= myWeek %>주차</b>까지 열려 있습니다.
  <% } %>
  <% } %>
</div>

<% /* 총정리는 5주차에 열린다. 아직 그 전이면 안내를 띄운다.
      (목록에 총정리 글이 없어도 판단이 되도록 내 주차로 본다) */
   var myW = (typeof myWeek !== 'undefined' && myWeek) ? myWeek : 1;
   var totalLocked = posts.filter(function (p) { return p.week === 5 && p.locked; });
   var totalDays = totalLocked.length ? totalLocked[0].daysLeft : Math.max(0, (5 - myW) * 7); %>
<% if (myW < 5 && user.role !== 'admin') { %>
  <div class="gd-total">
    <div class="tt">📚 총정리 자료집 <span class="lk">🔒 <%= totalDays > 0 ? totalDays + '일 뒤 열림' : '곧 열림' %></span></div>
    <div class="td">4주차를 다 마치시면 아래 자료가 한꺼번에 열립니다.</div>
    <div class="tl">
      <% catList.forEach(function (c) { %>
        <span class="ti"><%= c.name %></span>
      <% }); %>
    </div>
  </div>
<% } %>

<% var WK = ['언제나','1주차','2주차','3주차','4주차','총정리'];
   var wkc = (typeof wkCount !== 'undefined') ? wkCount : {};
   var qs = function (w) {
     var p = [];
     if (w !== null) p.push('wk=' + w);
     if (catId) p.push('cat=' + catId);
     if (q) p.push('q=' + encodeURIComponent(q));
     if (typeof preview !== 'undefined' && preview) p.push('week=' + preview);
     return p.length ? '?' + p.join('&') : '';
   }; %>
<div class="gd-cats gd-weeks">
  <a href="/guide/all<%= qs(null) %>" class="gd-cat <%= wkf === null ? 'on' : '' %>">전체</a>
  <% [1,2,3,4,5,0].forEach(function (w) { %>
    <% if (wkc[w]) { %>
      <a href="/guide/all<%= qs(w) %>" class="gd-cat <%= wkf === w ? 'on' : '' %>">
        <%= WK[w] %><span class="n"><%= wkc[w] %></span>
      </a>
    <% } %>
  <% }); %>
</div>

<div class="gd-cats">
  <a href="/guide/all" class="gd-cat <%= !catId ? 'on' : '' %>">전체</a>
  <% catList.forEach(function (c) { %>
    <a href="/guide/all?cat=<%= c.id %>" class="gd-cat <%= catId === c.id ? 'on' : '' %>">
      <%= c.name %><span class="n"><%= c.n %></span>
    </a>
  <% }); %>
</div>

<% if (!posts.length) { %>
  <div class="gd-empty">
    <% if (q) { %>
      찾으시는 자료가 없습니다.<br>다른 말로 찾아보세요.
    <% } else { %>
      아직 올라온 자료가 없습니다.
    <% } %>
  </div>
<% } else { %>
  <% posts.forEach(function (p) { %>
    <a href="/guide/<%= p.id %>" class="gd-item <%= p.locked ? 'lock' : '' %>">
      <div class="t">
        <% if (p.pinned) { %><span class="gd-pin">중요</span><% } %>
        <%= p.title %>
      </div>
      <div class="meta">
        <% /* 주차로 걸러서 보는 중이면 딱지를 또 붙일 필요가 없다.
              총정리 화면에서 줄마다 '총정리'가 붙으면 지저분하다. */ %>
        <% if (p.week && wkf === null) { %>
          <span class="wk <%= p.locked ? 'off' : 'on' %>"><%= p.weekLabel %></span>
        <% } %>
        <% if (p.locked) { %>
          <span class="dleft">
            <%= p.daysLeft > 0 ? p.daysLeft + '일 뒤 열림' : '곧 열림' %>
          </span>
        <% } %>
        <% if (p.cat_name) { %><span class="gd-tag"><%= p.cat_name %></span><% } %>
        <span><%= new Date(p.created_at).toLocaleDateString('ko-KR') %></span>
        <span><%= p.views %>번 읽음</span>
      </div>
    </a>
  <% }); %>
<% } %>

<%- include('../partials/dash-bottom') %>
