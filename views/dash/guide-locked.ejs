<%- include('../partials/dash-top', { user: user, active: active, title: '교육생 자료집' }) %>

<style>
  .lk { max-width:520px; margin:40px auto; background:#fff; border:1px solid var(--beige);
    border-radius:18px; padding:40px 32px; text-align:center; }
  .lk .ic { font-size:40px; }
  .lk h1 { font-family:"Nanum Myeongjo",serif; font-size:22px; margin:16px 0 8px;
    word-break:keep-all; line-height:1.45; }
  .lk .wk { display:inline-block; background:var(--gold); color:#fff; font-size:12.5px;
    font-weight:800; padding:5px 14px; border-radius:100px; margin-bottom:14px; }
  .lk p { font-size:14.5px; line-height:1.85; color:#6B6656; margin:0 0 6px; word-break:keep-all; }
  .lk .days { font-size:17px; font-weight:800; color:var(--ink); margin:14px 0 4px; }
  .lk a { display:inline-block; margin-top:22px; padding:13px 24px; background:var(--navy);
    color:#fff; border-radius:11px; font-size:15px; font-weight:700; text-decoration:none; }
</style>

<div class="lk">
  <div class="ic">🔒</div>
  <div class="wk"><%= weekLabel %></div>
  <h1><%= post.title %></h1>
  <% if (daysLeft > 0) { %>
    <div class="days"><%= daysLeft %>일 뒤에 열립니다</div>
    <p>한 번에 다 보시는 것보다<br>주차별로 하나씩 따라오시는 편이 훨씬 잘 익혀집니다.</p>
  <% } else { %>
    <div class="days">곧 열립니다</div>
    <p>잠시 뒤 다시 들어와 주세요.</p>
  <% } %>
  <p>그동안 이미 열린 자료를 먼저 읽고 직접 해보세요.</p>
  <a href="/guide">← 자료집으로 돌아가기</a>
</div>

<%- include('../partials/dash-bottom') %>
