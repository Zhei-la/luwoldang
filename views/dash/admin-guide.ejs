<%- include('../partials/dash-top', { user: user, active: active, title: '자료집 관리' }) %>

<style>
  .ag-top { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:18px; }
  .ag-top a, .ag-top button { padding:11px 18px; border:1px solid var(--beige); background:var(--card);
    border-radius:10px; font-size:14px; font-weight:700; color:#4A4438; text-decoration:none;
    cursor:pointer; font-family:inherit; }
  .ag-top .new { background:var(--navy); border-color:var(--navy); color:#fff; }

  .ag-row { display:flex; align-items:center; gap:12px; background:var(--card); border:1px solid var(--beige);
    border-radius:12px; padding:14px 16px; margin-bottom:8px; }
  .ag-row .t { flex:1; min-width:0; }
  .ag-row .t a { font-size:15.5px; font-weight:700; color:var(--ink); text-decoration:none;
    display:flex; align-items:center; gap:7px; flex-wrap:wrap; }
  .ag-row .t a:hover { color:var(--gold); }
  .ag-row .meta { margin-top:6px; font-size:11.5px; color:#9A9384; display:flex; gap:9px; flex-wrap:wrap; }
  .ag-tag { background:#F4EFE3; color:#8A6F3C; padding:2px 8px; border-radius:5px; font-weight:600; }
  .ag-pin { font-size:11px; font-weight:700; color:#fff; background:var(--gold); padding:2px 8px; border-radius:100px; }
  .ag-hide { font-size:11px; font-weight:700; color:#A8332B; background:#FBF1EF; padding:2px 8px; border-radius:100px; }
  .ag-row .edit { flex:0 0 auto; padding:9px 14px; border:1px solid var(--beige); background:var(--card);
    border-radius:9px; font-size:13px; font-weight:600; color:#6B6656; text-decoration:none; }

  .ag-row .del { color:#A8332B; cursor:pointer; font-family:inherit; }
  .ag-row .del:hover { border-color:#A8332B; }
  .ag-ck { flex:0 0 auto; width:17px; height:17px; }

  .ag-bulk { display:flex; align-items:center; gap:12px; flex-wrap:wrap;
    padding:11px 16px; background:#FBF8F1; border:1px solid var(--beige);
    border-radius:11px; margin-bottom:10px; font-size:14px; color:#4A4438; }
  .ag-bulk label { display:flex; align-items:center; gap:7px; cursor:pointer; }
  .ag-bulk input { width:17px; height:17px; }
  .ag-bulk .cnt { flex:1; font-size:12.5px; color:#9A9384; }
  .wkb { flex:0 0 auto; font-size:11px; font-weight:800; color:#8A6F3C;
    background:#F4EFE3; padding:3px 9px; border-radius:100px; white-space:nowrap; }
  .ag-bulk select { padding:8px 11px; border:1px solid var(--beige); background:#fff;
    border-radius:9px; font-size:13px; font-family:inherit; color:#4A4438; }

  .ag-bulk button { padding:8px 15px; border:1px solid var(--beige); background:var(--card);
    border-radius:9px; font-size:13.5px; font-weight:700; color:#A8332B;
    cursor:pointer; font-family:inherit; }
  .ag-bulk button:disabled { opacity:.4; cursor:default; color:#9A9384; }

  .ag-empty { text-align:center; padding:56px 20px; color:#9A9384; font-size:14px; line-height:1.9; }

  /* 분류 관리 */
  .ag-cats { display:none; background:var(--card); border:1px solid var(--beige); border-radius:12px;
    padding:18px 20px; margin-bottom:18px; max-width:560px; }
  .ag-cats.on { display:block; }
  .ag-cats h3 { margin:0 0 12px; font-size:16px; font-weight:800; }
  .ac-row { display:flex; align-items:center; gap:8px; padding:10px 0; border-bottom:1px solid var(--beige); }
  .ac-row:last-of-type { border-bottom:0; }
  .ac-row .nm { flex:1; font-size:15px; font-weight:600; }
  .ac-row .n { font-size:11.5px; color:#9A9384; }
  .ac-row button { padding:6px 11px; border:1px solid var(--beige); background:#FBF8F1;
    border-radius:8px; font-size:12.5px; color:#6B6656; cursor:pointer; font-family:inherit; }
  .ac-add { display:flex; gap:8px; margin-top:14px; }
  .ac-add input { flex:1; padding:10px 12px; border:1px solid var(--beige); border-radius:9px;
    font-size:14px; font-family:inherit; outline:none; }
  .ac-add button { padding:10px 16px; background:var(--navy); color:#fff; border:0;
    border-radius:9px; font-size:14px; font-weight:700; cursor:pointer; font-family:inherit; }
</style>

<div class="ag-top">
  <a href="/admin/guide/edit" class="new">+ 새 자료 쓰기</a>
  <button type="button" id="btnCats">분류 관리</button>
  <a href="/admin/guide/import">노션에서 가져오기</a>
  <a href="/guide">교육생 화면으로 보기</a>
</div>

<div class="ag-cats" id="agCats">
  <h3>분류 관리</h3>
  <div id="acList"></div>
  <div class="ac-add">
    <input type="text" id="acNew" placeholder="새 분류 이름">
    <button type="button" id="acAdd">추가</button>
  </div>
</div>

<% if (posts.length) { %>
  <div class="ag-bulk">
    <label><input type="checkbox" id="ckAll"> 전체 고르기</label>
    <span class="cnt" id="ckCnt"></span>
    <select id="selWeek">
      <option value="">공개 시점 바꾸기…</option>
      <% ['언제나 보임','1주차','2주차','3주차','4주차','전체 자료집 (4주차 후)'].forEach(function(t,i){ %>
        <option value="<%= i %>"><%= t %></option>
      <% }); %>
    </select>
    <button type="button" id="btnDelSel" disabled>고른 것 삭제</button>
  </div>
<% } %>

<% if (!posts.length) { %>
  <div class="ag-empty">
    아직 올린 자료가 없습니다.<br>
    위 <b>새 자료 쓰기</b>로 첫 자료를 올려보세요.
  </div>
<% } else { %>
  <% posts.forEach(function (p) { %>
    <div class="ag-row" data-id="<%= p.id %>">
      <input type="checkbox" class="ag-ck">
      <div class="t">
        <a href="/guide/<%= p.id %>">
          <% if (p.pinned) { %><span class="ag-pin">중요</span><% } %>
          <% if (!p.published) { %><span class="ag-hide">비공개</span><% } %>
          <%= p.title %>
        </a>
        <div class="meta">
          <% if (p.cat_name) { %><span class="ag-tag"><%= p.cat_name %></span><% } %>
          <span><%= new Date(p.created_at).toLocaleDateString('ko-KR') %></span>
          <span><%= p.views %>번 읽음</span>
        </div>
      </div>
      <% if (p.week) { %>
        <span class="wkb"><%= ['','1주차','2주차','3주차','4주차','전체 자료집 (4주차 후)'][p.week] %></span>
      <% } %>
      <a href="/admin/guide/views/<%= p.id %>" class="edit">읽은 사람</a>
      <a href="/admin/guide/edit/<%= p.id %>" class="edit">고치기</a>
      <button type="button" class="edit del" data-t="<%= p.title %>">삭제</button>
    </div>
  <% }); %>
<% } %>

<script>
(function () {
  var cats = <%- JSON.stringify(catList) %>;
  var box = document.getElementById('agCats');

  document.getElementById('btnCats').addEventListener('click', function () {
    box.classList.toggle('on');
    if (box.classList.contains('on')) draw();
  });

  function draw() {
    document.getElementById('acList').innerHTML = cats.map(function (c, i) {
      return '<div class="ac-row">' +
        '<span class="nm">' + esc(c.name) + '</span>' +
        '<span class="n">' + c.n + '개</span>' +
        '<button data-act="up" data-id="' + c.id + '"' + (i === 0 ? ' disabled style="opacity:.3"' : '') + '>↑</button>' +
        '<button data-act="down" data-id="' + c.id + '"' + (i === cats.length - 1 ? ' disabled style="opacity:.3"' : '') + '>↓</button>' +
        '<button data-act="rename" data-id="' + c.id + '">이름</button>' +
        '<button data-act="del" data-id="' + c.id + '">삭제</button>' +
      '</div>';
    }).join('');
  }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  function send(payload) {
    return fetch('/admin/guide/cat', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }).then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.ok) throw new Error(d.error || '실패');
        cats = d.cats; draw();
      })
      .catch(function (e) { alert('실패: ' + e.message); });
  }

  document.getElementById('acList').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-act]');
    if (!b) return;
    var id = Number(b.dataset.id), act = b.dataset.act;
    var cur = cats.find(function (c) { return c.id === id; }) || {};

    if (act === 'rename') {
      var v = prompt('분류 이름', cur.name);
      if (v && v.trim()) send({ act: 'rename', id: id, name: v.trim() });
    } else if (act === 'del') {
      var msg = cur.n
        ? '"' + cur.name + '" 분류를 지울까요?\n안에 있는 자료 ' + cur.n + '개는 남고 분류만 없어집니다.'
        : '"' + cur.name + '" 분류를 지울까요?';
      if (confirm(msg)) send({ act: 'del', id: id });
    } else {
      send({ act: 'move', id: id, dir: act });
    }
  });

  /* ── 자료 지우기 ── */
  function delOne(id) {
    return fetch('/admin/guide/delete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: id })
    }).then(function (r) { return r.json(); });
  }

  /* 한 개 지우기 */
  document.addEventListener('click', function (e) {
    var b = e.target.closest('.ag-row .del');
    if (!b) return;
    var row = b.closest('.ag-row');
    if (!confirm('"' + b.dataset.t + '"\n\n이 자료를 지울까요? 되돌릴 수 없습니다.')) return;
    b.disabled = true; b.textContent = '지우는 중';
    delOne(row.dataset.id).then(function (d) {
      if (!d.ok) throw new Error(d.error || '실패');
      row.remove();
      refreshCnt();
    }).catch(function (err) {
      alert('지우지 못했습니다: ' + err.message);
      b.disabled = false; b.textContent = '삭제';
    });
  });

  /* 여러 개 한 번에 */
  var ckAll = document.getElementById('ckAll');
  var btnDelSel = document.getElementById('btnDelSel');
  var ckCnt = document.getElementById('ckCnt');

  function picked() {
    return [].filter.call(document.querySelectorAll('.ag-row'), function (r) {
      var c = r.querySelector('.ag-ck');
      return c && c.checked;
    });
  }
  function refreshCnt() {
    if (!btnDelSel) return;
    var n = picked().length;
    btnDelSel.disabled = !n;
    ckCnt.textContent = n ? n + '개 골랐습니다' : '';
    var boxes = document.querySelectorAll('.ag-ck');
    if (ckAll) ckAll.checked = boxes.length > 0 && n === boxes.length;
  }

  if (ckAll) {
    ckAll.addEventListener('change', function () {
      [].forEach.call(document.querySelectorAll('.ag-ck'), function (c) { c.checked = ckAll.checked; });
      refreshCnt();
    });
  }
  document.addEventListener('change', function (e) {
    if (e.target.classList.contains('ag-ck')) refreshCnt();
  });

  /* 고른 글의 공개 시점을 한 번에 바꾼다 */
  var selWeek = document.getElementById('selWeek');
  if (selWeek) {
    selWeek.addEventListener('change', function () {
      var w = selWeek.value;
      selWeek.value = '';
      if (w === '') return;
      var rows = picked();
      if (!rows.length) { alert('먼저 바꿀 자료를 골라주세요.'); return; }
      fetch('/admin/guide/week', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids: rows.map(function (r) { return r.dataset.id; }), week: Number(w) })
      })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.ok) throw new Error(d.error || '실패');
        location.reload();
      })
      .catch(function (e) { alert('바꾸지 못했습니다: ' + e.message); });
    });
  }

  if (btnDelSel) {
    btnDelSel.addEventListener('click', async function () {
      var rows = picked();
      if (!rows.length) return;
      if (!confirm(rows.length + '개 자료를 지울까요?\n되돌릴 수 없습니다.')) return;

      btnDelSel.disabled = true;
      var fail = 0;
      for (var i = 0; i < rows.length; i++) {
        btnDelSel.textContent = '지우는 중 ' + (i + 1) + '/' + rows.length;
        try {
          var d = await delOne(rows[i].dataset.id);
          if (!d.ok) throw new Error(d.error || '실패');
          rows[i].remove();
        } catch (e) { fail++; }
      }
      btnDelSel.textContent = '고른 것 삭제';
      refreshCnt();
      if (fail) alert(fail + '개는 지우지 못했습니다.');
    });
  }

  document.getElementById('acAdd').addEventListener('click', function () {
    var v = document.getElementById('acNew').value.trim();
    if (!v) return;
    send({ act: 'add', name: v }).then(function () {
      document.getElementById('acNew').value = '';
    });
  });
})();
</script>

<%- include('../partials/dash-bottom') %>
