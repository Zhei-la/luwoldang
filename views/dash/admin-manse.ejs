<%- include('../partials/dash-top', { user: user, active: active, title: '만세력 연동' }) %>

<style>
  /* 상태를 맨 위에 크게 — 지금 어디까지 왔는지가 제일 궁금하다 */
  .mn-top { border-radius:14px; padding:20px 22px; margin-bottom:18px; }
  .mn-top.off { background:#FBF6EC; border:1px solid #E8D9B8; }
  .mn-top.on  { background:#EEF6F0; border:1px solid #BFDCC9; }
  .mn-top .st { font-size:18px; font-weight:800; color:var(--ink); margin:0 0 7px; }
  .mn-top .ds { font-size:14px; line-height:1.85; color:#4A4438; margin:0; word-break:keep-all; }
  .mn-top .ds b { color:var(--ink); }

  .mn-what { background:var(--card); border:1px solid var(--beige); border-radius:14px;
    margin-bottom:18px; }
  .mn-what summary { cursor:pointer; padding:16px 20px; font-size:15px; font-weight:800;
    color:var(--ink); list-style:none; display:flex; align-items:center; gap:8px; }
  .mn-what summary::-webkit-details-marker { display:none; }
  .mn-what summary:before { content:'▸'; color:var(--gold); font-size:13px; }
  .mn-what[open] summary:before { content:'▾'; }
  .mn-what .in { padding:0 20px 20px; }
  .mn-what p { font-size:14px; line-height:1.9; color:#4A4438; margin:0 0 12px;
    word-break:keep-all; }
  .mn-what p b { color:var(--ink); }
  .mn-flow { background:#fff; border:1px solid var(--beige); border-radius:10px;
    padding:16px 18px; font-size:13.5px; line-height:2.1; color:#4A4438; }
  .mn-flow .a { color:var(--gold); font-weight:800; }

  .mn-step { background:var(--card); border:1px solid var(--beige); border-radius:14px;
    padding:20px; margin-bottom:14px; }
  .mn-step.done { border-color:#BFDCC9; background:#F7FBF8; }
  .mn-step .hd { display:flex; align-items:center; gap:11px; margin-bottom:10px; }
  .mn-step .no { flex:none; width:26px; height:26px; border-radius:50%; background:var(--gold);
    color:#fff; font-size:13px; font-weight:800; display:flex; align-items:center;
    justify-content:center; }
  .mn-step.done .no { background:#2F7A55; }
  .mn-step h3 { margin:0; font-size:16px; font-weight:800; color:var(--ink); }
  .mn-step .why { margin:0 0 13px; font-size:13.5px; line-height:1.85; color:#6B6656;
    word-break:keep-all; }
  .mn-step .why b { color:var(--ink); }
  .mn-step .why code { background:#fff; border:1px solid var(--beige); border-radius:5px;
    padding:1px 6px; font-size:13px; }

  .mn-copy { display:flex; gap:8px; align-items:flex-start; }
  .mn-copy input, .mn-copy textarea { flex:1; min-width:0; padding:11px 13px;
    border:1px solid var(--beige); border-radius:10px; font-size:13px;
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace; background:#fff;
    color:var(--ink); outline:none; }
  .mn-copy textarea { min-height:150px; resize:vertical; line-height:1.7; }
  .mn-copy button { flex:none; padding:0 18px; height:42px; background:var(--navy); color:#fff;
    border:0; border-radius:10px; font-size:14px; font-weight:700; cursor:pointer;
    font-family:inherit; }
  .mn-copy button.ok { background:#2F7A55; }
  .mn-after { margin:11px 0 0; font-size:13px; line-height:1.8; color:#6B6656;
    word-break:keep-all; }
  .mn-after b { color:var(--ink); }

  .mn-card { background:var(--card); border:1px solid var(--beige); border-radius:14px;
    padding:20px; margin-bottom:14px; }
  .mn-card h3 { margin:0 0 6px; font-size:16px; font-weight:800; }
  .mn-card .why { margin:0 0 14px; font-size:13.5px; line-height:1.8; color:#6B6656;
    word-break:keep-all; }

  table.mn-tbl { width:100%; border-collapse:collapse; font-size:13.5px; }
  table.mn-tbl th, table.mn-tbl td { padding:9px 10px; border-bottom:1px solid var(--beige);
    text-align:left; color:#4A4438; }
  table.mn-tbl th { font-size:11.5px; letter-spacing:.05em; color:#9A9384; font-weight:700; }
  table.mn-tbl td.no { color:#B5AE9E; }
  .mn-wrap { overflow-x:auto; }
  .mn-empty { padding:20px; text-align:center; color:#9A9384; font-size:13.5px; line-height:1.8; }

  .mn-adv { margin-top:22px; }
  .mn-adv summary { cursor:pointer; font-size:13.5px; color:#9A9384; padding:6px 0; }
  .mn-adv .in { background:var(--card); border:1px solid var(--beige); border-radius:14px;
    padding:20px; margin-top:8px; }
  .mn-ghost { padding:9px 16px; background:#fff; border:1px solid #D9B4B4; color:#A05252;
    border-radius:9px; font-size:13.5px; font-weight:700; cursor:pointer; font-family:inherit; }
</style>

<% var 켜짐 = (link.total || 0) > 0; %>

<div class="mn-top <%= 켜짐 ? 'on' : 'off' %>">
  <% if (켜짐) { %>
    <p class="st">연결돼 있습니다</p>
    <p class="ds">지금까지 <b><%= link.total %>건</b>이 만세력에서 넘어왔습니다.
      새로 들어오면 <b>신청자 목록</b>의 「만세력」 갈래에 쌓이고 알림도 갑니다.
      더 하실 일은 없습니다.</p>
  <% } else { %>
    <p class="st">아직 연결 전입니다</p>
    <p class="ds">아직 만세력에서 넘어온 신청이 <b>한 건도 없습니다.</b>
      <br><b>만세력 프로그램이 어딘가에서 켜져 있어야</b> 이 설정이 의미가 있습니다.
      아직 안 올리셨다면 지금 여기서 하실 일은 없습니다. 그대로 두셔도 됩니다.</p>
  <% } %>
</div>

<details class="mn-what" <%= 켜짐 ? '' : 'open' %>>
  <summary>이게 뭔가요?</summary>
  <div class="in">
    <p><b>만세력은 루월당과 다른 프로그램입니다.</b> 압축파일로 따로 받으신 그것입니다.
      손님이 <b>무료로 사주를 보는 미끼 사이트</b>이고, 루월당은 그 손님을 상담·판매로
      이어받는 쪽입니다.</p>
    <p>이 화면은 그 둘 사이에 <b>배달길을 놓는 설정</b>입니다.
      만세력에서 손님이 번호를 남기면, 그 번호가 곧바로 루월당 신청자 목록으로 넘어옵니다.
      넘겨받을 때 <b>누구 링크로 들어온 손님인지</b>도 같이 붙어 오기 때문에
      수당 정산이 저절로 됩니다.</p>
    <div class="mn-flow">
      손님이 수강생 링크를 누른다<br>
      <span class="a">↓</span><br>
      만세력에서 무료로 사주를 본다 &nbsp;<span style="color:#9A9384">← 여기서 믿음이 생긴다</span><br>
      <span class="a">↓</span><br>
      「사주 제대로 배워보기」 를 누르고 이름·번호를 남긴다<br>
      <span class="a">↓</span><br>
      <b>루월당 신청자 목록에 그 수강생 앞으로 뜬다</b> &nbsp;<span style="color:#9A9384">← 이 부분이 연동</span>
    </div>
  </div>
</details>

<div class="mn-step">
  <div class="hd"><span class="no">1</span><h3>만세력을 인터넷에 올린다</h3></div>
  <p class="why">받으신 만세력 폴더는 지금 <b>내 컴퓨터에서만</b> 도는 상태입니다
    (<code>서버켜기.bat</code>). 그러면 컴퓨터를 끄는 동안 손님이 못 들어옵니다.
    <br><b>이게 먼저입니다.</b> 어디에 올릴지 정해지기 전까지는 아래 2·3번을 해도
    아무 일도 일어나지 않습니다. 정하시면 말씀해주세요, 이어서 도와드리겠습니다.</p>
</div>

<div class="mn-step">
  <div class="hd"><span class="no">2</span><h3>주소를 만세력에 알려준다</h3></div>
  <p class="why">만세력 폴더의 <b>설정.json</b> 을 메모장으로 열고,
    <code>"연동주소"</code> 라고 적힌 줄의 <b>따옴표 안</b>에 아래 주소를 붙여넣으세요.
    <br>이게 「번호를 여기로 보내라」는 뜻입니다.</p>
  <div class="mn-copy">
    <input type="text" id="mnUrl" readonly value="<%= hookUrl %>">
    <button type="button" data-copy="#mnUrl">복사</button>
  </div>
  <p class="mn-after">붙여넣은 뒤 <b>만세력 서버를 껐다 켜야</b> 반영됩니다.
    이 주소는 <b>남에게 보내지 마세요</b> — 뒤에 붙은 글자가 열쇠라서,
    아는 사람은 우리 신청자 목록에 아무 글이나 넣을 수 있습니다.</p>
</div>

<div class="mn-step">
  <div class="hd"><span class="no">3</span><h3>수강생 명단을 맞춰준다</h3></div>
  <p class="why">만세력 폴더의 <b>수강생.json</b> 을 열고, <b>안에 있는 걸 전부 지운 다음</b>
    아래 내용을 붙여넣으세요. 루월당에 등록된 교육생을 그대로 뽑아둔 것입니다.
    <br><b>절대 손으로 고쳐 적지 마세요.</b> 아이디가 한 글자만 달라도 그 링크로 들어온
    손님이 엉뚱한 사람에게 붙습니다. 교육생이 늘면 이 화면에서 다시 복사하시면 됩니다.</p>
  <% if (students.수강생.length) { %>
    <div class="mn-copy">
      <textarea id="mnStu" readonly><%= studentText %></textarea>
      <button type="button" data-copy="#mnStu">복사</button>
    </div>
    <p class="mn-after">지금 <b><%= students.수강생.length %>명</b>입니다.
      링크는 이렇게 만들어집니다 —
      <b>만세력주소/saju@<%= students.수강생[0].아이디 %></b>
      (<%= students.수강생[0].이름 %>님)</p>
  <% } else { %>
    <p class="mn-after">아직 링크를 줄 교육생이 없습니다.
      승인된 교육생에게 무료사주 주소가 있어야 여기 목록에 나옵니다.</p>
  <% } %>
</div>

<div class="mn-step">
  <div class="hd"><span class="no">4</span><h3>한 건 넣어서 확인한다</h3></div>
  <p class="why">만세력에서 <b>시험 삼아 이름·번호를 한 번 남겨보세요.</b>
    제대로 됐으면 아래 표에 바로 뜹니다. 안 뜨면 2번 주소를 다시 확인하시고,
    만세력 서버를 껐다 켜셨는지 보세요.</p>
</div>

<div class="mn-card">
  <h3>넘어온 신청</h3>
  <p class="why">잘 연결됐는지 보는 자리입니다. 실제 상담·발송은
    <b>신청자 목록</b>에서 하시면 됩니다.</p>
  <% if (recent.length) { %>
    <div class="mn-wrap">
      <table class="mn-tbl">
        <tr><th>때</th><th>이름</th><th>번호</th><th>데려온 사람</th><th>누구 앞으로</th></tr>
        <% recent.forEach(function(r){ %>
          <tr>
            <td><%= new Date(r.created_at).toLocaleString('ko-KR', { timeZone:'Asia/Seoul', month:'numeric', day:'numeric', hour:'numeric', minute:'2-digit' }) %></td>
            <td><a href="/leads/<%= r.id %>"><%= r.name %></a></td>
            <td><%= r.phone || '' %></td>
            <td<%= r.recruiter ? '' : ' class="no"' %>><%= r.recruiter || '기본 페이지' %></td>
            <td><%= r.teacher || '' %></td>
          </tr>
        <% }); %>
      </table>
    </div>
  <% } else { %>
    <div class="mn-empty">아직 넘어온 신청이 없습니다.<br>
      위 1~3번을 마치고 만세력에서 한 건 남겨보시면 여기에 뜹니다.</div>
  <% } %>
</div>

<details class="mn-adv">
  <summary>열쇠를 새로 만들어야 할 때</summary>
  <div class="in">
    <p class="why" style="margin-bottom:14px">2번 주소를 남에게 보냈거나 어딘가에 잘못 올렸다면
      열쇠를 새로 만드세요. <b>새로 만들면 지금 주소는 그 즉시 막힙니다.</b>
      만세력 <b>설정.json</b> 도 새 주소로 바꿔주셔야 합니다.
      그 전까지는 신청이 안 넘어옵니다.</p>
    <form method="post" action="/admin/manse/reset"
          onsubmit="return confirm('열쇠를 새로 만들까요?\n\n지금 쓰는 주소는 그 즉시 막힙니다.\n만세력 설정.json 도 새 주소로 바꿔주셔야 합니다.')">
      <button class="mn-ghost" type="submit">열쇠 새로 만들기</button>
    </form>
  </div>
</details>

<script>
(function(){
  document.querySelectorAll('[data-copy]').forEach(function(b){
    b.addEventListener('click', function(){
      var el = document.querySelector(b.dataset.copy);
      el.select();
      el.setSelectionRange(0, 99999);          /* 폰에서는 select() 만으로 안 잡힌다 */
      var done = function(){
        var t = b.textContent;
        b.textContent = '복사됨';
        b.classList.add('ok');
        setTimeout(function(){ b.textContent = t; b.classList.remove('ok'); }, 1500);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(el.value).then(done, function(){
          try { document.execCommand('copy'); done(); } catch(e){ alert('직접 복사해주세요.'); }
        });
      } else {
        try { document.execCommand('copy'); done(); } catch(e){ alert('직접 복사해주세요.'); }
      }
    });
  });
})();
</script>

<%- include('../partials/dash-bottom') %>
