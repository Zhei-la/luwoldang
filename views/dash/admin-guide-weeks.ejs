<%- include('../partials/dash-top', { user: user, active: active, title: '주차 · 과제 관리' }) %>

<style>
  .aw-note { background:var(--card); border:1px solid var(--beige); border-left:3px solid var(--gold);
    border-radius:0 12px 12px 0; padding:14px 17px; margin-bottom:18px;
    font-size:14px; line-height:1.8; color:#4A4438; word-break:keep-all; }
  .aw-note b { color:var(--ink); }
  .aw-note a { color:#8A6F3C; font-weight:700; }

  .aw { background:#fff; border:1px solid var(--beige); border-radius:14px;
    padding:20px 22px; margin-bottom:10px; }
  .aw .hd { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:14px; }
  .aw .no { width:34px; height:34px; border-radius:50%; background:#F1EDE4; color:#8A8574;
    font-size:14px; font-weight:800; display:flex; align-items:center; justify-content:center; }
  .aw .cnt { font-size:12px; color:#9A9384; }
  .aw label { display:block; font-size:11.5px; letter-spacing:.06em; color:#9A9384; margin:0 0 5px; }
  .aw input[type=text], .aw textarea {
    width:100%; padding:11px 13px; border:1px solid var(--beige); border-radius:10px;
    font-size:14.5px; font-family:inherit; background:#fff; color:var(--ink);
    outline:none; margin-bottom:10px; line-height:1.7; box-sizing:border-box; }
  .aw textarea { min-height:90px; resize:vertical; }
  .aw .two { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .aw .tsec { margin-top:6px; padding-top:14px; border-top:1px dashed var(--beige); }
  .aw .tsec .lb { font-size:12.5px; font-weight:800; color:#8A6F3C; margin-bottom:10px; }
  .aw .chk { display:flex; align-items:center; gap:7px; font-size:13.5px; color:#4A4438;
    margin-bottom:10px; font-weight:600; }
  .aw .save { padding:11px 20px; background:var(--navy); color:#fff; border:0; border-radius:10px;
    font-size:14px; font-weight:700; cursor:pointer; font-family:inherit; }
  @media (max-width:640px) { .aw .two { grid-template-columns:1fr; } }
</style>

<div class="aw-note">
  주차마다 <b>제목</b>과 <b>과제</b>를 정합니다.
  자료를 어느 주차에 넣을지는 <a href="/admin/guide">자료집 관리</a>에서 정하세요.<br>
  과제는 <b>앞 주차를 마쳐야 다음 과제가 열립니다.</b>
</div>

<% weeks.forEach(function (w) { %>
  <div class="aw" data-week="<%= w.week %>">
    <div class="hd">
      <div class="no"><%= w.week === 0 ? 'P' : (w.week === 5 ? '★' : w.week) %></div>
      <b><%= w.week === 0 ? '프롤로그' : (w.week === 5 ? '총정리' : w.week + '주차') %></b>
      <span class="cnt">강의 <%= w.posts %>개<% if (w.week >= 1 && w.week <= 4) { %> · 과제 마친 교육생 <%= w.doneN %>명<% } %></span>
    </div>

    <div class="two">
      <div>
        <label>제목</label>
        <input type="text" class="w-title" value="<%= w.title %>" placeholder="예: 1주차">
      </div>
      <div>
        <label>부제 (없어도 됩니다)</label>
        <input type="text" class="w-sub" value="<%= w.subtitle || '' %>" placeholder="예: 썸네일과 브랜드블로그">
      </div>
    </div>

    <% if (w.week >= 1 && w.week <= 4) { %>
      <div class="tsec">
        <div class="lb">과제</div>
        <label class="chk">
          <input type="checkbox" class="t-on" <%= (!w.task || w.task.published) ? 'checked' : '' %>>
          이 주차에 과제 보이기
        </label>
        <label>과제 제목</label>
        <input type="text" class="t-title" value="<%= w.task ? w.task.title : '' %>" placeholder="예: 첫 글 올려보기">
        <label>과제 내용</label>
        <textarea class="t-body" placeholder="무엇을 어떻게 하면 되는지 적어주세요."><%= w.task ? w.task.body : '' %></textarea>
      </div>
    <% } %>

    <button type="button" class="save">저장</button>
  </div>
<% }); %>

<script>
document.addEventListener('click', function (e) {
  var b = e.target.closest('.aw .save');
  if (!b) return;
  var box = b.closest('.aw');
  var v = function (c) { var el = box.querySelector(c); return el ? el.value : ''; };
  var on = box.querySelector('.t-on');
  b.disabled = true; b.textContent = '저장 중...';
  fetch('/admin/guide/weeks/save', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      week: Number(box.dataset.week),
      title: v('.w-title'), subtitle: v('.w-sub'),
      taskTitle: v('.t-title'), taskBody: v('.t-body'),
      taskOn: on ? on.checked : true,
    })
  })
  .then(function (r) { return r.json(); })
  .then(function (d) {
    if (!d.ok) throw new Error(d.error || '실패');
    b.textContent = '저장했어요 ✓';
    setTimeout(function () { b.disabled = false; b.textContent = '저장'; }, 1500);
  })
  .catch(function (err) {
    alert('저장하지 못했습니다: ' + err.message);
    b.disabled = false; b.textContent = '저장';
  });
});
</script>

<%- include('../partials/dash-bottom') %>
