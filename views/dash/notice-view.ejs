<%- include('../partials/dash-top', { user: user, active: active, title: '공지사항' }) %>

<style>
  .nv-bar { position:sticky; top:57px; z-index:25; display:flex; align-items:center; gap:8px;
    margin:-28px -28px 18px; padding:10px 28px;
    background:rgba(251,247,240,.96); backdrop-filter:blur(6px); border-bottom:1px solid var(--beige); }
  .nv-bar a { padding:9px 16px; border:1px solid var(--beige); background:var(--card); border-radius:9px;
    font-size:13.5px; font-weight:700; color:#4A4438; text-decoration:none; white-space:nowrap; }
  .nv-bar .edit { background:var(--navy); border-color:var(--navy); color:#fff; }
  @media (max-width:760px) { .nv-bar { top:53px; margin:-18px -16px 14px; padding:9px 16px; } }

  .nv-head { border-bottom:1px solid var(--beige); padding-bottom:16px; margin-bottom:22px; }
  .nv-head h1 { font-family:"Nanum Myeongjo", serif; font-size:25px; line-height:1.4;
    margin:0 0 10px; word-break:keep-all; }
  .nv-meta { font-size:12px; color:#9A9384; display:flex; gap:10px; align-items:center; }
  .nv-tag { background:#F4EFE3; color:#8A6F3C; padding:3px 9px; border-radius:5px; font-weight:600; }

  /* 본문은 흰 종이처럼 — 베이지 배경 위에서는 캡처와 글이 잘 안 보인다 */
  .nv-body {
    max-width:860px; font-size:16px; line-height:1.85; color:var(--ink); word-break:keep-all;
    background:#fff; border:1px solid var(--beige); border-radius:16px;   /* 본문은 늘 흰 종이 */
    padding:34px 38px; box-shadow:0 2px 10px rgba(24,34,52,.04);
  }
  @media (max-width:760px) {
    .nv-body { padding:22px 18px; border-radius:12px; }
  }
  .nv-body h2 { font-family:"Nanum Myeongjo",serif; font-size:21px; margin:32px 0 12px;
    padding-bottom:8px; border-bottom:1px solid var(--beige); }
  .nv-body h3 { font-size:17.5px; margin:24px 0 10px; color:#8A6F3C; }
  .nv-body p { margin:0 0 15px; }
  .nv-body ul, .nv-body ol { margin:0 0 15px; padding-left:22px; }
  .nv-body li { margin-bottom:6px; }
  .nv-body blockquote { margin:0 0 16px; padding:13px 16px; background:#FBF8F1;
    border-left:3px solid var(--gold); border-radius:0 8px 8px 0; }
  .nv-body pre { background:#F4EFE3; border:1px solid var(--beige); border-radius:10px;
    padding:14px 16px; margin:0 0 16px; white-space:pre-wrap; font-family:inherit; font-size:14.5px; }
  .nv-body hr { border:0; border-top:1px solid var(--beige); margin:28px 0; }
  .nv-body a { color:#3B6EA5; }
  .nv-body figure { margin:0 0 16px; }
  .nv-body img { max-width:min(560px, 100%); height:auto; display:block;
    border-radius:10px; border:1px solid var(--beige); }
  .nv-body table { width:100%; border-collapse:collapse; margin:0 0 16px; font-size:14.5px; }
  .nv-body th, .nv-body td { border:1px solid var(--beige); padding:9px 12px; text-align:left; }
  .nv-body th { background:#F4EFE3; font-weight:700; }
  /* 복사상자 — 글 전체 복사는 막혀 있으므로 여기만 버튼으로 복사하게 한다 */
    .nv-body .cbx { position:relative; }
    .nv-body .cbx pre { margin:0; padding-top:40px; }
    .nv-body .cbx-btn {
    position:absolute; top:8px; right:8px; z-index:2;
    padding:6px 13px; border:1px solid var(--beige); background:var(--card);
    border-radius:8px; font-size:12.5px; font-weight:700; color:#6B6656;
    cursor:pointer; font-family:inherit;
    -webkit-user-select:none; user-select:none;
  }
    .nv-body .cbx-btn:hover { border-color:var(--gold); color:#8A6F3C; }
    .nv-body .cbx-btn.done { background:var(--gold); border-color:var(--gold); color:#fff; }
</style>

<div class="nv-bar">
  <a href="/notice">← 공지 목록</a>
  <% if (user.role === 'admin') { %>
    <a href="/admin/notice/edit/<%= post.id %>" class="edit">수정하기</a>
    <a href="/admin/notice">관리</a>
  <% } %>
</div>

<div class="nv-head">
  <h1><%= post.title %></h1>
  <div class="nv-meta">
    <% if (post.cat_name) { %><span class="nv-tag"><%= post.cat_name %></span><% } %>
    <span><%= new Date(post.created_at).toLocaleDateString('ko-KR') %></span>
    <span><%= post.views %>번 읽음</span>
    <% if (!post.published) { %><span style="color:#A8332B;font-weight:700">비공개</span><% } %>
  </div>
</div>

<div class="nv-body"><%- bodyHtml %></div>

<script>
(function () {
  /* 복사상자에 복사 버튼을 붙인다.
     글 전체는 복사를 막아두었지만, 이 상자는 교육생이 그대로 쓰라고 만든 것이다. */
  var box = document.querySelector('.nv-body');
  if (!box) return;

  [].forEach.call(box.querySelectorAll('pre'), function (pre) {
    if (pre.parentNode.classList.contains('cbx')) return;

    var wrap = document.createElement('div');
    wrap.className = 'cbx';
    pre.parentNode.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'cbx-btn';
    btn.textContent = '복사';
    wrap.appendChild(btn);

    btn.addEventListener('click', async function (e) {
      e.stopPropagation();
      var txt = pre.innerText || pre.textContent || '';
      var ok = false;

      if (navigator.clipboard && window.isSecureContext) {
        try { await navigator.clipboard.writeText(txt); ok = true; } catch (err) {}
      }
      if (!ok) {
        /* 옛 브라우저·아이폰 대비 — 글 영역 밖에 임시 칸을 만들어 복사한다 */
        try {
          var ta = document.createElement('textarea');
          ta.value = txt;
          ta.setAttribute('readonly', '');
          ta.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0';
          document.body.appendChild(ta);
          ta.contentEditable = 'true'; ta.readOnly = false;
          var r = document.createRange(); r.selectNodeContents(ta);
          var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
          ta.setSelectionRange(0, txt.length); ta.focus();
          ok = document.execCommand('copy');
          ta.remove();
          window.getSelection().removeAllRanges();
        } catch (err) {}
      }

      btn.textContent = ok ? '복사했어요 ✓' : '복사 실패';
      btn.classList.toggle('done', ok);
      setTimeout(function () {
        btn.textContent = '복사'; btn.classList.remove('done');
      }, 1600);
    });
  });
})();
</script>

<%- include('../partials/dash-bottom') %>
