    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
      <div style="font-size:14px;font-weight:700">대댓글 규칙 <span style="color:var(--acc)">${replyRules.length}</span></div>
      <button onclick="openReplyRuleSheet(null)" style="background:var(--navy);color:#fff;border:none;border-radius:8px;padding:8px 14px;font-size:13px;font-weight:700;cursor:pointer">+ 규칙 추가</button>
    </div>
    ${replyRules.length === 0
      ? '<p class="empty" style="padding:32px 0"><strong>💬</strong>규칙이 없어<br>위 버튼으로 추가해봐</p>'
      : replyRules.map(r => `
        <div class="auto-card">
          <div class="ac-head">
            <div>
              <div class="ac-title">${esc(r.name)}</div>
              <div style="font-size:11px;color:var(--txt3);margin-top:3px">
                ${r.triggerType==='all' ? '모든 댓글에 반응' : '키워드 포함 시: ' + esc((r.keywords||[]).join(', '))}
              </div>
              ${r.dmLure ? '<div style="font-size:11px;color:var(--blue);margin-top:2px">💌 DM 유도 문구 포함</div>' : ''}
              ${r.delayMin ? `<div style="font-size:11px;color:var(--txt3);margin-top:2px">⏱ ${r.delayMin}분 후 발송</div>` : ''}
            </div>
            <button class="toggle-btn ${r.enabled?'on':'off'}" onclick="toggleReply('${r.id}')"></button>
          </div>
          <div style="font-size:11px;color:var(--txt3);margin-bottom:6px">대댓글 ${(r.replyTexts||[]).length}개 · ${r.replyMode==='random'?'랜덤':'순서대로'}</div>
          <div style="display:flex;flex-direction:column;gap:4px">
            ${(r.replyTexts||[]).slice(0,2).map(t => `<div style="background:var(--sur2);border-radius:8px;padding:6px 10px;font-size:12px;color:var(--txt2)">${esc(t.slice(0,40))}${t.length>40?'…':''}</div>`).join('')}
            ${(r.replyTexts||[]).length > 2 ? `<div style="font-size:11px;color:var(--txt3)">+${(r.replyTexts||[]).length-2}개 더</div>` : ''}
          </div>
          <div style="display:flex;gap:6px;margin-top:10px">
            <button onclick="openReplyRuleSheet('${r.id}')" style="flex:1;padding:8px;background:var(--sur2);border:1px solid var(--bdr);border-radius:8px;color:var(--txt2);font-size:12px;font-weight:600;cursor:pointer;font-family:inherit">수정</button>
            <button onclick="deleteReply('${r.id}')" style="padding:8px 14px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);border-radius:8px;color:var(--red);font-size:12px;font-weight:600;cursor:pointer;font-family:inherit">삭제</button>
          </div>
        </div>`).join('')}`;
}

function toggleReply(id) {
  const r = replyRules.find(x => x.id === id);
  if (r) { r.enabled = !r.enabled; saveReply(); renderReplyPage(); }
}
function deleteReply(id) {
  if (!confirm('이 규칙을 삭제할까?')) return;
  replyRules = replyRules.filter(x => x.id !== id);
  saveReply(); renderReplyPage(); toast('삭제됐어');
}

function openReplyRuleSheet(editId) {
  const r = editId ? replyRules.find(x => x.id === editId) : null;
  let replyTexts = r ? [...(r.replyTexts||[])] : [''];

  const buildList = () =>
    replyTexts.map((t, i) => `
      <div style="display:flex;gap:6px;margin-bottom:6px;align-items:center">
        <input type="text" id="rt_${i}" value="${esc(t)}" placeholder="대댓글 내용" style="flex:1;background:var(--sur2);border:1px solid var(--bdr);border-radius:8px;padding:8px 10px;font-size:13px;font-family:inherit;color:var(--txt);outline:none">
        <button onclick="rrDel(${i})" style="background:none;border:none;color:var(--red);font-size:20px;cursor:pointer;padding:0 4px">×</button>
      </div>`).join('') +
    `<button onclick="rrAdd()" style="width:100%;padding:9px;background:var(--sur2);border:1px dashed var(--bdr);border-radius:8px;color:var(--txt3);font-size:12px;cursor:pointer;font-family:inherit;margin-top:4px">+ 대댓글 추가</button>`;

  window.rrAdd = () => { replyTexts.push(''); $('replyTextList').innerHTML = buildList(); };
  window.rrDel = (i) => { replyTexts.splice(i,1); if(!replyTexts.length) replyTexts=[''];  $('replyTextList').innerHTML = buildList(); };

  openSheet(`<h3>${r ? '규칙 수정' : '대댓글 규칙 추가'}</h3>

    <label>규칙 이름</label>
    <input type="text" id="rlName" value="${r ? esc(r.name) : ''}" placeholder="예: 문의 자동응답, DM 유도">

    <label>반응 조건</label>
    <div style="display:flex;gap:8px;margin-top:6px">
      <button class="time-slot ${!r||r.triggerType==='all'?'on':''}" id="trigAll" onclick="this.classList.add('on');document.getElementById('trigKw').classList.remove('on');document.getElementById('kwWrap').style.display='none'">모든 댓글</button>
      <button class="time-slot ${r&&r.triggerType==='keyword'?'on':''}" id="trigKw" onclick="this.classList.add('on');document.getElementById('trigAll').classList.remove('on');document.getElementById('kwWrap').style.display=''">키워드 포함 시</button>
    </div>
    <div id="kwWrap" style="margin-top:8px;display:${r&&r.triggerType==='keyword'?'':'none'}">
      <input type="text" id="rlKeywords" value="${r?esc((r.keywords||[]).join(', ')):''}  " placeholder="예: 구매, 문의, 가격 (쉼표로 구분)">
      <div class="note" style="margin-top:4px">이 단어 중 하나라도 포함된 댓글에만 반응해</div>
    </div>

    <label>대댓글 내용 (여러 개 등록 가능)</label>
    <div id="replyTextList">${buildList()}</div>

    <label>발송 모드</label>
    <div style="display:flex;gap:8px;margin-top:6px">
      <button class="time-slot ${!r||r.replyMode==='random'?'on':''}" id="rmRand" onclick="this.classList.add('on');document.getElementById('rmSeq').classList.remove('on')">🎲 랜덤</button>
      <button class="time-slot ${r&&r.replyMode==='seq'?'on':''}" id="rmSeq" onclick="this.classList.add('on');document.getElementById('rmRand').classList.remove('on')">📋 순서대로</button>
    </div>

    <label>발송 딜레이</label>
    <div style="display:flex;align-items:center;gap:8px;margin-top:6px">
      <input type="number" id="rlDelay" value="${r?(r.delayMin||0):1}" min="0" max="60" style="width:80px;background:var(--sur2);border:1px solid var(--bdr);border-radius:8px;padding:8px 10px;font-size:14px;font-family:inherit;color:var(--txt);outline:none;text-align:center">
      <span style="font-size:13px;color:var(--txt2)">분 후 발송 (0 = 즉시)</span>
    </div>

    <label style="margin-top:14px">💌 DM 유도</label>
    <div style="background:var(--sur2);border-radius:10px;padding:12px;margin-top:6px">
      <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin:0">
        <input type="checkbox" id="dmChk" ${r&&r.dmLure?'checked':''} style="width:16px;height:16px;accent-color:var(--acc)">
        <span style="font-size:13px;font-weight:600">대댓글 끝에 DM 유도 문구 자동 추가</span>
      </label>
      <div id="dmTextWrap" style="margin-top:10px;display:${r&&r.dmLure?'':'none'}">
        <input type="text" id="dmText" value="${r?esc(r.dmLureText||'궁금하신 분은 DM 주세요'):'궁금하신 분은 DM 주세요'}" placeholder="DM 유도 문구">
        <div class="note" style="margin-top:4px">대댓글 맨 끝에 이 문구가 자동으로 붙어</div>
      </div>
    </div>

    <div class="acts">
      ${r ? '<button class="red" data-x="del">삭제</button>' : ''}
      <button class="gray" data-x="close">취소</button>
      <button class="ok" data-x="save">저장</button>
    </div>`,
    () => {
      $('dmChk').addEventListener('change', e => {
        $('dmTextWrap').style.display = e.target.checked ? '' : 'none';
      });
      $('rlName').focus();
    },
    x => {
      if (x === 'del') {
        if (!confirm('삭제할까?')) return true;
        replyRules = replyRules.filter(z => z.id !== editId);
        saveReply(); closeSheet(); renderReplyPage(); return true;
      }
      if (x !== 'save') return false;
      const texts = [];
      document.querySelectorAll('[id^="rt_"]').forEach(inp => { if (inp.value.trim()) texts.push(inp.value.trim()); });
      if (!texts.length) { toast('대댓글을 최소 1개 입력해줘'); return true; }
      const trigType = $('trigKw').classList.contains('on') ? 'keyword' : 'all';
      const keywords = trigType === 'keyword' ? ($('rlKeywords').value||'').split(',').map(s=>s.trim()).filter(Boolean) : [];
      const replyMode = $('rmSeq').classList.contains('on') ? 'seq' : 'random';
      const dmLure = $('dmChk').checked;
      const dmLureText = $('dmText')?.value?.trim() || '';
      const delayMin = parseInt($('rlDelay').value)||0;
      const name = $('rlName').value.trim() || '규칙';
      const data = { name, triggerType: trigType, keywords, replyTexts: texts, replyMode, dmLure, dmLureText, delayMin, enabled: true };
      if (r) { Object.assign(r, data); }
      else { replyRules.push({ id: uid(), ...data, lastIdx: 0, createdAt: Date.now() }); }
      saveReply(); closeSheet(); renderReplyPage(); toast('저장됐어'); return true;
    });
}

