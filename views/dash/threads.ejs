<%- include('../partials/dash-top', { user: user, active: active, title: '스레드 자동화' }) %>

<style>
/* ══════════════════════════════════════════════════════════
 * 스레드 도구 — 원본 도구의 구조와 기능은 그대로 두고
 * 색만 루월당(한지·먹·금박)으로 바꿨다.
 *
 * ⚠️ 모든 규칙을 #th-app 안에 가뒀다.
 *    원본에 * { margin:0 } 과 body { } 같은 전역 규칙이 있어서
 *    그대로 두면 대시보드 전체가 깨진다.
 * ══════════════════════════════════════════════════════════ */
/* ── 루월당 다크 테마 ── */
#th-app {
  /* 루월당 한지 톤 — 대시보드(dashboard.css)의 색을 그대로 따른다 */
  --bg:   #F7F3EA;
  --bg2:  #FFFDF8;
  --sur:  #FFFFFF;
  --sur2: #F4EFE3;
  --bdr:  #DDD2BC;
  --acc:  #8A6F3C;       /* 금박 — 흰 글자를 얹어도 읽히도록 진하게 */
  --acc2: #6B5530;
  --accL: #B59A62;       /* 옅은 금박 — 테두리·강조선용 */
  --red:  #96271F;
  --green:#3D7264;
  --blue: #2F5C8F;
  --txt:  #1F1F1C;
  --txt2: #4A4438;       /* 본문 보조 — 원래 너무 연했다 */
  --txt3: #6E6858;       /* 설명·라벨 — 원래 너무 연했다 */
  --navy: #182234;       /* 사이드바와 같은 남색 — 주요 버튼에 쓴다 */
  --onacc:#FFFFFF;       /* 금박 위에 얹는 글자색 (원본은 어두운 색이었다) */
  --r: 12px;
}
#th-app * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0; padding: 0; }
#th-app, #th-app { background: var(--bg); color: var(--txt); font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Pretendard", "Noto Sans KR", sans-serif; font-size: 15px; line-height: 1.6; }
#th-app { padding-bottom: calc(80px + env(safe-area-inset-bottom)); }
/* ── 레이아웃 ── */
#th-app .wrap { max-width: 680px; margin: 0 auto; padding: 0 16px; padding-top: env(safe-area-inset-top); }
/* ── 헤더 ── */
#th-app .hd { display: flex; align-items: center; justify-content: space-between; padding: 20px 0 12px; border-bottom: 1px solid var(--bdr); margin-bottom: 16px; }
#th-app .hd-title { font-size: 17px; font-weight: 800; letter-spacing: -.02em; }
#th-app .hd-title span { color: var(--acc); }
#th-app .hd-sub { font-size: 12px; color: var(--txt3); }
/* ── 스크롤 탭 ── */
#th-app .tabs { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; margin-bottom: 14px; }
#th-app .tabs::-webkit-scrollbar { display: none; }
#th-app .tab { flex: 0 0 auto; padding: 7px 14px; border-radius: 100px; border: 1px solid var(--bdr); background: var(--sur); color: var(--txt2); font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; white-space: nowrap; display: flex; align-items: center; gap: 5px; transition: all .15s; }
#th-app .tab .n { font-size: 10px; opacity: .6; }
#th-app .tab.on { background: var(--acc); color: var(--onacc); border-color: var(--acc); }
#th-app .tab.plus { color: var(--txt3); }
/* ── 검색 ── */
#th-app .search { display: flex; gap: 8px; margin-bottom: 10px; }
#th-app .search input { flex: 1; background: var(--sur); border: 1px solid var(--bdr); border-radius: 10px; padding: 10px 13px; font-size: 15px; font-family: inherit; color: var(--txt); outline: none; transition: border-color .15s; }
#th-app .search input::placeholder { color: var(--txt3); }
#th-app .search input:focus { border-color: var(--acc); }
#th-app .search-btn { padding: 10px 16px; background: var(--sur2); border: 1px solid var(--bdr); border-radius: 10px; color: var(--txt2); font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; white-space: nowrap; }
/* ── 도구 바 ── */
#th-app .toolbar { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; font-size: 12px; color: var(--txt3); }
#th-app .toolbar button { background: none; border: none; color: var(--txt3); font: inherit; font-size: 12px; cursor: pointer; padding: 0; }
#th-app .toolbar button.on { color: var(--acc); font-weight: 700; }
#th-app .toolbar .sp { flex: 1; }
#th-app .toolbar .edit-btn { color: var(--txt3); font-size: 12px; }
/* ── 글 목록 ── */
#th-app .sec-label { font-size: 11px; letter-spacing: .14em; color: var(--txt3); padding: 6px 0; border-bottom: 1px solid var(--bdr); margin-bottom: 10px; }
#th-app .post { background: var(--sur); border: 1px solid var(--bdr); border-radius: var(--r); padding: 13px; margin-bottom: 8px; display: flex; gap: 10px; align-items: flex-start; cursor: pointer; transition: border-color .15s; position: relative; overflow: hidden; }
#th-app .post::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--acc); opacity: 0; transition: opacity .15s; }
#th-app .post:hover { border-color: rgba(201,169,110,.25); }
#th-app .post:hover::before { opacity: 1; }
#th-app .post .body { flex: 1; min-width: 0; }
#th-app .post .t { font-size: 14px; font-weight: 700; display: flex; align-items: center; gap: 5px; margin-bottom: 4px; }
#th-app .post .t .star { color: var(--acc); font-size: 12px; }
#th-app .post .pv { font-size: 12.5px; color: var(--txt2); white-space: pre-wrap; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.5; word-break: break-all; }
#th-app .post .meta { margin-top: 7px; font-size: 11px; color: var(--txt3); display: flex; gap: 8px; flex-wrap: wrap; }
#th-app .post .side { display: flex; flex-direction: column; gap: 5px; flex-shrink: 0; }
#th-app .post .copy-btn { background: var(--acc); color: var(--onacc); border: none; border-radius: 8px; padding: 7px 12px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; }
#th-app .post .fav-btn { background: none; border: none; color: var(--txt3); font-size: 15px; cursor: pointer; padding: 2px 4px; }
#th-app .post .fav-btn.on { color: var(--acc); }
/* ── 빈 상태 ── */
#th-app .empty { text-align: center; padding: 48px 0; color: var(--txt3); font-size: 13px; line-height: 2; }
#th-app .empty strong { display: block; font-size: 24px; margin-bottom: 8px; }
/* ── FAB ── */
#th-app .fab { position: fixed; left: 0; right: 0; bottom: 0; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: linear-gradient(to top, var(--bg) 60%, transparent); z-index: 20; }
#th-app .fab button { display: block; width: 100%; max-width: 648px; margin: 0 auto; background: var(--acc); color: var(--onacc); border: none; border-radius: 12px; padding: 14px; font-size: 15px; font-weight: 800; cursor: pointer; font-family: inherit; }
/* ── 오버레이 시트 ── */
#th-app .ov { position: fixed; inset: 0; background: rgba(37,37,34,.45); display: flex; align-items: flex-end; justify-content: center; z-index: 60; animation: fade .15s ease; }
@keyframes fade { from { opacity: 0 } to { opacity: 1 } }
#th-app .sheet { background: var(--sur); width: 100%; max-width: 680px; border-radius: 20px 20px 0 0; padding: 20px 16px calc(20px + env(safe-area-inset-bottom)); max-height: 90vh; overflow-y: auto; animation: up .2s ease; }
@keyframes up { from { transform: translateY(20px) } to { transform: none } }
#th-app .sheet-bar { width: 36px; height: 4px; background: var(--bdr); border-radius: 2px; margin: 0 auto 18px; }
#th-app .sheet h3 { font-size: 17px; font-weight: 800; margin-bottom: 14px; }
#th-app .sheet label { display: block; font-size: 11px; letter-spacing: .12em; color: var(--txt3); margin: 14px 0 5px; }
#th-app .sheet input[type=text], #th-app .sheet textarea { width: 100%; background: var(--sur2); border: 1px solid var(--bdr); border-radius: 10px; padding: 11px 13px; font-size: 15px; font-family: inherit; color: var(--txt); outline: none; line-height: 1.6; transition: border-color .15s; }
#th-app .sheet input:focus, #th-app .sheet textarea:focus { border-color: var(--acc); }
#th-app .sheet textarea { resize: vertical; min-height: 200px; white-space: pre-wrap; }
#th-app .sheet .note { font-size: 12px; color: var(--txt3); line-height: 1.7; margin-top: 8px; word-break: keep-all; }
#th-app .sheet .full { background: var(--sur2); border: 1px solid var(--bdr); border-radius: 10px; padding: 13px; font-size: 14px; line-height: 1.7; white-space: pre-wrap; word-break: break-all; max-height: 40vh; overflow-y: auto; color: var(--txt); }
#th-app .sheet .char-count { font-size: 12px; color: var(--txt3); text-align: right; margin-top: 5px; }
#th-app .sheet .char-count.over { color: var(--red); font-weight: 700; }
/* ── 액션 버튼 ── */
#th-app .acts { display: flex; gap: 8px; margin-top: 16px; }
#th-app .acts button { flex: 1; border: none; border-radius: 11px; padding: 13px; font-size: 14px; font-weight: 700; cursor: pointer; font-family: inherit; }
#th-app .acts .ok { background: var(--acc); color: var(--onacc); flex: 1.8; }
#th-app .acts .gray { background: var(--sur2); color: var(--txt2); }
#th-app .acts .red { background: rgba(239,68,68,.12); color: var(--red); }
#th-app .acts .blue { background: rgba(96,165,250,.12); color: var(--blue); }
/* ── 예약 발행 시트 ── */
#th-app .pub-accounts { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
#th-app .pub-acc { padding: 7px 14px; border-radius: 100px; border: 1px solid var(--bdr); background: var(--sur2); color: var(--txt2); font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; transition: all .15s; }
#th-app .pub-acc.on { border-color: var(--acc); color: var(--acc); background: rgba(201,169,110,.1); }
#th-app .time-slots { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
#th-app .time-slot { padding: 7px 14px; border-radius: 100px; border: 1px solid var(--bdr); background: var(--sur2); color: var(--txt2); font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; transition: all .15s; }
#th-app .time-slot.on { border-color: var(--blue); color: var(--blue); background: rgba(96,165,250,.1); }
#th-app .custom-time { margin-top: 10px; display: none; }
#th-app .custom-time input { width: 100%; }
#th-app .preview-box { background: var(--bg); border: 1px solid var(--bdr); border-radius: 10px; padding: 13px; font-size: 14px; line-height: 1.7; white-space: pre-wrap; word-break: break-all; color: var(--txt); margin-top: 8px; max-height: 200px; overflow-y: auto; }
#th-app .preview-count { font-size: 12px; text-align: right; margin-top: 5px; }
/* ── 예약 목록 배지 ── */
#th-app .badge { display: inline-flex; align-items: center; gap: 3px; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 100px; }
#th-app .badge.blue { background: rgba(96,165,250,.15); color: var(--blue); }
#th-app .badge.green { background: rgba(34,197,94,.15); color: var(--green); }
#th-app .badge.red { background: rgba(239,68,68,.15); color: var(--red); }
/* ── 토스트 ── */
#th-app .toast { position: fixed; left: 50%; bottom: 90px; transform: translateX(-50%); background: var(--sur); border: 1px solid var(--bdr); color: var(--txt); padding: 10px 18px; border-radius: 100px; font-size: 13px; font-weight: 600; z-index: 90; animation: pop .2s ease; white-space: nowrap; }
@keyframes pop { from { opacity: 0; transform: translate(-50%, 8px) } to { opacity: 1; transform: translate(-50%, 0) } }
/* ── 구분선 탭 (글목록/예약/기록) ── */
#th-app .main-tabs { display: flex; border-bottom: 1px solid var(--bdr); margin-bottom: 16px; gap: 0; }
#th-app .main-tab { flex: 1; padding: 12px; text-align: center; font-size: 13px; font-weight: 600; color: var(--txt3); cursor: pointer; border-bottom: 2px solid transparent; transition: all .15s; }
#th-app .main-tab.on { color: var(--acc); border-bottom-color: var(--acc); }
/* ── 자동 스케줄러 ── */
#th-app .auto-card { background: var(--sur); border: 1px solid var(--bdr); border-radius: var(--r); padding: 16px; margin-bottom: 12px; }
#th-app .auto-card .ac-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
#th-app .auto-card .ac-title { font-size: 14px; font-weight: 700; }
#th-app .auto-card .ac-time { font-size: 12px; color: var(--acc); font-weight: 700; }
#th-app .auto-card .ac-posts { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 10px; }
#th-app .ac-post-chip { background: var(--sur2); border: 1px solid var(--bdr); border-radius: 8px; padding: 5px 10px; font-size: 12px; color: var(--txt2); display: flex; align-items: center; gap: 5px; }
#th-app .ac-post-chip .x { color: var(--txt3); cursor: pointer; font-size: 14px; line-height: 1; }
#th-app .ac-post-chip.active { border-color: var(--acc); color: var(--acc); background: rgba(201,169,110,.08); }
#th-app .toggle-btn { width: 44px; height: 24px; border-radius: 100px; border: none; cursor: pointer; position: relative; transition: background .2s; flex-shrink: 0; }
#th-app .toggle-btn.on { background: var(--green); }
#th-app .toggle-btn.off { background: var(--sur2); }
#th-app .toggle-btn::after { content: ''; position: absolute; top: 2px; width: 20px; height: 20px; border-radius: 50%; background:var(--card); transition: left .2s; }
#th-app .toggle-btn.on::after { left: 22px; }
#th-app .toggle-btn.off::after { left: 2px; }
#th-app .add-time-btn { width: 100%; padding: 12px; background: var(--sur2); border: 1px dashed var(--bdr); border-radius: var(--r); color: var(--txt3); font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; margin-top: 8px; }
#th-app .add-time-btn:hover { border-color: var(--acc); color: var(--acc); }
/* ── 토큰 가이드 ── */
#th-app .guide-step { background: var(--sur); border: 1px solid var(--bdr); border-radius: var(--r); padding: 16px; margin-bottom: 10px; display: flex; gap: 14px; }
#th-app .guide-num { width: 28px; height: 28px; border-radius: 50%; background: var(--acc); color: var(--onacc); font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
#th-app .guide-body h4 { font-size: 14px; font-weight: 700; margin-bottom: 6px; }
#th-app .guide-body p { font-size: 13px; color: var(--txt2); line-height: 1.7; word-break: keep-all; }
#th-app .guide-body .tip { background: var(--sur2); border-left: 3px solid var(--acc); padding: 8px 12px; border-radius: 0 8px 8px 0; font-size: 12px; color: var(--txt2); line-height: 1.7; margin-top: 8px; }
#th-app .guide-body .warn { background: rgba(239,68,68,.08); border-left: 3px solid var(--red); padding: 8px 12px; border-radius: 0 8px 8px 0; font-size: 12px; color: #fca5a5; line-height: 1.7; margin-top: 8px; }
#th-app .guide-link { display: inline-flex; align-items: center; gap: 5px; color: var(--blue); font-size: 12px; font-weight: 600; text-decoration: none; margin-top: 6px; }
#th-app .sec-title { font-size: 13px; font-weight: 800; color: var(--acc); letter-spacing: .08em; margin: 20px 0 12px; }
#th-app .info-box { background: rgba(201,169,110,.06); border: 1px solid rgba(201,169,110,.2); border-radius: var(--r); padding: 14px; margin-bottom: 16px; font-size: 13px; color: var(--txt2); line-height: 1.8; }
@media (prefers-reduced-motion: reduce) {
#th-app * { animation: none !important; }
}

/* ── 대시보드 안에 넣으면서 필요한 보정 ── */
#th-app{ padding-bottom: 20px; }                 /* 원본은 body 하단 여백이었다 */
#th-app .wrap{ max-width: 760px; padding: 0; }
/* 새 글 버튼 — 원본은 화면 하단 고정이었는데, 대시보드에선 아래 메뉴와 겹친다 */
#th-app .fab{ position: sticky; bottom: 0; left: auto; right: auto;
  padding: 14px 0 6px; background: linear-gradient(to top, var(--bg) 72%, rgba(247,243,234,0)); }
#th-app .fab button{ width: 100%; max-width: 760px; margin: 0 auto; }
/* ── 글자가 연해 보이던 것 보정 ──
   한지 배경은 밝아서 금박 위에 흰 글자를 얹으면 잘 안 읽힌다.
   눌린 탭과 주요 버튼은 사이드바와 같은 남색으로 바꿨다. */
#th-app .fab button{ background: var(--navy); color:#fff; }
#th-app .tab.on{ background: var(--navy); border-color: var(--navy); color:#fff; }
#th-app .main-tab{ color: var(--txt2); }
#th-app .main-tab.on{ color: var(--acc2); border-bottom-color: var(--acc); font-weight:800; }
#th-app .hd-sub{ color: var(--txt2); }
#th-app .toolbar, #th-app .toolbar button{ color: var(--txt2); }
#th-app .toolbar button.on{ color: var(--acc2); }
#th-app .sec-label, #th-app .sheet label{ color: var(--txt2); }
#th-app .post .pv{ color: var(--txt2); }
#th-app .post .meta{ color: var(--txt3); }
#th-app .empty{ color: var(--txt2); }
#th-app .search input::placeholder{ color: var(--txt3); }
#th-app .search-btn{ color: var(--txt2); border-color: var(--accL); }
/* 옅은 금박은 테두리에만 남긴다 */
#th-app .tab{ border-color: var(--bdr); }
#th-app .post:hover{ border-color: var(--accL); }

/* 시트·토스트는 #th-app 안에 붙지만 화면 전체를 덮어야 한다.
   부모에 transform 같은 게 걸리면 fixed 가 어긋나므로 z-index 를 넉넉히 준다. */
#th-app .ov{ position: fixed; inset: 0; z-index: 9000; display:flex; align-items:flex-end; justify-content:center; }
#th-app .sheet{ margin: 0 auto; }
#th-app .toast{ position: fixed; z-index: 9100; }

</style>

<div id="th-app">


<div class="wrap">
  <!-- 제목은 대시보드 상단바가 대신하므로 안내 문구와 백업 버튼만 둔다 -->
  <div class="hd">
    <div class="hd-sub">글을 적어두고 예약 발행까지 한 곳에서</div>
    <button class="search-btn" id="backupBtn">백업/불러오기</button>
  </div>

  <!-- 메인 탭 (글목록 / 예약목록 / 발행기록) -->
  <div class="main-tabs">
    <div class="main-tab on" data-main="list">글 목록</div>
    <div class="main-tab" data-main="scheduled">예약 목록</div>
    <div class="main-tab" data-main="auto">자동 스케줄러</div>
    <div class="main-tab" data-main="reply">자동 대댓글</div>
    <div class="main-tab" data-main="history">발행 기록</div>
    <div class="main-tab" data-main="token">토큰 발급</div>
  </div>

  <!-- 글 목록 화면 -->
  <div id="page-list">
    <div class="tabs" id="accTabs"></div>
    <div class="tabs" id="boxTabs"></div>
    <div class="search">
      <input id="searchQ" placeholder="제목·내용 찾기" autocomplete="off">
    </div>
    <div class="toolbar" id="toolbar"></div>
    <div id="postList"></div>
  </div>

  <!-- 예약 목록 화면 -->
  <div id="page-scheduled" style="display:none">
    <div id="scheduledList"></div>
  </div>

  <!-- 발행 기록 화면 -->
  <div id="page-history" style="display:none">
    <div id="historyList"></div>
  </div>

  <!-- 자동 대댓글 화면 -->
  <div id="page-reply" style="display:none">
    <div id="replyPage"></div>
  </div>

  <!-- 자동 스케줄러 화면 -->
  <div id="page-auto" style="display:none">
    <div id="autoPage"></div>
  </div>

  <!-- 토큰 발급 가이드 화면 -->
  <div id="page-token" style="display:none">
    <div id="tokenPage"></div>
  </div>
</div>

<div class="fab"><button id="newBtn">+ 새 글 쓰기</button></div>


</div>

<script>

// ══════════════════════════════════
//  상태 / 저장소
// ══════════════════════════════════
const MEMO_KEY = 'luwol-memo-v1';
const SCHED_KEY = 'luwol-sched-v1';
const HIST_KEY = 'luwol-hist-v1';

let D = { accs: [], boxes: [], posts: [] };
let schedules = [];
let history = [];
let curAcc = null, curBox = null, sortBy = 'recent', searchQ = '', mainTab = 'list';

const $ = id => document.getElementById(id);
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2,5);

function save() { localStorage.setItem(MEMO_KEY, JSON.stringify(D)); }
function saveSchedules() { localStorage.setItem(SCHED_KEY, JSON.stringify(schedules)); }
function saveHistory() { localStorage.setItem(HIST_KEY, JSON.stringify(history)); }

function load() {
  try { const r = localStorage.getItem(MEMO_KEY); if (r) D = JSON.parse(r); } catch(e) {}
  try { const r = localStorage.getItem(SCHED_KEY); if (r) schedules = JSON.parse(r); } catch(e) {}
  try { const r = localStorage.getItem(HIST_KEY); if (r) history = JSON.parse(r); } catch(e) {}
  // 계정 초기화
  if (!D.accs || !D.accs.length) {
    const defAcc = { id: uid(), name: '기본 계정', color: '#B59A62' };
    D.accs = [defAcc];
    D.boxes = ['게시글', '안내멘트', '공지사항', '이벤트'].map(n => ({ id: uid(), accId: defAcc.id, name: n }));
    D.posts = [];
  }
  // 기존 데이터 마이그레이션 (accId 없는 박스/포스트 처리)
  if (D.boxes && D.boxes.some(b => !b.accId)) {
    const firstAcc = D.accs[0];
    D.boxes.forEach(b => { if (!b.accId) b.accId = firstAcc.id; });
    D.posts.forEach(p => { if (!p.accId) p.accId = firstAcc.id; });
  }
  curAcc = D.accs[0]?.id || null;
  const accBoxes = D.boxes.filter(b => b.accId === curAcc);
  curBox = accBoxes[0]?.id || null;
}

// ══════════════════════════════════
//  유틸
// ══════════════════════════════════
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function when(ts) {
  const d = Math.floor((Date.now() - ts) / 864e5);
  if (d === 0) return '오늘';
  if (d === 1) return '어제';
  if (d < 7) return d + '일 전';
  const t = new Date(ts);
  return `${t.getMonth()+1}/${t.getDate()}`;
}
function fmtTime(iso) {
  const d = new Date(iso);
  return `${d.getMonth()+1}/${d.getDate()} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
}

// 변수 감지 ({이름} 형태)
function getVars(text) {
  const set = [];
  (text.match(/\{[^}\n]{1,24}\}/g) || []).forEach(v => { if (!set.includes(v)) set.push(v); });
  return set;
}

// 복사
async function copyText(t) {
  try { await navigator.clipboard.writeText(t); return true; } catch(e) {}
  try {
    const ta = document.createElement('textarea');
    ta.value = t; ta.style.cssText = 'position:fixed;top:-9999px;opacity:0';
    THROOT().appendChild(ta); ta.focus(); ta.select();
    const ok = document.execCommand('copy'); ta.remove();
    if (ok) return true;
  } catch(e) {}
  return false;
}

/* 시트·토스트를 #th-app 안에 붙인다.
   스타일을 #th-app 안으로 가뒀기 때문에 body 에 붙이면 꾸밈이 전부 사라진다. */
const THROOT = () => document.getElementById('th-app') || document.body;

function toast(msg) {
  document.querySelectorAll('.toast').forEach(el => el.remove());
  const el = document.createElement('div'); el.className = 'toast'; el.textContent = msg;
  THROOT().appendChild(el); setTimeout(() => el.remove(), 1800);
}

// ══════════════════════════════════
//  시트 (오버레이)
// ══════════════════════════════════
let sheetCb = null;
function openSheet(html, afterFn, actCb) {
  closeSheet();
  const ov = document.createElement('div'); ov.className = 'ov'; ov.id = 'ov';
  ov.innerHTML = `<div class="sheet"><div class="sheet-bar"></div>${html}</div>`;
  THROOT().appendChild(ov);
  sheetCb = actCb || null;
  ov.addEventListener('click', e => {
    if (e.target === ov) return closeSheet();
    const btn = e.target.closest('[data-x]');
    if (!btn) return;
    const x = btn.dataset.x;
    if (x === 'close') return closeSheet();
    if (sheetCb && sheetCb(x, btn)) return;
  });
  if (afterFn) setTimeout(afterFn, 60);
}
function closeSheet() { const o = $('ov'); if (o) o.remove(); sheetCb = null; }

