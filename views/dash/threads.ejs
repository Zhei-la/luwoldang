const REPLY_KEY = 'luwol-reply-v1';
let replyRules = [];

function saveReply() { localStorage.setItem(REPLY_KEY, JSON.stringify(replyRules)); }
function loadReply() { try { const r = localStorage.getItem(REPLY_KEY); if (r) replyRules = JSON.parse(r); } catch(e) {} }

function renderReplyPage() {
  const el = $('replyPage');
  el.innerHTML = `
    <div class="info-box">
      💬 <strong>자동 대댓글이란?</strong><br>
      내 Threads 게시글에 댓글이 달리면 자동으로 대댓글을 달아줘.<br>
      특정 키워드가 포함된 댓글에만 반응하거나, 모든 댓글에 자동 응답할 수 있어.<br>
      대댓글 끝에 <strong>DM 유도 문구</strong>를 자동으로 붙여서 DM이 오게 유도할 수도 있어.<br><br>
      <strong>⚠️ 실제 동작은 루월당 서버 연동 필요</strong> — 서버에서 1분마다 댓글 체크 후 자동 발송
    </div>
    <div style="background:rgba(96,165,250,.06);border:1px solid rgba(96,165,250,.2);border-radius:var(--r);padding:12px 14px;margin-bottom:16px;font-size:12px;color:#3B6EA5;line-height:1.8">
      📌 <strong>동작 방식</strong><br>
      서버가 1분마다 내 게시글의 새 댓글 체크<br>
      → 조건 맞으면 설정한 대댓글 자동 발송<br>
      → DM 유도 옵션 켜면 대댓글 끝에 문구 자동 추가<br>
      → 사람들이 DM 보내게 유도
