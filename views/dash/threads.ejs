function switchMain(tab) {
  mainTab = tab;
  document.querySelectorAll('.main-tab').forEach(el => el.classList.toggle('on', el.dataset.main === tab));
  $('page-list').style.display = tab === 'list' ? '' : 'none';
  $('page-scheduled').style.display = tab === 'scheduled' ? '' : 'none';
  $('page-history').style.display = tab === 'history' ? '' : 'none';
  $('page-auto').style.display = tab === 'auto' ? '' : 'none';
  $('page-reply').style.display = tab === 'reply' ? '' : 'none';
  $('page-token').style.display = tab === 'token' ? '' : 'none';
  $('newBtn').style.display = tab === 'list' ? '' : 'none';
  if (tab === 'scheduled') renderScheduled();
  if (tab === 'history') renderHistory();
  if (tab === 'auto') renderAutoPage();
  if (tab === 'reply') renderReplyPage();
  if (tab === 'token') renderTokenPage();
}

