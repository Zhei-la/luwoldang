<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= sheet.who.name %>님 상담지 · 루월당</title>
<meta name="theme-color" content="#12606C">
<link rel="icon" href="/img/favicon.png">
<link rel="stylesheet" href="/css/callsheet.css">
</head>
<body>
<%
  /* 대사 안의 줄바꿈은 CSS(white-space:pre-line)가 살려준다.
     여기서는 HTML로 새지 않게 막기만 한다. */
  function e(s){ return String(s==null?'':s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  /* 근거(why)에는 <b> 를 쓸 수 있게 열어둔다. 우리가 쓴 글만 들어간다. */
  function w(s){ return String(s==null?'':s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/&lt;b&gt;/g,'<b>').replace(/&lt;\/b&gt;/g,'</b>'); }
  var S = sheet.sections;
  var f = sheet.facts;
  var EL5 = ['목','화','토','금','수'];
  var els = f.els || {};
%>

<div class="phone">

  <div class="top">
    <div class="who">
      <div>
        <a class="back" href="<%= backTo %>">← 돌아가기</a>
        <div class="nm"><%= sheet.who.name %>님
          <span><%= sheet.who.gender || '' %><%= sheet.who.age != null ? ' · ' + sheet.who.age + '세' : '' %></span></div>
        <% if (sheet.who.ask) { %><div class="q">“<%= sheet.who.ask %>”</div><% } %>
      </div>
      <div class="timer">
        <div class="t" id="t">00:00</div>
        <div class="tbtns">
          <button type="button" id="tb">통화 시작</button>
          <%# 용어 탭은 탭 줄 오른쪽 끝이라 폰에서는 밀려 안 보인다.
              통화 중에 제일 급한 단추라 머리말에 따로 뺀다. %>
          <button type="button" id="goterm" class="hotb">용어 찾기</button>
        </div>
      </div>
    </div>
    <div class="tabs" role="tablist">
      <% S.forEach(function(s,i){ %>
        <button type="button" role="tab" aria-selected="<%= i===0 ? 'true':'false' %>"><%= s.title %></button>
      <% }); %>
      <button type="button" role="tab" aria-selected="false" class="hot">급질문 GPT</button>
      <button type="button" role="tab" aria-selected="false" class="hot">용어 찾기</button>
      <button type="button" role="tab" aria-selected="false">원국</button>
    </div>
  </div>


  <% S.forEach(function(s,si){ %>
  <section class="panel <%= si===0 ? 'on':'' %>" role="tabpanel">
    <p class="ph"><%= String(si+1).padStart(2,'0') %>
      <% if (s.mins) { %><span class="mins"><%= s.mins %></span><% } %></p>
    <h2 class="pt"><%= s.title %></h2>
    <% if (s.note) { %><p class="pd"><%- w(s.note) %></p><% } %>

    <% if (s.grades && s.grades.length) { %>
      <div class="grade"><table><tbody>
        <% s.grades.forEach(function(g,gi){ %>
          <tr data-go="<%= gi %>">
            <td class="g <%= g.g %>"><%= g.g %></td>
            <td><%= g.k %></td>
            <td class="n"><%= g.n %></td>
          </tr>
        <% }); %>
      </tbody></table></div>
    <% } %>

    <% if (s.picks && s.picks.length) { %>
      <p class="lbl">골라서 말하세요</p>
      <div class="picker" data-for=".pk<%= si %>">
        <% s.picks.forEach(function(p,pi){ %>
          <button type="button" aria-pressed="<%= pi===0 ? 'true':'false' %>"><%= p %></button>
        <% }); %>
      </div>
    <% } %>

    <%
      /* 칸이 나뉜 곳(성격·운세)은 groups, 아닌 곳은 blocks 하나로 그린다 */
      var units = (s.groups && s.groups.length) ? s.groups : [s.blocks];
      var multi = !!(s.groups && s.groups.length);
    %>
    <% units.forEach(function(blocks,ui){ %>
      <div class="<%= multi ? 'pk'+si+' sub '+(ui===0?'on':'') : '' %>">

        <% if (s.states && s.stateAt === ui) { %>
          <p class="lbl">지금 어떤 상황이신지 여쭤보고 누르세요</p>
          <div class="picker st" data-for=".stx<%= si %>">
            <% s.states.forEach(function(st,xi){ %>
              <button type="button" aria-pressed="<%= xi===0 ? 'true':'false' %>"><%= st.k %></button>
            <% }); %>
          </div>
          <% s.states.forEach(function(st,xi){ %>
            <div class="stx<%= si %> sub <%= xi===0?'on':'' %>">
              <% st.b.forEach(function(b){ %>
                <% if (b.tag) { %><span class="cue <%= b.tone==='warn'?'warn':(b.tone==='ok'?'ok':'') %>"><%= b.tag %></span><% } %>
                <div class="say <%= b.tone==='warn'?'warn':(b.tone==='ok'?'ok':'') %>">
                  <% b.say.forEach(function(p){ %><p><%= p %></p><% }); %>
                </div>
                <% if (b.why) { %>
                  <details class="why"><summary>왜 그렇게 나오나</summary>
                    <div class="in"><%- w(b.why) %></div></details>
                <% } %>
                <% if (b.terms && b.terms.length) { %>
                  <details class="tin"><summary>이 말이 무슨 뜻이냐고 물으면 — <%= b.terms.map(function(x){return x.t}).join(' · ') %></summary>
                    <div class="in"><% b.terms.forEach(function(x){ %>
                      <div class="tw"><b><%= x.t %></b><span><%= x.short %></span>
                        <% if (x.mine) { %><div class="say mine"><span class="cue mi">이 손님은</span><p><%= x.mine %></p></div><% } %>
                        <div class="say"><p><%= x.say %></p></div></div>
                    <% }); %></div></details>
                <% } %>

              <% }); %>
            </div>
          <% }); %>

        <% } else { %>
          <% blocks.forEach(function(b,bi){ %>
            <% if (b.tag) { %>
              <% if (/^\d+$/.test(b.tag)) { %>
                <span class="num"><%= b.tag %></span>
              <% } else { %>
                <span class="cue <%= b.tone==='warn'?'warn':(b.tone==='ok'?'ok':'') %>"><%= b.tag %></span>
              <% } %>
            <% } %>
            <div class="say <%= b.tone==='warn'?'warn':(b.tone==='ok'?'ok':'') %>">
              <% b.say.forEach(function(p){ %><p><%= p %></p><% }); %>
            </div>
            <% if (b.why) { %>
              <details class="why"><summary>왜 그렇게 나오나 · 이럴 땐 이렇게</summary>
                <div class="in"><%- w(b.why) %></div></details>
            <% } %>
            <% if (b.terms && b.terms.length) { %>
              <details class="tin"><summary>이 말이 무슨 뜻이냐고 물으면 — <%= b.terms.map(function(x){return x.t}).join(' · ') %></summary>
                <div class="in"><% b.terms.forEach(function(x){ %>
                  <div class="tw"><b><%= x.t %></b><span><%= x.short %></span>
                    <% if (x.mine) { %><div class="say mine"><span class="cue mi">이 손님은</span><p><%= x.mine %></p></div><% } %>
                    <div class="say"><p><%= x.say %></p></div></div>
                <% }); %></div></details>
            <% } %>

          <% }); %>
        <% } %>

      </div>
    <% }); %>

    <% if (s.qs && s.qs.length) { %>
      <p class="qhead">이런 질문이 오면</p>
      <% s.qs.forEach(function(q){ %>
        <details class="qa"><summary><%= q.q %></summary>
          <div class="in">
            <% if (q.a) { %><div class="say"><p><%= q.a %></p></div><% } %>
            <% if (q.tip) { %><p class="tip"><%- w(q.tip) %></p><% } %>
          </div>
        </details>
      <% }); %>
    <% } %>

    <button type="button" class="next">다음 →</button>
  </section>
  <% }); %>


  <!-- 급질문 GPT -->
  <section class="panel" role="tabpanel">
    <p class="ph">급할 때 <span class="mins">막힐 때만</span></p>
    <h2 class="pt">급질문 GPT</h2>
    <p class="pd">준비 안 된 질문이 오면 여기 적고 <b>복사해서 GPT에 붙여넣으세요.</b>
      손님 사주와 지금까지 나눈 이야기가 <b>자동으로 같이 들어갑니다.</b></p>

    <div class="amber" style="margin-top:0;margin-bottom:18px">
      <b>통화를 끊지 마세요.</b> “잠시만요, 이 부분은 좀 더 정확하게 봐드릴게요” 하고
      10초 정도 여유를 두시면 됩니다. <b>뜸 들이는 건 이상하지 않습니다.</b>
      오히려 신중해 보입니다.
    </div>

    <p class="lbl">손님이 방금 물어본 것</p>
    <input class="qin" id="qin" type="text" placeholder="예) 내년에 이직하면 잘 풀릴까요?">

    <p class="lbl" style="margin-top:18px">통화 중 메모 — 여기 적은 것도 같이 들어갑니다</p>
    <textarea id="memo" placeholder="예) 팀장이랑 안 맞는다고 함&#10;예) 이직 준비 이미 시작 — 포트폴리오 만드는 중"></textarea>

    <button type="button" class="btn" id="copy" style="margin-top:16px">프롬프트 복사하기</button>
    <a class="btn gh" href="https://chatgpt.com/" target="_blank" rel="noopener">GPT 열기</a>
    <button type="button" class="btn gh" id="toggle">프롬프트 접기</button>
    <div id="prwrap"><pre class="pr" id="pr"></pre></div>

    <div class="amber">
      <b>GPT가 준 답을 그대로 읽지 마세요.</b> 한 번 눈으로 훑고,
      금지어(무조건·반드시·병명·이혼)가 없는지만 보고 읽으시면 됩니다.
      맨 아래 <b>[근거]</b> 줄은 손님한테 읽는 게 아니라 <b>선생님이 보는 것</b>입니다.
    </div>

    <div class="warnbox">
      <h4>절대 하면 안 되는 말</h4>
      <ul>
        <li><b>죽음·큰 병 단정</b> — “큰 병 온다”, “조심 안 하면 위험하다” 금지</li>
        <li><b>병명</b> — 무슨 병이라고 말하는 순간 의료법입니다</li>
        <li><b>이혼·헤어지라 마라</b> — 관계를 끊으라는 말은 하지 않습니다</li>
        <li><b>“무조건”, “반드시”, “틀림없이”</b> — 단정하는 부사를 빼세요</li>
        <li><b>겁주고 부적·굿 권하기</b> — 신고 대상입니다</li>
        <li><b>다른 곳 풀이 깎아내리기</b> — “거긴 틀렸다” 금지</li>
        <li><b>상대 생년월일 없이 궁합 단정</b> — 사고가 제일 많이 나는 자리</li>
        <li><b>구체적 액수·연도·직업명 찍기</b> — 성질까지만 말합니다</li>
      </ul>
    </div>
    <button type="button" class="next">다음 →</button>
  </section>


  <!-- 용어 찾기 -->
  <section class="panel" role="tabpanel">
    <p class="ph">사전 <span class="mins">통화 중 검색</span></p>
    <h2 class="pt">용어 찾기</h2>
    <p class="pd">손님이 용어를 던지면 여기서 찾으세요.
      <b>한 글자만 쳐도 나옵니다.</b> 파란 칸이 손님에게 그대로 읽는 말입니다.</p>

    <div class="sbox">
      <input class="sin" id="tq" type="search" autocomplete="off"
             placeholder="도화살, 용신, 삼재, 공망…">
    </div>
    <div class="cats" id="tcats">
      <button type="button" aria-pressed="true">전체</button>
      <% sheet.cats.forEach(function(c){ %><button type="button" aria-pressed="false"><%= c %></button><% }); %>
    </div>
    <div id="tlist"></div>
  </section>


  <!-- 원국 -->
  <%
    /* 표를 못 읽어도 통화가 되게 만드는 칸이다.
       칸마다 data-term 을 달아두면 화면 JS 가 용어 사전에서 찾아
       밑에서 카드를 올려준다. 본인과 상대방이 같은 모양이라 함수로 뽑는다. */
    function tdT(cls, txt, term){
      var t = String(term == null ? '' : term).trim();
      var body = e(txt == null ? '' : txt);
      if (!t) return '<td class="' + cls + '">' + body + '</td>';
      return '<td class="' + cls + ' tp" data-term="' + e(t) + '">' + body + '</td>';
    }
    function chartHtml(sj, meLabel){
      var K = ['hour','day','month','year'];
      var P = sj.pillars || {}, PK = sj.pillarsKo || {}, D = sj.detail || {};
      var h = '<div class="chart"><table><thead><tr>'
        + '<th class="tp" data-term="시주">시</th><th class="tp" data-term="일주">일</th>'
        + '<th class="tp" data-term="월주">월</th><th class="tp" data-term="년주">년</th>'
        + '</tr></thead><tbody>';
      h += '<tr>' + K.map(function(k){
        return tdT('gz' + (k==='day'?' me':''), (P[k]||'').charAt(0), k==='day' ? '일간' : '천간');
      }).join('') + '</tr>';
      h += '<tr>' + K.map(function(k){
        return tdT('ko' + (k==='day'?' me':''), (PK[k]||'').charAt(0), k==='day' ? '일간' : '천간');
      }).join('') + '</tr>';
      h += '<tr>' + K.map(function(k){
        var c = D[k], g = c && c.stem && c.stem.god;
        return k==='day' ? tdT('gd me', meLabel, '일간') : tdT('gd', g || '', g || '');
      }).join('') + '</tr>';
      h += '<tr>' + K.map(function(k){ return tdT('gz', (P[k]||'').charAt(1), '지지'); }).join('') + '</tr>';
      h += '<tr>' + K.map(function(k){ return tdT('ko', (PK[k]||'').charAt(1), '지지'); }).join('') + '</tr>';
      h += '<tr>' + K.map(function(k){
        var c = D[k], g = c && c.branch && c.branch.god;
        return tdT('gd', g || '', g || '');
      }).join('') + '</tr>';
      return h + '</tbody></table></div>';
    }
    function elsHtml(m){
      var h = '<div class="els">';
      EL5.forEach(function(el){
        var n = (m || {})[el] || 0;
        h += '<div class="el tp ' + (n===0?'zero':(n>=4?'many':'')) + '" data-term="오행">'
          + '<div class="k">' + el + '</div><div class="v">' + n + '</div></div>';
      });
      return h + '</div>';
    }
    /* 대운 표 — 지금 칸을 앞에서 둘째에 두고 네 칸 */
    function dwHtml(ff){
      if (!ff || !ff.dwList || !ff.dwList.length) return '';
      var from = Math.max(0, ff.curIdx - 1);
      var rows = ff.dwList.slice(from, from + 4);
      var now = function(d){ return ff.curDw && d.age === ff.curDw.age; };
      var h = '<div class="chart"><table><thead><tr>'
        + rows.map(function(d){ return '<th>' + d.age + '세</th>'; }).join('')
        + '</tr></thead><tbody>';
      h += '<tr>' + rows.map(function(d){
        return '<td class="gz' + (now(d)?' me':'') + '">' + e(d.ganzi) + '</td>'; }).join('') + '</tr>';
      h += '<tr>' + rows.map(function(d){
        return '<td class="ko' + (now(d)?' me':'') + '">' + e(d.ko) + '</td>'; }).join('') + '</tr>';
      h += '<tr>' + rows.map(function(d){
        return tdT('gd' + (now(d)?' me':''), (d.group || '') + (now(d) ? ' · 지금' : ''), d.group || '');
      }).join('') + '</tr>';
      return h + '</tbody></table></div>';
    }
    /* 요약 한 줄 — 일간·신강약·십성 무리를 전부 눌러볼 수 있게 */
    function sumHtml(ff){
      var t = function(term, txt){ return '<b class="tp" data-term="' + e(term) + '">' + e(txt) + '</b>'; };
      var h = '<p class="pd sum">' + t('일간', '일간 ' + ff.il.name) + ' · '
        + t(ff.weak ? '신약' : '신강', ff.weak ? '신약' : '신강') + ' · ';
      h += ['비겁','식상','재성','관성','인성'].map(function(g){
        return t(g, g + ff.grp[g]); }).join(' ');
      if (ff.none.length) h += ' · ' + t('오행', ff.none.join('·') + ' 없음');
      if (ff.gongmang && ff.gongmang.length) h += ' · ' + t('공망', '공망 ' + ff.gongmang.join('·'));
      if (!ff.timeKnown) h += ' · ' + t('시주', '시 모름');
      return h + '</p>';
    }
    var WG = sheet.wonguk || {};
    var PWG = sheet.partnerWonguk || null;
    var hasPartner = (typeof partnerSaju !== 'undefined' && partnerSaju);
    var PF = (typeof partnerFacts !== 'undefined') ? partnerFacts : null;
  %>
  <section class="panel" role="tabpanel">
    <p class="ph">참고 <span class="mins">눌러보세요</span></p>
    <h2 class="pt">원국</h2>
    <p class="pd"><b>표를 못 읽으셔도 됩니다.</b>
      표든 글자든 <b>아무 칸이나 눌러보세요.</b> 그게 무슨 뜻인지,
      그리고 <b>이 손님은 어떤지</b>까지 밑에서 올라옵니다.
      파란 칸은 손님한테 그대로 읽으셔도 되는 말입니다.</p>

    <% if (hasPartner) { %><p class="lbl"><%= sheet.who.name %>님</p><% } %>
    <%- chartHtml(saju, '나') %>
    <%- elsHtml(els) %>
    <%- sumHtml(f) %>

    <%# ── 대운 ── %>
    <% if (f.dwList && f.dwList.length) { %>
      <p class="qhead tp" data-term="대운">대운 — 10년마다 바뀌는 큰 흐름
        <%= f.forward ? '(순행)' : '(역행)' %></p>
      <%- dwHtml(f) %>
      <% if (WG.dw) { %>
        <span class="cue">지금 <%= WG.dw.ko %> · <%= WG.dw.span %></span>
        <div class="say">
          <p><b><%= WG.dw.head %></b></p>
          <p><%= WG.dw.say %></p>
        </div>
        <details class="why"><summary>왜 그렇게 나오나</summary>
          <div class="in">지금 대운이 <b><%= WG.dw.ko %></b>,
            이 손님에게는 <b><%= WG.dw.group %></b> 자리입니다 — <%= WG.dw.mean %>.<br>
            <%= f.weak ? '신약' : '신강' %> 기준으로 읽었습니다.
            <b>같은 대운이라도 신강·신약에 따라 뜻이 뒤집힙니다.</b></div></details>
        <% if (WG.dw.nextKo) { %>
          <span class="cue ok">다음 대운</span>
          <div class="say ok">
            <p><%= WG.dw.nextAge %>세부터는 <%= WG.dw.nextKo %> 대운이에요.
<%= WG.dw.nextLine %></p>
          </div>
        <% } %>
      <% } %>
    <% } %>

    <%# ── 세운 ── %>
    <% if (WG.se) { %>
      <p class="qhead tp" data-term="세운"><%= WG.se.year %>년 세운 — 올해 한 해</p>
      <span class="cue"><%= WG.se.ko %> · <%= WG.se.group %></span>
      <div class="say">
        <p><b><%= WG.se.head %></b></p>
        <p><%= WG.se.say %></p>
      </div>
      <details class="why"><summary>왜 그렇게 나오나 · 대운과 다르면</summary>
        <div class="in">올해 간지가 <b><%= WG.se.ko %></b>,
          이 손님에게 <b><%= WG.se.group %></b> 자리입니다 — <%= WG.se.mean %>.<br>
          대운이 10년짜리 배경이라면 세운은 그 위에 올해 하나만 얹은 것입니다.
          <b>둘이 다르면 대운을 먼저 말하세요.</b> 배경이 이기고,
          올해는 그 안에서 어떤 색이 도는지입니다.</div></details>
    <% } %>

    <%# ── 월운 ── %>
    <% if (WG.wol && WG.wol.length) { %>
      <p class="qhead tp" data-term="월운">월운 — <%= WG.se ? WG.se.year : f.year %>년 달마다</p>
      <div class="chart wol"><table><tbody>
        <% [0,6].forEach(function(off){ %>
          <tr><% WG.wol.slice(off, off+6).forEach(function(m){ %>
            <th><%= m.month %>월</th><% }); %></tr>
          <tr><% WG.wol.slice(off, off+6).forEach(function(m){ %>
            <td class="ko"><%= m.ko %></td><% }); %></tr>
          <tr><% WG.wol.slice(off, off+6).forEach(function(m){ %>
            <td class="gd tp" data-term="<%= m.group %>"><%= m.group %></td><% }); %></tr>
        <% }); %>
      </tbody></table></div>
      <%# 달 풀이는 접어둔다. 물을 때만 쓰는 것이라 늘 펴 두면 화면만 길어진다. %>
      <details class="tin"><summary>달마다 무슨 때인지 — <%= WG.wolSum.map(function(g){ return g.group }).join(' · ') %></summary>
        <div class="in">
          <% WG.wolSum.forEach(function(g){ %>
            <span class="cue"><%= g.months.join('·') %>월 · <%= g.group %></span>
            <div class="say"><p><b><%= g.head %></b></p><p><%= g.say %></p></div>
          <% }); %>
        </div></details>
      <details class="why"><summary>월운은 언제 쓰나</summary>
        <div class="in">「몇 월쯤이 좋아요?」라고 물을 때만 씁니다.
          먼저 꺼내지 마세요 — 달까지 짚기 시작하면 손님이 그 달만 기다립니다.<br>
          <b>달은 대운·세운보다 훨씬 약합니다.</b> 큰 흐름이 안 좋은데
          한 달이 좋다고 뒤집히지 않습니다. 물으면 「이 달쯤 움직이시면
          수월합니다」 정도로만 말하고 넘어가세요.</div></details>
    <% } %>

    <%# 궁합이면 상대방 만세력도 같이 본다. 한쪽만 보고 궁합을 말할 수는 없다. %>
    <% if (hasPartner) { %>
      <% var pels = partnerSaju.elements || {}; %>
      <p class="lbl" style="margin-top:30px;padding-top:24px;border-top:1px solid var(--line)">
        <%= partner && partner.name ? partner.name + '님' : '상대방' %>
      </p>
      <%- chartHtml(partnerSaju, '본인') %>
      <%- elsHtml(pels) %>
      <% if (PF) { %>
        <%- sumHtml(PF) %>

        <% if (PF.dwList && PF.dwList.length) { %>
          <p class="qhead tp" data-term="대운">상대방 대운</p>
          <%- dwHtml(PF) %>
          <% if (PWG && PWG.dw) { %>
            <span class="cue">지금 <%= PWG.dw.ko %> · <%= PWG.dw.span %></span>
            <div class="say"><p><b><%= PWG.dw.head %></b></p><p><%= PWG.dw.say %></p></div>
          <% } %>
        <% } %>
        <% if (PWG && PWG.se) { %>
          <p class="qhead tp" data-term="세운">상대방 <%= PWG.se.year %>년 세운</p>
          <span class="cue"><%= PWG.se.ko %> · <%= PWG.se.group %></span>
          <div class="say"><p><b><%= PWG.se.head %></b></p><p><%= PWG.se.say %></p></div>
        <% } %>
        <details class="why"><summary>상대방 운은 어디까지 말하나</summary>
          <div class="in">상대방 대운·세운은 <b>먼저 꺼내지 마세요.</b>
            이 통화의 주인공은 <%= sheet.who.name %>님입니다.<br>
            「그 사람은 요즘 어때요?」라고 물을 때만 쓰고, <b>성질까지만</b>
            말합니다. 상대방의 구체적인 일·돈·건강은 찍지 않습니다.
            그 자리에 없는 사람 이야기입니다.</div></details>
      <% } %>
    <% } %>
  </section>


  <%# 눌린 용어가 밑에서 올라오는 자리. 내용은 화면 JS 가 채운다. %>
  <div class="tsheet" id="tsheet" hidden>
    <div class="tsheet-bg" id="tsheetbg"></div>
    <div class="tsheet-in">
      <button type="button" class="tsheet-x" id="tsheetx" aria-label="닫기">닫기 ✕</button>
      <div id="tsheetbody"></div>
    </div>
  </div>

  <p class="foot">
    이 상담지는 <%= sheet.who.name %>님의 실제 만세력 계산 결과로 만들어졌습니다.<br>
    대사는 그대로 읽으셔도 되고, 손님 반응에 따라 골라 쓰셔도 됩니다.
  </p>
</div>

<script>
var CS_TERMS = <%- JSON.stringify(sheet.terms) %>;
var CS_PROMPT = <%- JSON.stringify(sheet.promptParts) %>;
var CS_KEY = 'callmemo:<%= lead ? lead.id : (sheet.who.name + sheet.who.birthText) %>';
</script>
<script src="/js/callsheet.js"></script>
</body>
</html>
