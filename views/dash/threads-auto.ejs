             data-lpignore="true" data-form-type="other">
      <div style="margin-top:12px"><button class="ta-btn" type="button" id="taConnect">계정 불러오기</button></div>
      <div id="taTokenMsg"></div>

      <!-- 연결하고 나서도 다시 볼 수 있게 접이식으로 둔다 -->
      <details class="ta-howto" <%= accounts.length ? '' : 'open' %>>
        <summary>Zernio 열쇠 받는 방법 보기 <span>화면 사진과 함께 16단계</span></summary>
        <div class="ta-howto-in">
          <ol class="ta-steps">
            <li>
              <b>Zernio 에 가입합니다</b>
