<%- include('../partials/dash-top', { user: user, active: active, title: '스레드 자동화' }) %>

<style>
/* ══════════════════════════════════════════════════════════
 * 스레드 자동화 — 주제 하나로 글을 만들고, 지침에 맞는지 보고, 올린다.
 * 모든 규칙을 #ta 안에 가둔다. 밖으로 새면 대시보드가 깨진다.
 * ══════════════════════════════════════════════════════════ */
#ta{
  --line:#E6DFD0; --line2:#F0EBDF; --ink:#2B2621; --ink2:#5C5449; --dim:#8A8071;
  --paper:#FFFDF8; --sub:#F7F3EA;
  --gold:#B59A62; --gold-d:#8A7340;
  --ok:#1F7A52; --ok-bg:#E8F3ED;
  --no:#B3401F; --no-bg:#FBEAE4;
  --warn:#8A6A12; --warn-bg:#FAF2DC;
  font-size:15px; color:var(--ink);
}
#ta *{box-sizing:border-box}
#ta .ta-card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:20px;margin-bottom:16px}
#ta h2{font-size:17px;font-weight:700;margin:0 0 4px}
#ta .ta-sub{font-size:13.5px;color:var(--dim);line-height:1.6;margin-bottom:14px}

/* 탭 */
#ta .ta-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px}
#ta .ta-tab{border:1px solid var(--line);background:#fff;color:var(--ink2);border-radius:100px;
  padding:8px 16px;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit}
#ta .ta-tab[aria-selected="true"]{background:var(--ink);color:#fff;border-color:var(--ink)}
#ta .ta-panel[hidden]{display:none}

/* 지금 올릴 계정 — 늘 보이게 */
#ta .ta-who{display:flex;align-items:center;gap:10px;flex-wrap:wrap;
  background:var(--sub);border:1px solid var(--line);border-radius:12px;
  padding:11px 15px;margin-bottom:16px;font-size:14px}
#ta .ta-who b{color:var(--ink);font-weight:700}
#ta .ta-who .none{color:var(--no);font-weight:700}
#ta .ta-who select{width:auto;min-width:150px;padding:7px 10px;font-size:14px}
#ta .ta-who .sp{margin-left:auto;font-size:13px;color:var(--dim)}

/* 입력 */
#ta label{display:block;font-size:13px;font-weight:700;color:var(--ink2);margin-bottom:6px}
#ta input[type=text],#ta input[type=password],#ta textarea,#ta select{
  width:100%;padding:11px 13px;border:1px solid var(--line);border-radius:9px;
  font-size:15px;font-family:inherit;color:var(--ink);background:#fff}
#ta textarea{line-height:1.8;resize:vertical}
#ta input:focus,#ta textarea:focus,#ta select:focus{outline:0;border-color:var(--gold)}
#ta .ta-row{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end}
#ta .ta-row>div{flex:1;min-width:150px}

/* 단추 */
#ta .ta-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;
  background:var(--gold);color:#fff;border:0;border-radius:9px;padding:12px 20px;
  font-size:15px;font-weight:700;cursor:pointer;font-family:inherit}
#ta .ta-btn:hover{background:var(--gold-d)}
#ta .ta-btn[disabled]{opacity:.5;cursor:default}
#ta .ta-btn.ghost{background:#fff;color:var(--ink2);border:1px solid var(--line)}
#ta .ta-btn.ghost:hover{background:var(--sub);color:var(--ink)}
#ta .ta-btn.sm{padding:8px 14px;font-size:13.5px}
#ta .ta-btn.danger{background:#fff;color:var(--no);border:1px solid var(--no)}
#ta .ta-btn.go{background:var(--ok)}
#ta .ta-btn.go:hover{background:#17603F}

/* 알림 */
#ta .ta-msg{border-radius:9px;padding:13px 15px;font-size:14px;line-height:1.7;margin-bottom:14px;white-space:pre-wrap}
#ta .ta-msg.err{background:var(--no-bg);color:var(--no)}
#ta .ta-msg.ok{background:var(--ok-bg);color:var(--ok)}
#ta .ta-msg.warn{background:var(--warn-bg);color:var(--warn)}

/* 글 카드 */
#ta .ta-post{border:1px solid var(--line);border-radius:12px;background:#fff;margin-bottom:14px;overflow:hidden}
#ta .ta-post.picked{border-color:var(--gold);box-shadow:0 0 0 2px rgba(181,154,98,.18)}
#ta .ta-head{display:flex;gap:8px;align-items:center;flex-wrap:wrap;
  padding:13px 16px;background:var(--sub);border-bottom:1px solid var(--line2)}
#ta .ta-tag{font-size:12px;font-weight:700;padding:3px 9px;border-radius:100px;background:#fff;border:1px solid var(--line);color:var(--ink2)}
#ta .ta-tag.form{background:var(--ink);color:#fff;border-color:var(--ink)}
#ta .ta-tag.ok{background:var(--ok-bg);color:var(--ok);border-color:transparent}
#ta .ta-tag.no{background:var(--no-bg);color:var(--no);border-color:transparent}
#ta .ta-head .ta-sp{margin-left:auto;display:flex;gap:6px;align-items:center;flex-wrap:wrap}
#ta .ta-body{padding:16px}
#ta .ta-part{border-left:3px solid var(--line);padding:0 0 0 14px;margin-bottom:16px}
#ta .ta-part:last-child{margin-bottom:0}
#ta .ta-part .no{font-size:12px;font-weight:700;color:var(--dim);margin-bottom:6px}
#ta .ta-part .txt{font-size:15px;line-height:1.85;white-space:pre-wrap;word-break:keep-all}
#ta .ta-part .len{font-size:12px;color:var(--dim);margin-top:6px}
#ta .ta-part .len.over{color:var(--no);font-weight:700}
#ta .ta-part textarea{margin-bottom:4px}

/* 점검 결과 */
#ta .ta-check{border-top:1px solid var(--line2);padding:14px 16px;background:var(--paper)}
#ta .ta-chk{display:flex;gap:9px;align-items:baseline;font-size:13.5px;line-height:1.6;padding:3px 0}
#ta .ta-chk i{font-style:normal;flex:none;width:16px;font-weight:700}
#ta .ta-chk.pass i{color:var(--ok)}
#ta .ta-chk.fail i{color:var(--no)}
#ta .ta-chk.soft i{color:var(--warn)}
#ta .ta-chk b{font-weight:600;color:var(--ink)}
#ta .ta-chk span{color:var(--dim)}
#ta .ta-verdict{font-size:13.5px;font-weight:700;padding:8px 12px;border-radius:8px;margin-bottom:10px;display:inline-block}
#ta .ta-verdict.ok{background:var(--ok-bg);color:var(--ok)}
#ta .ta-verdict.no{background:var(--no-bg);color:var(--no)}

/* 후킹 스캔 */
#ta .ta-hooks{display:flex;flex-wrap:wrap;gap:6px}
#ta .ta-hook{font-size:12.5px;padding:5px 10px;border-radius:100px;border:1px solid var(--line);background:#fff;color:var(--dim)}
#ta .ta-hook.usable{border-color:var(--ok);color:var(--ok);background:var(--ok-bg);font-weight:600}
#ta .ta-hook.combinable{border-color:var(--gold);color:var(--gold-d);font-weight:600}
#ta .ta-hook.blocked{opacity:.55;text-decoration:line-through}

/* 숫자 요약 */
#ta .ta-nums{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}
#ta .ta-num{flex:1;min-width:110px;background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:14px}
#ta .ta-num b{display:block;font-size:22px;font-weight:800;color:var(--ink)}
#ta .ta-num span{font-size:12.5px;color:var(--dim)}

/* 주제 고르기 */
#ta .ta-pick{margin-top:16px;border-top:1px solid var(--line2);padding-top:14px}
#ta .ta-pick-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}
#ta .ta-pick-top b{font-size:14px;color:var(--ink2);margin-right:auto}
#ta .ta-chips{display:flex;flex-wrap:wrap;gap:7px}
#ta .ta-chip{border:1px solid var(--line);background:#fff;color:var(--ink2);
  border-radius:100px;padding:7px 14px;font-size:13.5px;font-weight:600;
  cursor:pointer;font-family:inherit}
#ta .ta-chip:hover{border-color:var(--gold);color:var(--gold-d);background:var(--sub)}
#ta .ta-chip.on{background:var(--ink);color:#fff;border-color:var(--ink)}

/* 연결 안내 단계 */
#ta .ta-steps{list-style:none;counter-reset:s;padding:0;margin:0 0 4px}
#ta .ta-steps li{counter-increment:s;position:relative;padding:0 0 16px 38px;
  border-left:2px solid var(--line2);margin-left:11px}
#ta .ta-steps li:last-child{border-left-color:transparent;padding-bottom:4px}
#ta .ta-steps li:before{content:counter(s);position:absolute;left:-13px;top:0;
  width:24px;height:24px;border-radius:50%;background:var(--gold);color:#fff;
  font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center}
#ta .ta-steps li > b{display:block;font-size:15px;color:var(--ink);margin-bottom:5px}
#ta .ta-steps li span b{color:var(--ink2);font-weight:700}
#ta .ta-steps li span{display:block;font-size:13.5px;color:var(--dim);line-height:1.75}
#ta .ta-steps a{color:var(--gold-d);font-weight:700}
#ta .ta-steps code{background:var(--sub);padding:2px 6px;border-radius:4px;font-size:12.5px}

/* 등록된 계정 목록 */
#ta .ta-steps li img{display:block;width:100%;max-width:420px;margin-top:9px;
  border:1px solid var(--line);border-radius:8px;background:#fff;cursor:zoom-in}
#ta .ta-steps li img.wide{max-width:100%}
/* 사진을 누르면 크게 본다 — 새 창으로 나가면 하던 게 끊긴다 */
#ta .ta-zoom{position:fixed;inset:0;z-index:200;background:rgba(30,26,22,.9);
  display:none;align-items:center;justify-content:center;padding:20px}
#ta .ta-zoom.open{display:flex}
#ta .ta-zoom img{max-width:100%;max-height:92vh;border-radius:8px;background:#fff}
#ta .ta-zoom .x{position:absolute;top:14px;right:16px;width:44px;height:44px;border:0;
  border-radius:50%;background:rgba(255,255,255,.18);color:#fff;font-size:26px;
  cursor:pointer;font-family:inherit;line-height:1}

#ta .ta-howto{border:1px solid var(--line);border-radius:12px;background:#fff;margin-top:14px}
#ta .ta-howto summary{cursor:pointer;padding:14px 16px;font-size:15px;font-weight:700;
  color:var(--ink);list-style:none;display:flex;align-items:center;gap:8px}
#ta .ta-howto summary::-webkit-details-marker{display:none}
#ta .ta-howto summary:before{content:'▸';color:var(--gold);font-size:13px}
#ta .ta-howto[open] summary:before{content:'▾'}
#ta .ta-howto summary span{font-size:13px;font-weight:500;color:var(--dim);margin-left:auto}
#ta .ta-howto summary:hover{background:var(--sub)}
#ta .ta-howto-in{padding:6px 16px 18px;border-top:1px solid var(--line2)}

/* ── 언제 올릴지 고르는 창 ────────────────────────────
   전에는 prompt() 로 「2026-09-01 21:00」 처럼 적게 했다.
   형식을 틀리면 그대로 튕겨서, 굴려서 고르는 방식으로 바꿨다. */
#ta .ta-when{position:fixed;inset:0;z-index:210;background:rgba(30,26,22,.55);
  display:none;align-items:flex-end;justify-content:center}
#ta .ta-when.open{display:flex}
#ta .ta-when-box{background:#fff;width:100%;max-width:460px;border-radius:18px 18px 0 0;
  padding:20px 20px calc(20px + env(safe-area-inset-bottom));box-shadow:0 -8px 40px rgba(0,0,0,.2)}
@media (min-width:520px){
  #ta .ta-when{align-items:center}
  #ta .ta-when-box{border-radius:18px;padding-bottom:20px}
}
#ta .ta-when h3{margin:0 0 3px;font-size:17px;color:var(--ink)}
#ta .ta-when .ta-when-sub{margin:0 0 14px;font-size:13px;color:var(--dim)}
#ta .ta-quick{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}
#ta .ta-quick button{border:1px solid var(--line);background:#fff;color:var(--ink2);
  border-radius:100px;padding:7px 13px;font-size:13px;font-weight:600;
  cursor:pointer;font-family:inherit}
#ta .ta-quick button:hover{border-color:var(--gold);color:var(--gold-d)}

/* 굴림판 — 가운데 칸에 걸리는 것이 고른 값이다 */
#ta .ta-rolls{position:relative;display:flex;gap:8px;
  border:1px solid var(--line);border-radius:12px;background:var(--sub);
  padding:0 8px;overflow:hidden}
#ta .ta-roll{flex:1;min-width:0;height:180px;overflow-y:auto;
  scroll-snap-type:y mandatory;scrollbar-width:none;-ms-overflow-style:none;
  padding:70px 0;text-align:center;cursor:grab;touch-action:pan-y}
#ta .ta-roll::-webkit-scrollbar{display:none}
#ta .ta-roll.grabbing{cursor:grabbing}
#ta .ta-roll div{scroll-snap-align:center;height:40px;line-height:40px;
  font-size:15px;color:var(--dim);white-space:nowrap;overflow:hidden;
  text-overflow:ellipsis;user-select:none;transition:color .12s,font-weight .12s}
#ta .ta-roll div.on{color:var(--ink);font-weight:800;font-size:16px}
/* 가운데 칸 표시. 굴림판 위에 얹기만 하고 손짓은 통과시킨다 */
#ta .ta-rolls:before{content:'';position:absolute;left:8px;right:8px;top:70px;height:40px;
  border-top:1px solid var(--gold);border-bottom:1px solid var(--gold);
  background:rgba(176,141,87,.07);pointer-events:none;z-index:1}
#ta .ta-when-read{margin:14px 0 0;text-align:center;font-size:15px;font-weight:800;color:var(--ink)}
#ta .ta-when-warn{margin:6px 0 0;text-align:center;font-size:13px;color:var(--no);min-height:18px}
#ta .ta-when-act{display:flex;gap:8px;margin-top:14px}
#ta .ta-when-act .ta-btn{flex:1;justify-content:center}

/* ── 상태 딱지 ──────────────────────────────────────
   「예약중」 인지 「올라간 글」 인지 한눈에 보여야 한다. */
#ta .ta-state{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:800;
  padding:4px 11px;border-radius:100px;border:1px solid var(--line);
  background:#fff;color:var(--ink2)}
#ta .ta-state:before{content:'';width:7px;height:7px;border-radius:50%;background:currentColor;flex:none}
#ta .ta-state.wait{background:#fff7e6;color:#8a6100;border-color:transparent}
#ta .ta-state.done{background:var(--ok-bg);color:var(--ok);border-color:transparent}
#ta .ta-state.bad{background:var(--no-bg);color:var(--no);border-color:transparent}
#ta .ta-state small{font-weight:600;opacity:.85}
#ta .ta-accs{display:flex;flex-direction:column;gap:8px;margin-bottom:14px}
#ta .ta-acc{display:flex;align-items:center;gap:10px;border:1px solid var(--line);
  border-radius:10px;padding:11px 14px;background:#fff}
#ta .ta-acc.on{border-color:var(--ok);background:var(--ok-bg)}
#ta .ta-acc b{font-size:14.5px;font-weight:700}
#ta .ta-acc .now{font-size:12px;font-weight:700;color:var(--ok)}
#ta .ta-acc .sp{margin-left:auto;display:flex;gap:6px}

#ta .ta-empty{text-align:center;color:var(--dim);font-size:14px;padding:34px 10px;line-height:1.8}
#ta .ta-spin{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.45);
  border-top-color:#fff;border-radius:50%;animation:taspin .7s linear infinite}
@keyframes taspin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){#ta .ta-spin{animation:none}}
</style>

<div id="ta">

  <div class="ta-tabs" role="tablist">
    <button class="ta-tab" role="tab" aria-selected="true"  data-panel="make">글 만들기</button>
    <button class="ta-tab" role="tab" aria-selected="false" data-panel="queue">내 원고 <span id="taCount"><%= posts.length %></span></button>
    <button class="ta-tab" role="tab" aria-selected="false" data-panel="setup">설정</button>
  </div>

  <!-- 지금 어느 계정으로 나가는지 늘 보이게 -->
  <div class="ta-who">
    <% if (accounts.length) { %>
      <span>올릴 계정</span>
      <select id="taWho">
        <% accounts.forEach(function(a){ %>
          <option value="<%= a.id %>" <%= (account && a.id === account.id) ? 'selected' : '' %>>@<%= a.username || a.accountId %></option>
        <% }) %>
      </select>
      <span class="sp"><%= allowPublish ? '올리기 켜짐' : '올리기 잠김 — 설정에서 켜세요' %></span>
    <% } else { %>
      <span class="none">올릴 계정이 아직 없습니다</span>
      <span class="sp">설정 탭에서 Zernio 열쇠를 넣으면 등록됩니다</span>
    <% } %>
  </div>

  <!-- ══════════ 글 만들기 ══════════ -->
  <section class="ta-panel" id="p-make">
    <% if (!hasKey) { %>
      <div class="ta-msg warn">글을 만들려면 OpenAI 키가 필요합니다. 「무료사주 · API 설정」에서 먼저 등록해주세요.
무료사주·PDF 가 쓰는 그 키를 그대로 씁니다. 여기서 따로 넣으실 것은 없습니다.</div>
    <% } %>

    <div class="ta-card">
      <h2>주제 하나만 적어주세요</h2>
      <p class="ta-sub">후킹 26가지를 전부 훑어보고, 쓸 만한 각도를 골라 글을 만듭니다.
        최근에 쓴 후킹은 뒤로 밀리니 같은 소재가 반복되지 않습니다.</p>
      <div class="ta-row">
        <div style="flex:2">
          <label for="taTopic">주제</label>
          <input type="text" id="taTopic" name="threadsTopic" placeholder="예: 역마살, 공망, 삼재, 궁합"
                 maxlength="120" autocomplete="off" autocapitalize="off" spellcheck="false"
                 data-lpignore="true" data-form-type="other" <%= hasKey ? '' : 'disabled' %>>
        </div>
        <div style="max-width:130px">
          <label for="taLimit">글 개수</label>
          <select id="taLimit">
            <option value="1">1개</option>
            <option value="2">2개</option>
            <option value="3" selected>3개</option>
            <option value="5">5개</option>
            <option value="8">8개</option>
          </select>
        </div>
        <div style="flex:0 0 auto">
          <button class="ta-btn" type="button" id="taGo" <%= hasKey ? '' : 'disabled' %>>만들기</button>
        </div>
      </div>
      <p class="ta-sub" style="margin:12px 0 0">
        1개 20초 · 3개 45초 · 8개 3분쯤 걸립니다. 오늘 <b id="taUsed"><%= usedToday %></b>/<%= dailyLimit %>번 썼습니다.
      </p>

      <div class="ta-pick">
        <div class="ta-pick-top">
          <b>뭘 쓸지 막히면</b>
          <button class="ta-btn ghost sm" type="button" id="taRoll">주제 뽑기</button>
          <button class="ta-btn ghost sm" type="button" id="taMore">다른 것 보기</button>
        </div>
        <div class="ta-chips" id="taChips"></div>
      </div>
    </div>

    <div id="taOut"></div>
  </section>

  <!-- ══════════ 내 원고 ══════════ -->
  <section class="ta-panel" id="p-queue" hidden>
    <div class="ta-nums">
      <div class="ta-num"><b><%= posts.length %></b><span>저장된 글</span></div>
      <div class="ta-num"><b><%= hookUsed %>/<%= hookTotal %></b><span>써본 후킹</span></div>
      <div class="ta-num"><b id="taTrash"><%= trashCount %></b><span>휴지통 묶음</span></div>
    </div>

    <div class="ta-card" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <button class="ta-btn ghost sm" type="button" id="taReload">새로고침</button>
      <button class="ta-btn ghost sm" type="button" id="taRestore" <%= trashCount ? '' : 'disabled' %>>방금 지운 것 되살리기</button>
      <span class="ta-sub" style="margin:0 0 0 auto">지운 글은 휴지통에 남습니다</span>
    </div>

    <div id="taList"></div>
  </section>

  <!-- ══════════ 설정 ══════════ -->
  <section class="ta-panel" id="p-setup" hidden>
    <div class="ta-card">
      <h2>글 만들기 — OpenAI 키</h2>
      <p class="ta-sub">「무료사주 · API 설정」에 등록해두신 <b>OpenAI 키를 그대로 씁니다.</b>
        따로 넣으실 것이 없습니다. 요금도 무료사주·PDF 와 같은 계정에서 나갑니다.</p>
      <% if (hasKey) { %>
        <div class="ta-msg ok">키가 등록되어 있습니다.</div>
        <button class="ta-btn ghost" type="button" id="taTestKey">연결 확인</button>
      <% } else { %>
        <div class="ta-msg err">아직 OpenAI 키가 없습니다.
「무료사주 · API 설정」에서 먼저 등록해주세요. 등록하면 여기서도 바로 쓰입니다.</div>
