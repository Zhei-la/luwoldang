<%- include('../partials/dash-top', { user: user, active: active, title: '문의 관리' }) %>

<style>
  .as-tabs { display:flex; gap:6px; margin-bottom:18px; flex-wrap:wrap; }
  .as-tabs a { padding:10px 16px; border:1px solid var(--beige); background:var(--card);
    border-radius:100px; font-size:14px; font-weight:600; color:#6B6656; text-decoration:none;
    display:flex; align-items:center; gap:7px; }
  .as-tabs a.on { background:var(--navy); border-color:var(--navy); color:#fff; }
  .as-tabs .n { font-size:11.5px; font-weight:700; opacity:.7; }
  .as-tabs .hot { background:#A8332B; border-color:#A8332B; color:#fff; }

  .as-item { background:var(--card); border:1px solid var(--beige); border-radius:14px;
    padding:16px 18px; margin-bottom:9px; }
  .as-item.open { border-left:3px solid var(--gold); }
  .as-item .h { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .as-kind { font-size:11.5px; font-weight:700; color:#8A6F3C; background:#F4EFE3;
    padding:2px 9px; border-radius:5px; }
  .as-item .ti { flex:1; min-width:0; font-size:15.5px; font-weight:700; }
  .as-st { font-size:11px; font-weight:700; padding:3px 10px; border-radius:100px; white-space:nowrap; }
  .as-st.wait { color:#fff; background:#C08A2E; }
  .as-st.done { color:#2E7D5B; background:#E8F3ED; }

  .as-who { margin-top:7px; font-size:12px; color:#9A9384; }
  .as-body { margin-top:10px; padding:13px 15px; background:#FBF8F1; border-radius:10px;
    font-size:14.5px; line-height:1.75; color:#4A4438; white-space:pre-wrap; word-break:keep-all; }

  .as-ans { margin-top:12px; }
  .as-ans textarea { width:100%; min-height:90px; padding:12px 14px; border:1px solid var(--beige);
    border-radius:10px; font-size:14.5px; font-family:inherit; line-height:1.7;
    background:var(--card); color:var(--ink); outline:none; resize:vertical; }
  .as-ans textarea:focus { border-color:var(--gold); }
  .as-acts { display:flex; gap:7px; margin-top:9px; flex-wrap:wrap; }
  .as-acts button { padding:10px 18px; border:1px solid var(--beige); background:var(--card);
    border-radius:9px; font-size:14px; font-weight:700; color:#4A4438;
    cursor:pointer; font-family:inherit; }
  .as-acts .go { background:var(--navy); border-color:var(--navy); color:#fff; }
  .as-acts .del { color:#A8332B; }

  .as-done { margin-top:12px; padding:13px 15px; background:#F3F7F4;
    border-left:3px solid #2E7D5B; border-radius:0 10px 10px 0; }
  .as-done .lb { font-size:11.5px; font-weight:700; color:#2E7D5B; margin-bottom:6px; }
  .as-done .tx { font-size:14.5px; line-height:1.8; white-space:pre-wrap; word-break:keep-all; }
  .as-done .dt { margin-top:8px; font-size:11.5px; color:#9A9384; }
  .as-redo { margin-top:9px; padding:7px 13px; border:1px solid var(--beige); background:var(--card);
    border-radius:8px; font-size:12.5px; color:#6B6656; cursor:pointer; font-family:inherit; }

  .as-empty { text-align:center; padding:56px 20px; color:#9A9384; font-size:14px; line-height:1.9; }
</style>

<div class="as-tabs">
  <a href="/admin/support" class="<%= only !== 'open' ? 'on' : '' %>">
    전체 <span class="n"><%= count.all_n %></span>
  </a>
  <a href="/admin/support?only=open" class="<%= only === 'open' ? 'on' : (count.open ? 'hot' : '') %>">
    답변 필요 <span class="n"><%= count.open %></span>
  </a>
</div>

<% if (!items.length) { %>
  <div class="as-empty">
    <%= only === 'open' ? '답변할 문의가 없습니다. 모두 처리되었습니다.' : '아직 들어온 문의가 없습니다.' %>
  </div>
<% } else { %>
  <% items.forEach(function (it) { %>
    <div class="as-item <%= it.answered_at ? '' : 'open' %>" data-id="<%= it.id %>">
      <div class="h">
        <span class="as-kind"><%= it.kind %></span>
        <span class="ti"><%= it.title %></span>
        <span class="as-st <%= it.answered_at ? 'done' : 'wait' %>">
          <%= it.answered_at ? '답변 완료' : '답변 필요' %>
        </span>
      </div>
      <div class="as-who">
        <%= it.who %> · <%= it.email %> · <%= new Date(it.created_at).toLocaleString('ko-KR') %>
      </div>
      <div class="as-body"><%= it.body %></div>

      <% if (it.answered_at) { %>
        <div class="as-done">
          <div class="lb">내 답변</div>
          <div class="tx"><%= it.answer %></div>
          <div class="dt"><%= new Date(it.answered_at).toLocaleString('ko-KR') %></div>
        </div>
        <button type="button" class="as-redo">답변 고치기</button>
      <% } %>

      <div class="as-ans" <%= it.answered_at ? 'style="display:none"' : '' %>>
        <textarea placeholder="답변을 적어주세요. 저장하면 문의하신 분께 알림이 갑니다."><%= it.answer || '' %></textarea>
        <div class="as-acts">
          <button type="button" class="go">답변 보내기</button>
          <button type="button" class="del">문의 삭제</button>
        </div>
      </div>
    </div>
  <% }); %>
<% } %>

<script>
document.addEventListener('click', function (e) {
  var item = e.target.closest('.as-item');
  if (!item) return;

  /* 답변 고치기 — 입력칸을 다시 연다 */
  if (e.target.closest('.as-redo')) {
    item.querySelector('.as-ans').style.display = 'block';
    item.querySelector('.as-redo').style.display = 'none';
    item.querySelector('textarea').focus();
    return;
  }

  /* 답변 보내기 */
  var go = e.target.closest('.as-ans .go');
  if (go) {
    var ta = item.querySelector('textarea');
    var txt = ta.value.trim();
    if (!txt) { alert('답변을 적어주세요.'); return; }
    go.disabled = true; go.textContent = '보내는 중...';
    fetch('/admin/support/answer', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: item.dataset.id, answer: txt })
    })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (!d.ok) throw new Error(d.error || '실패');
      location.reload();
    })
    .catch(function (err) {
      alert('보내지 못했습니다: ' + err.message);
      go.disabled = false; go.textContent = '답변 보내기';
    });
    return;
  }

  /* 문의 삭제 */
  if (e.target.closest('.as-ans .del')) {
    if (!confirm('이 문의를 지울까요? 되돌릴 수 없습니다.')) return;
    fetch('/admin/support/delete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: item.dataset.id })
    }).then(function (r) { return r.json(); })
      .then(function () { item.remove(); });
  }
});
</script>

<%- include('../partials/dash-bottom') %>
