<%- include('../partials/dash-top', { user: user, active: active, title: post.id ? '자료 고치기' : '새 자료 쓰기' }) %>

<style>
  .ge-wrap { max-width:900px; }

  .ge-row { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:14px; }
  .ge-fld { flex:1; min-width:200px; }
  .ge-fld label { display:block; font-size:11.5px; letter-spacing:.1em; color:#9A9384; margin-bottom:5px; }
  .ge-fld input[type=text], .ge-fld select {
    width:100%; padding:12px 13px; border:1px solid var(--beige); border-radius:10px;
    font-size:16px; font-family:inherit; background:var(--card); color:var(--ink); outline:none; }
  .ge-fld input:focus, .ge-fld select:focus { border-color:var(--gold); }

  /* 도구 막대 — 화면을 내려도 따라온다 */
  .ge-bar { position:sticky; top:0; z-index:30; background:var(--bg);
    padding:8px 0; border-bottom:1px solid var(--beige); }
  /* 옆으로 스크롤하면 끝에 있는 버튼이 안 보인다. 줄을 바꿔 전부 보이게 한다. */
  .ge-bar-in { display:flex; gap:5px; flex-wrap:wrap; row-gap:5px; }
  .ge-bar button { flex:0 0 auto; min-height:38px; padding:0 12px; border:1px solid var(--beige);
    background:var(--card); border-radius:9px; font-size:13.5px; font-weight:600; color:#4A4438;
    cursor:pointer; font-family:inherit; white-space:nowrap; }
  .ge-bar button:hover { border-color:var(--gold); color:#8A6F3C; }
  .ge-bar button.photo { background:var(--navy); border-color:var(--navy); color:#fff; }
  .ge-bar button.save2 { background:var(--gold); border-color:var(--gold); color:#fff; font-weight:800; }
  .ge-bar .listlink { flex:0 0 auto; display:inline-flex; align-items:center; min-height:38px;
    padding:0 12px; border:1px solid var(--beige); background:var(--card); border-radius:9px;
    font-size:13.5px; font-weight:600; color:#4A4438; text-decoration:none; white-space:nowrap; }
  .ge-bar .listlink:hover { border-color:var(--gold); color:#8A6F3C; }
  .ge-bar .sep { flex:0 0 auto; width:1px; background:var(--beige); margin:4px 3px; align-self:stretch; }

  /* 글 쓰는 곳 — 실제 보이는 모습 그대로 */
  #geBody { position:relative; min-height:480px; padding:26px 28px; border:1px solid var(--beige); border-top:0;
    border-radius:0 0 14px 14px; background:#fff; color:var(--ink);   /* 쓰는 곳도 흰 종이 */
    font-size:16px; line-height:1.85; outline:none; word-break:keep-all; }
  #geBody:focus { border-color:var(--gold); }
  #geBody:empty:before { content:attr(data-ph); color:#B8B1A0; }

  #geBody h2 { font-family:"Nanum Myeongjo",serif; font-size:21px; margin:30px 0 12px;
    padding-bottom:8px; border-bottom:1px solid var(--beige); }
  #geBody h3 { font-size:17.5px; margin:24px 0 10px; color:#8A6F3C; }
  #geBody p { margin:0 0 14px; }
  #geBody ul, #geBody ol { margin:0 0 14px; padding-left:24px; }
  #geBody li { margin-bottom:6px; }
  #geBody blockquote { margin:0 0 15px; padding:13px 16px; background:#FBF8F1;
    border-left:3px solid var(--gold); border-radius:0 8px 8px 0; }
  #geBody pre { background:#F4EFE3; border:1px solid var(--beige); border-radius:10px;
    padding:14px 16px; margin:0 0 15px; white-space:pre-wrap; word-break:break-all;
    font-family:inherit; font-size:14.5px; line-height:1.75; }
  #geBody hr { border:0; border-top:1px solid var(--beige); margin:26px 0; }
  #geBody img { max-width:100%; height:auto; display:block; border-radius:10px;
    border:1px solid var(--beige); margin:6px 0; }
  #geBody figure { margin:0 0 16px; position:relative; }
  #geBody figure.loading { min-height:60px; background:#F4EFE3; border-radius:10px; }
  #geBody figure.loading:after { content:'사진 가져오는 중...'; position:absolute; inset:0;
    display:flex; align-items:center; justify-content:center; font-size:13px; color:#8A6F3C; }
  /* 정렬 */
  #geBody .al-c { text-align:center; }
  #geBody .al-r { text-align:right; }
  #geBody .al-l { text-align:left; }
  #geBody figure.al-c img { margin-left:auto; margin-right:auto; }
  #geBody figure.al-r img { margin-left:auto; margin-right:0; }
  /* 사진 크기 — 세로로 긴 휴대폰 캡처가 화면을 다 차지하지 않도록 기본을 중간으로 둔다 */
  /* 사진 크기 — 화면 폭도 함께 따진다.
     px 만 쓰면 폰에서 화면 밖으로 넘쳐서 '중간'이 '크게'보다 커 보인다. */
  #geBody figure img { max-width:min(420px, 80%); }
  #geBody figure.sz-s img { max-width:min(240px, 55%); }
  #geBody figure.sz-m img { max-width:min(420px, 80%); }
  #geBody figure.sz-l img { max-width:100%; }
  /* 고른 사진 표시 */
  #geBody figure.sel img { outline:3px solid var(--gold); outline-offset:2px; }

  /* 사진을 누르면 뜨는 크기 조절 막대 */
  .imgbar { position:fixed; z-index:120; display:none; gap:4px; padding:5px;
    background:var(--navy); border-radius:10px; box-shadow:0 6px 18px rgba(24,34,52,.32); }
  .imgbar.on { display:flex; }
  .imgbar button { min-height:34px; padding:0 12px; border:0; border-radius:7px;
    background:rgba(255,255,255,.14); color:#fff; font-size:13px; font-weight:700;
    cursor:pointer; font-family:inherit; white-space:nowrap; }
  .imgbar button:hover { background:rgba(255,255,255,.28); }
  .imgbar button.on { background:var(--gold); }
  .imgbar button.del { background:rgba(200,90,80,.3); }
  .imgbar .bsep { width:1px; background:rgba(255,255,255,.22); margin:5px 2px; }
  #geBody a { color:#3B6EA5; }
    #geBody table { width:100%; border-collapse:collapse; margin:0 0 16px; font-size:14.5px; }
    #geBody th,   #geBody td { border:1px solid var(--beige); padding:9px 12px; text-align:left;
    word-break:keep-all; vertical-align:top; }
    #geBody th { background:#F4EFE3; font-weight:700; }

  .ge-opts { display:flex; gap:18px; flex-wrap:wrap; margin:16px 0; font-size:14.5px; color:#4A4438; }
  .ge-week { display:flex; align-items:center; gap:7px; font-weight:600; }
  .ge-week select { padding:7px 10px; border:1px solid var(--beige); border-radius:8px;
    font-size:13.5px; font-family:inherit; background:#fff; color:var(--ink); outline:none; }

  .ge-opts label { display:flex; align-items:center; gap:8px; cursor:pointer; }

  .ge-acts { display:flex; gap:8px; flex-wrap:wrap; }
  .ge-acts button, .ge-acts a { padding:14px 24px; border:1px solid var(--beige); background:var(--card);
    border-radius:11px; font-size:15px; font-weight:700; color:#4A4438; cursor:pointer;
    font-family:inherit; text-decoration:none; display:inline-block; }
  .ge-acts .save { background:var(--navy); border-color:var(--navy); color:#fff; }
  .ge-acts .del { color:#A8332B; }

  .ge-help { margin-top:24px; padding:16px 18px; background:#FBF8F1; border:1px solid var(--beige);
    border-radius:11px; font-size:13px; color:#6B6656; line-height:1.95; word-break:keep-all; }
  .ge-help b { color:#4A4438; }

  /* 연결할 자료 고르는 창 */
  .pick { display:none; position:fixed; inset:0; z-index:200; background:rgba(24,34,52,.4);
    align-items:center; justify-content:center; padding:20px; }
  .pick.on { display:flex; }
  .pick-in { background:var(--card); border-radius:16px; padding:20px; width:100%; max-width:460px;
    max-height:76vh; display:flex; flex-direction:column; }
  .pick-h { font-size:16px; font-weight:800; margin-bottom:12px; }
  .pick-in input { width:100%; padding:11px 13px; border:1px solid var(--beige); border-radius:10px;
    font-size:15px; font-family:inherit; outline:none; margin-bottom:10px; }
  .pick-list { flex:1; overflow-y:auto; margin-bottom:12px; }
  .pick-list button { display:block; width:100%; text-align:left; padding:12px 14px;
    border:1px solid var(--beige); background:var(--card); border-radius:10px; margin-bottom:6px;
    font-size:14.5px; font-family:inherit; color:var(--ink); cursor:pointer; }
  .pick-list button:hover { border-color:var(--gold); }
  .pick-list button span { display:block; font-size:11.5px; color:#9A9384; margin-top:3px; }
  .pick-list .none { padding:24px; text-align:center; color:#9A9384; font-size:13.5px; }
  #pickClose { padding:11px; border:1px solid var(--beige); background:#FBF8F1; border-radius:10px;
    font-size:14px; font-weight:700; color:#6B6656; cursor:pointer; font-family:inherit; }

  .toast { position:fixed; left:50%; bottom:40px; transform:translateX(-50%); background:var(--navy);
    color:#fff; padding:12px 20px; border-radius:100px; font-size:14px; font-weight:700; z-index:200; }

  @media (max-width:640px) {
    #geBody { padding:18px 16px; min-height:400px; font-size:15.5px; }
    .ge-bar button, .ge-bar .listlink { padding:0 10px; font-size:12.5px; min-height:36px; }
    .ge-bar .sep { display:none; }        /* 좁은 화면에서는 구분선을 빼 자리를 아낀다 */
    .ge-bar-in { gap:4px; row-gap:4px; }
  }
</style>

<div class="ge-wrap">
  <input type="hidden" id="gePostId" value="<%= post.id || '' %>">

  <div class="ge-row">
    <div class="ge-fld" style="flex:2">
      <label>제목</label>
      <input type="text" id="geTitle" value="<%= post.title %>" placeholder="예: 01. 스레드 글 작성하는 방법">
    </div>
    <div class="ge-fld" style="flex:1">
      <label>분류</label>
      <select id="geCat">
        <option value="">분류 없음</option>
        <% catList.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= post.cat_id === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>
  </div>

  <div class="ge-bar">
    <div class="ge-bar-in">
      <button type="button" class="save2" id="btnSaveTop">저장</button>
      <a class="listlink" href="/admin/guide">목록</a>
      <span class="sep"></span>
      <button type="button" class="photo" id="btnPhoto">📷 사진</button>
      <span class="sep"></span>
      <button type="button" data-cmd="formatBlock" data-val="h2">중제목</button>
      <button type="button" data-cmd="formatBlock" data-val="h3">소제목</button>
      <button type="button" data-cmd="formatBlock" data-val="p">본문</button>
      <span class="sep"></span>
      <button type="button" data-cmd="bold"><b>굵게</b></button>
      <button type="button" data-cmd="underline"><u>밑줄</u></button>
      <span class="sep"></span>
      <button type="button" data-cmd="insertUnorderedList">목록</button>
      <button type="button" data-cmd="insertOrderedList">번호</button>
      <button type="button" data-cmd="formatBlock" data-val="blockquote">인용</button>
      <span class="sep"></span>
      <button type="button" data-cmd="justifyLeft">왼쪽</button>
      <button type="button" data-cmd="justifyCenter">가운데</button>
      <button type="button" data-cmd="justifyRight">오른쪽</button>
      <button type="button" id="btnPre">복사상자</button>
      <button type="button" id="btnHr">가로줄</button>
      <span class="sep"></span>
      <button type="button" id="btnLink">링크</button>
      <button type="button" id="btnPostLink">자료 연결</button>
      <button type="button" id="btnClear">서식 지우기</button>
    </div>
  </div>

  <div id="geBody" contenteditable="true" data-ph="여기에 자료를 적어주세요. 캡처를 복사해서 그대로 붙여넣어도 사진이 올라갑니다."><%- editHtml %></div>
  <input type="file" id="geFile" accept="image/*" multiple hidden>

  <div class="pick" id="pickBox">
    <div class="pick-in">
      <div class="pick-h">연결할 자료 고르기</div>
      <input type="search" id="pickQ" placeholder="제목으로 찾기">
      <div class="pick-list" id="pickList"></div>
      <button type="button" id="pickClose">닫기</button>
    </div>
  </div>

  <div class="imgbar" id="imgBar">
    <button type="button" data-sz="sz-s">작게</button>
    <button type="button" data-sz="sz-m">중간</button>
    <button type="button" data-sz="sz-l">크게</button>
    <span class="bsep"></span>
    <button type="button" data-al="al-l">왼쪽</button>
    <button type="button" data-al="al-c">가운데</button>
    <span class="bsep"></span>
    <button type="button" class="del" data-sz="del">삭제</button>
  </div>

  <div class="ge-opts">
    <label class="ge-week">공개 시점
      <select id="geWeek">
        <% [1,2,3,4].forEach(function(i){ %>
          <option value="<%= i %>" <%= (post.week || 0) === i ? 'selected' : '' %>><%= i %>주차</option>
        <% }); %>
        <option value="5" <%= (post.week || 0) === 5 ? 'selected' : '' %>>총정리 (4주차 후)</option>
        <% if (!post.week) { %><option value="0" selected>아직 안 정함</option><% } %>
      </select>
    </label>
    <label><input type="checkbox" id="gePin" <%= post.pinned ? 'checked' : '' %>> 목록 맨 위에 고정</label>
    <label><input type="checkbox" id="gePub" <%= post.published !== false ? 'checked' : '' %>> 교육생에게 공개</label>
  </div>

  <div class="ge-acts">
    <button type="button" class="save" id="btnSave">저장</button>
    <a href="/admin/guide">취소</a>
    <% if (post.id) { %>
      <button type="button" class="del" id="btnDel">삭제</button>
    <% } %>
  </div>

  <div class="ge-help">
    <b>사진 넣기</b> — 사진을 넣고 싶은 자리를 클릭한 뒤 <b>📷 사진</b>을 누르세요. 여러 장을 한 번에 고를 수도 있습니다.<br>
    <b>더 빠른 방법</b> — 캡처를 복사한 뒤 글에 그대로 붙여넣으면 사진이 그 자리에 올라갑니다. 사진 파일을 끌어다 놓아도 됩니다.<br>
    <b>노션에서 가져오기</b> — 노션 글을 복사해 붙여넣으면 <b>글만 들어오고 사진은 빠집니다.</b> 노션이 사진을 주소가 아닌 내부 표시로만 넘기기 때문입니다. 사진까지 함께 옮기려면 <a href="/admin/guide/import" style="color:#8A6F3C;font-weight:700">노션에서 가져오기</a>를 이용해 주세요.<br>
    <b>자료 연결</b> — 다른 자료집 글로 이어지는 링크를 넣습니다. 순서대로 읽게 안내할 때 쓰세요.<br>
    <b>사진 넣기</b> — 캡처(Win+Shift+S)를 <b>Ctrl+V</b> 로 바로 붙여넣을 수 있습니다. 노션에서 사진을 옮기실 때는 사진 위에서 <b>오른쪽 클릭 → 이미지 복사</b> 후 붙여넣으세요.<br>
    <b>사진 크기</b> — 사진을 한 번 누르면 <b>작게 · 중간 · 크게</b>를 고를 수 있습니다. 휴대폰 캡처처럼 세로로 긴 사진은 자동으로 작게 들어갑니다.<br>
    <b>복사상자</b> — 교육생이 그대로 복사해 쓸 문구에 쓰세요. 회색 상자로 나옵니다.<br>
    <b>상자에서 빠져나오기</b> — 복사상자나 인용 안에서 <b>Shift + Enter</b> 를 누르면 상자 아래에 새 줄이 생깁니다.<br>
    <b>서식 끄기</b> — 중제목·소제목·인용·복사상자·목록은 <b>한 번 더 누르면</b> 원래 글로 돌아갑니다.<br>
    <b>저장하지 않고 나가면</b> 쓰던 글이 사라집니다. 중간중간 저장해 주세요.
  </div>
</div>

<script>
(function () {
  var ed = document.getElementById('geBody');
  var file = document.getElementById('geFile');
  var postId = document.getElementById('gePostId');
  var dirty = false;

  function toast(m) {
    var e = document.createElement('div');
    e.className = 'toast'; e.textContent = m;
    document.body.appendChild(e);
    setTimeout(function () { e.remove(); }, 1800);
  }

  ed.addEventListener('input', function () { dirty = true; });

  /* 저장된 글을 다시 열면 정렬이 class 로 들어 있다.
     브라우저 정렬 기능이 알아보도록 style 도 함께 붙여준다. */
  (function restoreAlign() {
    ed.querySelectorAll('.al-c, .al-r, .al-l').forEach(function (el) {
      if (el.tagName === 'FIGURE') return;                 // 사진은 CSS 로 처리한다
      el.style.textAlign = el.classList.contains('al-c') ? 'center'
                         : el.classList.contains('al-r') ? 'right' : 'left';
    });
  })();

  /* 도구 버튼 */
  /* 커서가 지금 어떤 덩어리(문단·제목·인용·복사상자) 안에 있는지.
     인용은 안쪽에 문단이 또 들어있어서, 문단을 찾았더라도
     그 바깥이 인용·복사상자면 그쪽을 돌려준다. */
  function curBlock() {
    var sel = window.getSelection();
    if (!sel.rangeCount) return null;
    var n = sel.anchorNode;
    if (n && n.nodeType === 3) n = n.parentNode;
    while (n && n !== ed && !/^(P|H2|H3|H4|BLOCKQUOTE|PRE|LI)$/.test(n.tagName || '')) n = n.parentNode;
    if (!n || n === ed) return null;

    var wrap = n.parentNode;
    while (wrap && wrap !== ed) {
      if (/^(BLOCKQUOTE|PRE)$/.test(wrap.tagName || '')) return wrap;
      wrap = wrap.parentNode;
    }
    return n;
  }

  /* 덩어리 바로 아래에 새 문단을 만들고 커서를 옮긴다 */
  function newLineAfter(block) {
    var p = document.createElement('p');
    p.innerHTML = '<br>';
    block.parentNode.insertBefore(p, block.nextSibling);
    var r = document.createRange();
    r.setStart(p, 0); r.collapse(true);
    var s = window.getSelection();
    s.removeAllRanges(); s.addRange(r);
    ed.focus();
    dirty = true;
  }

  document.querySelectorAll('.ge-bar button[data-cmd]').forEach(function (b) {
    b.addEventListener('mousedown', function (e) { e.preventDefault(); });   // 커서를 잃지 않게
    b.addEventListener('click', function () {
      ed.focus();
      var cmd = b.dataset.cmd, val = b.dataset.val;
      if (cmd === 'formatBlock' && val) {
        /* 이미 그 모양이면 한 번 더 눌러 본문으로 되돌린다 */
        var cur = curBlock();
        if (cur && cur.tagName === val.toUpperCase()) val = 'p';
        document.execCommand('formatBlock', false, '<' + val + '>');
      } else {
        /* 목록·번호는 브라우저가 알아서 켜고 끈다 */
        document.execCommand(cmd, false, null);
      }
      dirty = true;
    });
  });

  /* 복사상자·인용 안에서 Shift+Enter 를 누르면 상자 밖으로 빠져나온다.
     그러지 않으면 상자에서 나올 방법이 없다. */
  ed.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' || !e.shiftKey) return;
    var b = curBlock();
    if (!b || !/^(PRE|BLOCKQUOTE)$/.test(b.tagName)) return;
    e.preventDefault();
    newLineAfter(b);
  });

  /* 커서 자리에 넣기 */
  function insertNode(node) {
    ed.focus();
    var sel = window.getSelection();
    if (!sel.rangeCount || !ed.contains(sel.anchorNode)) {
      ed.appendChild(node);
    } else {
      var r = sel.getRangeAt(0);
      r.deleteContents();
      r.insertNode(node);
    }
    /* 사진 뒤에 이어서 쓸 수 있게 빈 줄 하나 */
    var p = document.createElement('p');
    p.innerHTML = '<br>';
    if (node.parentNode) node.parentNode.insertBefore(p, node.nextSibling);
    var r2 = document.createRange();
    r2.setStart(p, 0); r2.collapse(true);
    var s2 = window.getSelection();
    s2.removeAllRanges(); s2.addRange(r2);
    dirty = true;
  }

  document.getElementById('btnPre').addEventListener('click', function () {
    ed.focus();
    var cur = curBlock();
    /* 이미 복사상자면 한 번 더 눌러 해제한다 */
    document.execCommand('formatBlock', false, cur && cur.tagName === 'PRE' ? '<p>' : '<pre>');
    dirty = true;
  });
  document.getElementById('btnHr').addEventListener('click', function () {
    ed.focus(); document.execCommand('insertHorizontalRule'); dirty = true;
  });
  document.getElementById('btnClear').addEventListener('click', function () {
    ed.focus();
    document.execCommand('removeFormat');
    document.execCommand('formatBlock', false, '<p>');
    dirty = true;
  });
  /* 글자를 고르지 않고 눌러도 되게 — 고른 글자가 없으면 주소를 그대로 넣는다 */
  function putLink(url, text) {
    ed.focus();
    var sel = window.getSelection();
    var has = sel.rangeCount && !sel.getRangeAt(0).collapsed && ed.contains(sel.anchorNode);
    if (has) {
      document.execCommand('createLink', false, url);
    } else {
      var a = document.createElement('a');
      a.href = url;
      a.textContent = text || url;
      insertNode(a);
    }
    dirty = true;
  }

  document.getElementById('btnLink').addEventListener('click', function () {
    var url = prompt('링크 주소 (https:// 로 시작)');
    if (!url) return;
    url = url.trim();
    if (!/^https?:\/\//i.test(url)) { alert('https:// 로 시작하는 주소만 넣을 수 있습니다.'); return; }
    putLink(url);
  });

  /* ── 다른 자료로 연결 ── */
  var pick = document.getElementById('pickBox');
  var pickList = document.getElementById('pickList');
  var pickQ = document.getElementById('pickQ');
  var allPosts = null;
  var savedRange = null;

  function drawPicks() {
    var q = (pickQ.value || '').trim().toLowerCase();
    var list = (allPosts || []).filter(function (p) {
      return String(p.id) !== String(postId.value) &&
             (!q || p.title.toLowerCase().indexOf(q) > -1);
    });
    if (!list.length) {
      pickList.innerHTML = '<div class="none">' +
        (allPosts && allPosts.length ? '찾는 자료가 없습니다.' : '아직 다른 자료가 없습니다.') + '</div>';
      return;
    }
    pickList.innerHTML = list.map(function (p) {
      return '<button type="button" data-id="' + p.id + '" data-t="' + esc(p.title) + '">' +
        esc(p.title) + (p.cat_name ? '<span>' + esc(p.cat_name) + '</span>' : '') + '</button>';
    }).join('');
  }
  function esc(t) {
    return String(t).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }

  document.getElementById('btnPostLink').addEventListener('click', function () {
    /* 창을 열면 커서 자리를 잃으므로 기억해 둔다 */
    var sel = window.getSelection();
    savedRange = (sel.rangeCount && ed.contains(sel.anchorNode)) ? sel.getRangeAt(0).cloneRange() : null;

    pick.classList.add('on');
    pickQ.value = '';
    pickList.innerHTML = '<div class="none">불러오는 중...</div>';
    fetch('/admin/guide/list')
      .then(function (r) { return r.json(); })
      .then(function (d) { allPosts = d.posts || []; drawPicks(); })
      .catch(function () { pickList.innerHTML = '<div class="none">목록을 불러오지 못했습니다.</div>'; });
  });

  pickQ.addEventListener('input', drawPicks);
  document.getElementById('pickClose').addEventListener('click', function () { pick.classList.remove('on'); });
  pick.addEventListener('click', function (e) { if (e.target === pick) pick.classList.remove('on'); });

  pickList.addEventListener('click', function (e) {
    var b = e.target.closest('button[data-id]');
    if (!b) return;
    pick.classList.remove('on');
    /* 기억해 둔 커서 자리로 돌아간다 */
    if (savedRange) {
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(savedRange);
    }
    putLink('/guide/' + b.dataset.id, b.dataset.t);
  });

  /* 사진 올리기 */
  function uploadFile(f) {
    return new Promise(function (resolve, reject) {
      if (!/^image\//.test(f.type)) return reject(new Error('이미지 파일만 넣을 수 있습니다.'));
      if (f.size > 3 * 1024 * 1024) return reject(new Error('사진이 너무 큽니다. 3MB 이하로 올려주세요.'));
      var fr = new FileReader();
      fr.onerror = function () { reject(new Error('사진을 읽지 못했습니다.')); };
      fr.onload = function () {
        fetch('/admin/guide/img', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ img: fr.result, post_id: postId.value || null })
        })
        .then(function (r) { return r.json(); })
        .then(function (d) { d.ok ? resolve(d.url) : reject(new Error(d.error || '올리기 실패')); })
        .catch(reject);
      };
      fr.readAsDataURL(f);
    });
  }

  function putImage(url) {
    var fig = document.createElement('figure');
    var img = document.createElement('img');
    img.src = url;
    /* 세로로 긴 휴대폰 캡처는 작게, 가로로 넓은 화면 캡처는 중간으로 시작한다 */
    img.addEventListener('load', function () {
      if (!fig.className) fig.className = (img.naturalHeight > img.naturalWidth * 1.2) ? 'sz-s' : 'sz-m';
    });
    fig.className = 'sz-m';
    fig.appendChild(img);
    insertNode(fig);
  }

  function addFiles(list) {
    var files = [].slice.call(list).filter(function (f) { return f && /^image\//.test(f.type); });
    if (!files.length) return Promise.resolve();
    toast(files.length > 1 ? '사진 ' + files.length + '장 올리는 중...' : '사진 올리는 중...');
    return files.reduce(function (chain, f) {
      return chain.then(function () {
        return uploadFile(f).then(putImage).catch(function (e) { alert('사진 올리기 실패: ' + e.message); });
      });
    }, Promise.resolve()).then(function () { toast('사진을 넣었습니다'); });
  }

  document.getElementById('btnPhoto').addEventListener('click', function () { file.click(); });
  file.addEventListener('change', function () { addFiles(file.files); file.value = ''; });

  /* 끌어다 놓기 */
  ed.addEventListener('dragover', function (e) { e.preventDefault(); });
  ed.addEventListener('drop', function (e) {
    if (!e.dataTransfer || !e.dataTransfer.files.length) return;
    e.preventDefault();
    addFiles(e.dataTransfer.files);
  });

  /* 붙여넣기 — 캡처는 바로 올리고, 노션 글은 필요한 서식만 남긴다 */
  var BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
  var seen = [], skipped = [];

  var KEEP = { H1:'H2', H2:'H2', H3:'H3', H4:'H3', P:1, BR:1, STRONG:1, B:'STRONG', EM:1, I:'EM',
               U:1, S:1, STRIKE:'S', UL:1, OL:1, LI:1, BLOCKQUOTE:1, PRE:1, CODE:1, HR:1, A:1, DIV:'P' };

  function clean(node) {
    var out = document.createDocumentFragment();
    [].slice.call(node.childNodes).forEach(function (c) {
      if (c.nodeType === 3) { out.appendChild(document.createTextNode(c.nodeValue)); return; }
      if (c.nodeType !== 1) return;
      var tag = c.tagName;
      if (tag === 'SCRIPT' || tag === 'STYLE') return;

      /* 바깥 사진은 브라우저가 직접 읽을 수 없다.
         자리만 만들어 두고, 붙여넣은 뒤 서버가 대신 받아온다.
         노션이 주소를 여러 형태로 주기 때문에 넓게 받는다. */
      if (tag === 'IMG') {
        var src = (c.getAttribute('src') || c.getAttribute('data-src') || '').trim();
        seen.push(src.slice(0, 60));

        if (/^data:image\//i.test(src)) {
          /* 사진이 통째로 들어온 경우 — 그대로 올린다 */
          var fg = document.createElement('figure');
          fg.className = 'sz-m loading';
          var i2 = document.createElement('img');
          i2.setAttribute('data-inline', src);
          i2.src = BLANK;
          fg.appendChild(i2);
          out.appendChild(fg);
          return;
        }

        var abs = src;
        if (/^\/\//.test(src)) abs = 'https:' + src;             // //host/path
        else if (/^\//.test(src)) abs = 'https://www.notion.so' + src;  // /image/... 형태
        if (!/^https?:\/\//i.test(abs)) { skipped.push(src.slice(0, 40)); return; }

        var fig = document.createElement('figure');
        fig.className = 'sz-m loading';
        var im = document.createElement('img');
        im.setAttribute('data-remote', abs);
        im.src = BLANK;
        fig.appendChild(im);
        out.appendChild(fig);
        return;
      }
      var keep = KEEP[tag];
      if (!keep) { out.appendChild(clean(c)); return; }   // 껍데기만 버리고 속은 살린다
      var el = document.createElement(typeof keep === 'string' ? keep : tag);
      if (tag === 'A' && /^https?:\/\//i.test(c.getAttribute('href') || '')) {
        el.setAttribute('href', c.getAttribute('href'));
      }
      el.appendChild(clean(c));
      out.appendChild(el);
    });
    return out;
  }

  ed.addEventListener('paste', function (e) {
    var dt = e.clipboardData;
    if (!dt) return;

    /* 사진 파일이 들어온 경우 — 캡처(Win+Shift+S), 이미지 복사 등 */
    var imgs = [].slice.call(dt.items || [])
      .filter(function (it) { return it.kind === 'file' && /^image\//.test(it.type); })
      .map(function (it) { return it.getAsFile(); })
      .filter(Boolean);

    /* files 로만 들어오는 브라우저도 있다 */
    if (!imgs.length && dt.files && dt.files.length) {
      imgs = [].slice.call(dt.files).filter(function (f) { return /^image\//.test(f.type); });
    }

    var html = dt.getData('text/html');

    /* 사진만 있고 글이 없으면 사진으로 넣는다.
       글도 같이 있으면 아래 글 붙여넣기로 넘긴다 (사진은 거기서 따로 처리된다). */
    if (imgs.length && !(html && /<img|<p|<div|<h[1-6]/i.test(html))) {
      e.preventDefault(); addFiles(imgs); return;
    }
    if (imgs.length && !html) { e.preventDefault(); addFiles(imgs); return; }

    if (html) {
      e.preventDefault();
      seen = []; skipped = [];
      var box = document.createElement('div');
      box.innerHTML = html;
      var frag = clean(box);
      var last = frag.lastChild;
      var sel = window.getSelection();
      if (sel.rangeCount) {
        var r = sel.getRangeAt(0);
        r.deleteContents();
        r.insertNode(frag);
        if (last) { r.setStartAfter(last); r.collapse(true); sel.removeAllRanges(); sel.addRange(r); }
      }
      dirty = true;
      fetchRemote(true);

      /* 글과 함께 사진 파일도 들어왔다면 그것도 넣는다 */
      if (imgs.length && !/<img/i.test(html)) addFiles(imgs);
    } else if (imgs.length) {
      e.preventDefault();
      addFiles(imgs);
    }
  });

  /* 붙여넣은 바깥 사진을 서버가 대신 받아온다 */
  function fetchRemote(fromPaste) {
    /* 통째로 들어온 사진은 서버를 거치지 않고 바로 올린다 */
    var inline = [].slice.call(ed.querySelectorAll('img[data-inline]'));
    inline.forEach(function (im) {
      fetch('/admin/guide/img', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ img: im.getAttribute('data-inline'), post_id: postId.value || null })
      })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.ok) throw new Error(d.error || '실패');
        im.src = d.url;
        im.removeAttribute('data-inline');
        if (im.parentNode) im.parentNode.classList.remove('loading');
      })
      .catch(function () { var f = im.closest('figure'); if (f) f.remove(); });
    });

    var list = [].slice.call(ed.querySelectorAll('img[data-remote]'));
    if (!list.length) {
      if (fromPaste && !inline.length) {
        if (seen.length) {
          var isNotion = seen.some(function (x) { return /^attachment:/i.test(x); });
          if (isNotion) {
            /* 노션은 사진을 주소가 아닌 내부 꼬리표로만 넘긴다.
               붙여넣기로는 원리상 가져올 수 없으므로 가져오기 기능으로 안내한다. */
            if (confirm(
              '글은 들어왔지만 사진 ' + seen.length + '장은 들어오지 않았습니다.\n\n' +
              '노션은 복사할 때 사진을 주소가 아닌 내부 표시로만 넘겨서\n' +
              '붙여넣기로는 사진을 가져올 수 없습니다.\n\n' +
              '[노션에서 가져오기] 를 쓰면 글과 사진을 한 번에 옮길 수 있어요.\n' +
              '지금 그 화면으로 갈까요?\n\n' +
              '(쓰던 글은 저장되지 않습니다)'
            )) {
              dirty = false;
              location.href = '/admin/guide/import';
            }
          } else {
            alert('붙여넣은 글에 사진 ' + seen.length + '개가 있었지만 가져오지 못했습니다.\n\n' +
                  '사진 주소 형태:\n' + seen.slice(0, 3).join('\n') + '\n\n' +
                  '이 내용을 그대로 알려주시면 맞춰 드리겠습니다.');
          }
        } else {
          toast('사진 없이 글만 붙여넣었습니다');
        }
      }
      return;
    }
    toast('사진 ' + list.length + '장 가져오는 중...');

    var done = 0, failed = 0, reasons = [];
    list.reduce(function (chain, im) {
      return chain.then(function () {
        return fetch('/admin/guide/img/from-url', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: im.getAttribute('data-remote'), post_id: postId.value || null })
        })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.ok) throw new Error(d.error || '실패');
          im.src = d.url;
          im.removeAttribute('data-remote');
          if (im.parentNode) im.parentNode.classList.remove('loading');
          done++;
        })
        .catch(function (err) {
          failed++;
          if (reasons.indexOf(err.message) === -1) reasons.push(err.message);
          var f = im.closest('figure');
          if (f) f.remove(); else im.remove();
        });
      });
    }, Promise.resolve()).then(function () {
      dirty = true;
      if (failed) {
        alert('사진 ' + done + '장을 가져왔습니다.\n' +
              failed + '장은 가져오지 못해 빠졌습니다.\n\n' +
              '이유: ' + (reasons[0] || '알 수 없음') + '\n\n' +
              '노션 사진 주소는 5분 뒤 만료됩니다.\n' +
              '노션에서 다시 복사해 바로 붙여넣거나, 사진을 하나씩 복사해 넣어주세요.');
      } else {
        toast('사진 ' + done + '장을 넣었습니다');
      }
    });
  }

  /* ── 사진 크기 조절 ──
     사진을 누르면 위에 막대가 떠서 작게·중간·크게를 고를 수 있다.
     폰에서도 손가락으로 누르기만 하면 되도록 만들었다. */
  var bar = document.getElementById('imgBar');
  var picked = null;

  function hideBar() {
    bar.classList.remove('on');
    if (picked) picked.classList.remove('sel');
    picked = null;
  }

  function showBar(fig) {
    if (picked) picked.classList.remove('sel');
    picked = fig;
    fig.classList.add('sel');

    /* 지금 크기에 표시를 해둔다 */
    var cur = ['sz-s', 'sz-m', 'sz-l'].find(function (c) { return fig.classList.contains(c); }) || 'sz-m';
    bar.querySelectorAll('button[data-sz]').forEach(function (b) {
      b.classList.toggle('on', b.dataset.sz === cur);
    });
    var al = ['al-l', 'al-c', 'al-r'].find(function (c) { return fig.classList.contains(c); }) || 'al-l';
    bar.querySelectorAll('button[data-al]').forEach(function (b) {
      b.classList.toggle('on', b.dataset.al === al);
    });

    bar.classList.add('on');
    place();
  }

  /* 사진 바로 옆(위)에 붙인다. 화면 기준이라 어디에 있든 정확히 따라간다. */
  function place() {
    if (!picked || !bar.classList.contains('on')) return;
    var box = picked.getBoundingClientRect();
    var bw = bar.offsetWidth || 240;
    var bh = bar.offsetHeight || 44;

    /* 사진 위에 자리가 있으면 위, 없으면 사진 안쪽 위에 겹쳐 띄운다 */
    var top = box.top - bh - 8;
    if (top < 8) top = Math.min(box.top + 8, window.innerHeight - bh - 8);

    var left = box.left;
    if (left + bw > window.innerWidth - 8) left = window.innerWidth - bw - 8;
    if (left < 8) left = 8;

    bar.style.top = Math.round(top) + 'px';
    bar.style.left = Math.round(left) + 'px';
  }

  /* 화면을 움직이면 막대도 따라온다 */
  window.addEventListener('scroll', place, true);
  window.addEventListener('resize', place);

  ed.addEventListener('click', function (e) {
    var img = e.target.closest('img');
    var fig = img && img.closest('figure');
    if (fig && ed.contains(fig)) { showBar(fig); } else { hideBar(); }
  });

  bar.addEventListener('mousedown', function (e) { e.preventDefault(); });
  bar.addEventListener('click', function (e) {
    var b = e.target.closest('button[data-sz]');
    if (!b || !picked) return;

    if (b.dataset.sz === 'del') {
      if (confirm('이 사진을 지울까요?')) {
        var f = picked;
        hideBar();
        f.remove();
        dirty = true;
      }
      return;
    }
    picked.classList.remove('sz-s', 'sz-m', 'sz-l');
    picked.classList.add(b.dataset.sz);
    bar.querySelectorAll('button[data-sz]').forEach(function (x) {
      x.classList.toggle('on', x === b && x.dataset.sz !== 'del');
    });
    dirty = true;
    place();
  });

  /* 사진 정렬 */
  bar.addEventListener('click', function (e) {
    var b = e.target.closest('button[data-al]');
    if (!b || !picked) return;
    picked.classList.remove('al-l', 'al-c', 'al-r');
    picked.classList.add(b.dataset.al);
    bar.querySelectorAll('button[data-al]').forEach(function (x) {
      x.classList.toggle('on', x === b);
    });
    dirty = true;
    place();
  });

  /* 글을 쓰기 시작하거나 다른 곳을 누르면 막대를 감춘다 */
  ed.addEventListener('keydown', hideBar);
  document.addEventListener('click', function (e) {
    if (!ed.contains(e.target) && !bar.contains(e.target)) hideBar();
  });

  /* 저장할 때는 고른 표시를 빼고 넘긴다 */
  function cleanBody() {
    var tmp = document.createElement('div');
    tmp.innerHTML = ed.innerHTML;
    tmp.querySelectorAll('figure.sel').forEach(function (f) { f.classList.remove('sel'); });
    /* 아직 못 받아온 사진은 빈칸으로 남으므로 빼고 저장한다 */
    tmp.querySelectorAll('img[data-remote], img[data-inline]').forEach(function (im) {
      var f = im.closest('figure'); if (f) f.remove(); else im.remove();
    });
    tmp.querySelectorAll('figure.loading').forEach(function (f) { f.classList.remove('loading'); });

    /* 브라우저는 정렬을 style 로 넣는데, 저장할 때 style 은 걸러진다.
       그래서 class 로 바꿔 둔다. */
    tmp.querySelectorAll('[style]').forEach(function (el) {
      var a = (el.style.textAlign || '').toLowerCase();
      el.classList.remove('al-l', 'al-c', 'al-r');
      if (a === 'center') el.classList.add('al-c');
      else if (a === 'right') el.classList.add('al-r');
      else if (a === 'left') el.classList.add('al-l');
      el.removeAttribute('style');
      if (!el.getAttribute('class')) el.removeAttribute('class');
    });
    return tmp.innerHTML;
  }

  /* 저장 */
  function doSave() {
    var title = document.getElementById('geTitle').value.trim();
    if (!title) { alert('제목을 적어주세요.'); return; }
    fetch('/admin/guide/save', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: postId.value || null,
        cat_id: document.getElementById('geCat').value || null,
        title: title,
        body: cleanBody(),
        pinned: document.getElementById('gePin').checked,
        week: Number(document.getElementById('geWeek').value) || 0,
        published: document.getElementById('gePub').checked
      })
    })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (!d.ok) throw new Error(d.error || '실패');
      dirty = false;
      location.href = '/guide/' + d.id;
    })
    .catch(function (err) { alert('저장 실패: ' + err.message); });
  }
  document.getElementById('btnSave').addEventListener('click', doSave);
  document.getElementById('btnSaveTop').addEventListener('click', doSave);

  /* 삭제 */
  var del = document.getElementById('btnDel');
  if (del) del.addEventListener('click', function () {
    if (!confirm('이 자료를 지울까요? 되돌릴 수 없습니다.')) return;
    dirty = false;
    fetch('/admin/guide/delete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: postId.value })
    })
    .then(function (r) { return r.json(); })
    .then(function () { location.href = '/admin/guide'; });
  });

  /* 저장 안 하고 나가려 하면 알려준다 */
  window.addEventListener('beforeunload', function (e) {
    if (!dirty) return;
    e.preventDefault();
    e.returnValue = '';
  });
})();
</script>

