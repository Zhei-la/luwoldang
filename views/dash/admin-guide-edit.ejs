<%- include('../partials/dash-top', { user: user, active: active, title: post.id ? '자료 고치기' : '새 자료 쓰기' }) %>

<style>
  .ge-wrap { max-width:900px; }

  .ge-row { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:14px; }
  .ge-fld { flex:1; min-width:200px; }
  .ge-fld label { display:block; font-size:11.5px; letter-spacing:.1em; color:#9A9384; margin-bottom:5px; }
  .ge-fld input[type=text], .ge-fld select {
    width:100%; padding:12px 13px; border:1px solid var(--beige); border-radius:10px;
    font-size:16px; font-family:inherit; background:#fff; color:var(--ink); outline:none; }
  .ge-fld input:focus, .ge-fld select:focus { border-color:var(--gold); }

  /* 도구 막대 — 화면을 내려도 따라온다 */
  .ge-bar { position:sticky; top:0; z-index:30; background:var(--bg);
    padding:8px 0; border-bottom:1px solid var(--beige); }
  .ge-bar-in { display:flex; gap:5px; overflow-x:auto; scrollbar-width:none; padding-bottom:2px; }
  .ge-bar-in::-webkit-scrollbar { display:none; }
  .ge-bar button { flex:0 0 auto; min-height:38px; padding:0 12px; border:1px solid var(--beige);
    background:#fff; border-radius:9px; font-size:13.5px; font-weight:600; color:#4A4438;
    cursor:pointer; font-family:inherit; white-space:nowrap; }
  .ge-bar button:hover { border-color:var(--gold); color:#8A6F3C; }
  .ge-bar button.photo { background:var(--navy); border-color:var(--navy); color:#fff; }
  .ge-bar .sep { flex:0 0 auto; width:1px; background:var(--beige); margin:4px 3px; }

  /* 글 쓰는 곳 — 실제 보이는 모습 그대로 */
  #geBody { min-height:480px; padding:26px 28px; border:1px solid var(--beige); border-top:0;
    border-radius:0 0 14px 14px; background:#fff; color:var(--ink);
    font-size:16px; line-height:1.85; outline:none; word-break:keep-all; }
  #geBody:focus { border-color:var(--gold); }
  #geBody:empty:before { content:attr(data-ph); color:#B8B1A0; }

  #geBody h2 { font-family:"Nanum Myeongjo",serif; font-size:21px; margin:30px 0 12px;
    padding-bottom:8px; border-bottom:1px solid var(--beige); }
  #geBody h3 { font-size:17.5px; margin:24px 0 10px; color:#8A6F3C; }
  #geBody p { margin:0 0 14px; }
  #geBody ul, #geBody ol { margin:0 0 14px; padding-left:24px; }
  #geBody li { margin-bottom:6px; }
  #geBody blockquote { margin:0 0 15px; padding:13px 16px; background:#FBF8F1;
    border-left:3px solid var(--gold); border-radius:0 8px 8px 0; }
  #geBody pre { background:#F4EFE3; border:1px solid var(--beige); border-radius:10px;
    padding:14px 16px; margin:0 0 15px; white-space:pre-wrap; word-break:break-all;
    font-family:inherit; font-size:14.5px; line-height:1.75; }
  #geBody hr { border:0; border-top:1px solid var(--beige); margin:26px 0; }
  #geBody img { max-width:100%; height:auto; display:block; border-radius:10px;
    border:1px solid var(--beige); margin:6px 0; }
  #geBody figure { margin:0 0 16px; }
  #geBody a { color:#3B6EA5; }

  .ge-opts { display:flex; gap:18px; flex-wrap:wrap; margin:16px 0; font-size:14.5px; color:#4A4438; }
  .ge-opts label { display:flex; align-items:center; gap:8px; cursor:pointer; }

  .ge-acts { display:flex; gap:8px; flex-wrap:wrap; }
  .ge-acts button, .ge-acts a { padding:14px 24px; border:1px solid var(--beige); background:#fff;
    border-radius:11px; font-size:15px; font-weight:700; color:#4A4438; cursor:pointer;
    font-family:inherit; text-decoration:none; display:inline-block; }
  .ge-acts .save { background:var(--navy); border-color:var(--navy); color:#fff; }
  .ge-acts .del { color:#A8332B; }

  .ge-help { margin-top:24px; padding:16px 18px; background:#FBF8F1; border:1px solid var(--beige);
    border-radius:11px; font-size:13px; color:#6B6656; line-height:1.95; word-break:keep-all; }
  .ge-help b { color:#4A4438; }

  .toast { position:fixed; left:50%; bottom:40px; transform:translateX(-50%); background:var(--navy);
    color:#fff; padding:12px 20px; border-radius:100px; font-size:14px; font-weight:700; z-index:200; }

  @media (max-width:640px) {
    #geBody { padding:18px 16px; min-height:400px; font-size:15.5px; }
    .ge-bar button { padding:0 10px; font-size:13px; }
  }
</style>

<div class="ge-wrap">
  <input type="hidden" id="gePostId" value="<%= post.id || '' %>">

  <div class="ge-row">
    <div class="ge-fld" style="flex:2">
      <label>제목</label>
      <input type="text" id="geTitle" value="<%= post.title %>" placeholder="예: 01. 스레드 글 작성하는 방법">
    </div>
    <div class="ge-fld" style="flex:1">
      <label>분류</label>
      <select id="geCat">
        <option value="">분류 없음</option>
        <% catList.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= post.cat_id === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>
  </div>

  <div class="ge-bar">
    <div class="ge-bar-in">
      <button type="button" class="photo" id="btnPhoto">📷 사진</button>
      <span class="sep"></span>
      <button type="button" data-cmd="formatBlock" data-val="h2">중제목</button>
      <button type="button" data-cmd="formatBlock" data-val="h3">소제목</button>
      <button type="button" data-cmd="formatBlock" data-val="p">본문</button>
      <span class="sep"></span>
      <button type="button" data-cmd="bold"><b>굵게</b></button>
      <button type="button" data-cmd="underline"><u>밑줄</u></button>
      <span class="sep"></span>
      <button type="button" data-cmd="insertUnorderedList">목록</button>
      <button type="button" data-cmd="insertOrderedList">번호</button>
      <button type="button" data-cmd="formatBlock" data-val="blockquote">인용</button>
      <button type="button" id="btnPre">복사상자</button>
      <button type="button" id="btnHr">가로줄</button>
      <span class="sep"></span>
      <button type="button" id="btnLink">링크</button>
      <button type="button" id="btnClear">서식 지우기</button>
    </div>
  </div>

  <div id="geBody" contenteditable="true" data-ph="여기에 자료를 적어주세요. 캡처를 복사해서 그대로 붙여넣어도 사진이 올라갑니다."><%- editHtml %></div>
  <input type="file" id="geFile" accept="image/*" multiple hidden>

  <div class="ge-opts">
    <label><input type="checkbox" id="gePin" <%= post.pinned ? 'checked' : '' %>> 목록 맨 위에 고정</label>
    <label><input type="checkbox" id="gePub" <%= post.published !== false ? 'checked' : '' %>> 교육생에게 공개</label>
  </div>

  <div class="ge-acts">
    <button type="button" class="save" id="btnSave">저장</button>
    <a href="/admin/guide">취소</a>
    <% if (post.id) { %>
      <button type="button" class="del" id="btnDel">삭제</button>
    <% } %>
  </div>

  <div class="ge-help">
    <b>사진 넣기</b> — 사진을 넣고 싶은 자리를 클릭한 뒤 <b>📷 사진</b>을 누르세요. 여러 장을 한 번에 고를 수도 있습니다.<br>
    <b>더 빠른 방법</b> — 캡처를 복사한 뒤 글에 그대로 붙여넣으면 사진이 그 자리에 올라갑니다. 사진 파일을 끌어다 놓아도 됩니다.<br>
    <b>노션에서 가져오기</b> — 노션 글을 복사해 붙여넣으면 제목·굵게·목록 같은 서식이 대부분 그대로 옵니다. 다만 사진은 따로 올려주세요.<br>
    <b>복사상자</b> — 교육생이 그대로 복사해 쓸 문구에 쓰세요. 회색 상자로 나옵니다.<br>
    <b>저장하지 않고 나가면</b> 쓰던 글이 사라집니다. 중간중간 저장해 주세요.
  </div>
</div>

<script>
(function () {
  var ed = document.getElementById('geBody');
  var file = document.getElementById('geFile');
  var postId = document.getElementById('gePostId');
  var dirty = false;

  function toast(m) {
    var e = document.createElement('div');
    e.className = 'toast'; e.textContent = m;
    document.body.appendChild(e);
    setTimeout(function () { e.remove(); }, 1800);
  }

  ed.addEventListener('input', function () { dirty = true; });

  /* 도구 버튼 */
  document.querySelectorAll('.ge-bar button[data-cmd]').forEach(function (b) {
    b.addEventListener('mousedown', function (e) { e.preventDefault(); });   // 커서를 잃지 않게
    b.addEventListener('click', function () {
      ed.focus();
      document.execCommand(b.dataset.cmd, false, b.dataset.val ? '<' + b.dataset.val + '>' : null);
      dirty = true;
    });
  });

  /* 커서 자리에 넣기 */
  function insertNode(node) {
    ed.focus();
    var sel = window.getSelection();
    if (!sel.rangeCount || !ed.contains(sel.anchorNode)) {
      ed.appendChild(node);
    } else {
      var r = sel.getRangeAt(0);
      r.deleteContents();
      r.insertNode(node);
    }
    /* 사진 뒤에 이어서 쓸 수 있게 빈 줄 하나 */
    var p = document.createElement('p');
    p.innerHTML = '<br>';
    if (node.parentNode) node.parentNode.insertBefore(p, node.nextSibling);
    var r2 = document.createRange();
    r2.setStart(p, 0); r2.collapse(true);
    var s2 = window.getSelection();
    s2.removeAllRanges(); s2.addRange(r2);
    dirty = true;
  }

  document.getElementById('btnPre').addEventListener('click', function () {
    ed.focus(); document.execCommand('formatBlock', false, '<pre>'); dirty = true;
  });
  document.getElementById('btnHr').addEventListener('click', function () {
    ed.focus(); document.execCommand('insertHorizontalRule'); dirty = true;
  });
  document.getElementById('btnClear').addEventListener('click', function () {
    ed.focus();
    document.execCommand('removeFormat');
    document.execCommand('formatBlock', false, '<p>');
    dirty = true;
  });
  document.getElementById('btnLink').addEventListener('click', function () {
    var url = prompt('링크 주소 (https:// 로 시작)');
    if (!url) return;
    if (!/^https?:\/\//i.test(url)) { alert('https:// 로 시작하는 주소만 넣을 수 있습니다.'); return; }
    ed.focus(); document.execCommand('createLink', false, url); dirty = true;
  });

  /* 사진 올리기 */
  function uploadFile(f) {
    return new Promise(function (resolve, reject) {
      if (!/^image\//.test(f.type)) return reject(new Error('이미지 파일만 넣을 수 있습니다.'));
      if (f.size > 3 * 1024 * 1024) return reject(new Error('사진이 너무 큽니다. 3MB 이하로 올려주세요.'));
      var fr = new FileReader();
      fr.onerror = function () { reject(new Error('사진을 읽지 못했습니다.')); };
      fr.onload = function () {
        fetch('/admin/guide/img', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ img: fr.result, post_id: postId.value || null })
        })
        .then(function (r) { return r.json(); })
        .then(function (d) { d.ok ? resolve(d.url) : reject(new Error(d.error || '올리기 실패')); })
        .catch(reject);
      };
      fr.readAsDataURL(f);
    });
  }

  function putImage(url) {
    var fig = document.createElement('figure');
    var img = document.createElement('img');
    img.src = url;
    fig.appendChild(img);
    insertNode(fig);
  }

  function addFiles(list) {
    var files = [].slice.call(list).filter(function (f) { return f && /^image\//.test(f.type); });
    if (!files.length) return Promise.resolve();
    toast(files.length > 1 ? '사진 ' + files.length + '장 올리는 중...' : '사진 올리는 중...');
    return files.reduce(function (chain, f) {
      return chain.then(function () {
        return uploadFile(f).then(putImage).catch(function (e) { alert('사진 올리기 실패: ' + e.message); });
      });
    }, Promise.resolve()).then(function () { toast('사진을 넣었습니다'); });
  }

  document.getElementById('btnPhoto').addEventListener('click', function () { file.click(); });
  file.addEventListener('change', function () { addFiles(file.files); file.value = ''; });

  /* 끌어다 놓기 */
  ed.addEventListener('dragover', function (e) { e.preventDefault(); });
  ed.addEventListener('drop', function (e) {
    if (!e.dataTransfer || !e.dataTransfer.files.length) return;
    e.preventDefault();
    addFiles(e.dataTransfer.files);
  });

  /* 붙여넣기 — 캡처는 바로 올리고, 노션 글은 필요한 서식만 남긴다 */
  var KEEP = { H1:'H2', H2:'H2', H3:'H3', H4:'H3', P:1, BR:1, STRONG:1, B:'STRONG', EM:1, I:'EM',
               U:1, S:1, STRIKE:'S', UL:1, OL:1, LI:1, BLOCKQUOTE:1, PRE:1, CODE:1, HR:1, A:1, DIV:'P' };

  function clean(node) {
    var out = document.createDocumentFragment();
    [].slice.call(node.childNodes).forEach(function (c) {
      if (c.nodeType === 3) { out.appendChild(document.createTextNode(c.nodeValue)); return; }
      if (c.nodeType !== 1) return;
      var tag = c.tagName;
      /* 바깥 사진은 주소가 만료되므로 가져오지 않는다 */
      if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'IMG') return;
      var keep = KEEP[tag];
      if (!keep) { out.appendChild(clean(c)); return; }   // 껍데기만 버리고 속은 살린다
      var el = document.createElement(typeof keep === 'string' ? keep : tag);
      if (tag === 'A' && /^https?:\/\//i.test(c.getAttribute('href') || '')) {
        el.setAttribute('href', c.getAttribute('href'));
      }
      el.appendChild(clean(c));
      out.appendChild(el);
    });
    return out;
  }

  ed.addEventListener('paste', function (e) {
    var dt = e.clipboardData;
    if (!dt) return;

    var imgs = [].slice.call(dt.items || [])
      .filter(function (it) { return /^image\//.test(it.type); })
      .map(function (it) { return it.getAsFile(); })
      .filter(Boolean);

    if (imgs.length) { e.preventDefault(); addFiles(imgs); return; }

    var html = dt.getData('text/html');
    if (html) {
      e.preventDefault();
      var box = document.createElement('div');
      box.innerHTML = html;
      var frag = clean(box);
      var last = frag.lastChild;
      var sel = window.getSelection();
      if (sel.rangeCount) {
        var r = sel.getRangeAt(0);
        r.deleteContents();
        r.insertNode(frag);
        if (last) { r.setStartAfter(last); r.collapse(true); sel.removeAllRanges(); sel.addRange(r); }
      }
      dirty = true;
    }
  });

  /* 저장 */
  document.getElementById('btnSave').addEventListener('click', function () {
    var title = document.getElementById('geTitle').value.trim();
    if (!title) { alert('제목을 적어주세요.'); return; }
    fetch('/admin/guide/save', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: postId.value || null,
        cat_id: document.getElementById('geCat').value || null,
        title: title,
        body: ed.innerHTML,
        pinned: document.getElementById('gePin').checked,
        published: document.getElementById('gePub').checked
      })
    })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (!d.ok) throw new Error(d.error || '실패');
      dirty = false;
      location.href = '/guide/' + d.id;
    })
    .catch(function (err) { alert('저장 실패: ' + err.message); });
  });

  /* 삭제 */
  var del = document.getElementById('btnDel');
  if (del) del.addEventListener('click', function () {
    if (!confirm('이 자료를 지울까요? 되돌릴 수 없습니다.')) return;
    dirty = false;
    fetch('/admin/guide/delete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: postId.value })
    })
    .then(function (r) { return r.json(); })
    .then(function () { location.href = '/admin/guide'; });
  });

  /* 저장 안 하고 나가려 하면 알려준다 */
  window.addEventListener('beforeunload', function (e) {
    if (!dirty) return;
    e.preventDefault();
    e.returnValue = '';
  });
})();
</script>

<%- include('../partials/dash-bottom') %>
