<%- include('../partials/dash-top', { user: user, active: active, title: '문의하기' }) %>

<style>
  .sp-note { background:#FBF8F1; border:1px solid var(--beige); border-left:3px solid var(--gold);
    border-radius:0 12px 12px 0; padding:14px 17px; margin-bottom:18px;
    font-size:14px; line-height:1.8; color:#4A4438; word-break:keep-all; }
  .sp-note b { color:var(--ink); }

  .sp-form { background:var(--card); border:1px solid var(--beige); border-radius:14px;
    padding:20px; margin-bottom:22px; }
  .sp-kinds { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px; }
  .sp-kinds button { padding:9px 15px; border:1px solid var(--beige); background:var(--card);
    border-radius:100px; font-size:13.5px; font-weight:600; color:#6B6656;
    cursor:pointer; font-family:inherit; }
  .sp-kinds button.on { background:var(--navy); border-color:var(--navy); color:#fff; }
  .sp-form input[type=text], .sp-form textarea {
    width:100%; padding:12px 14px; border:1px solid var(--beige); border-radius:10px;
    font-size:15px; font-family:inherit; background:var(--card); color:var(--ink); outline:none;
    margin-bottom:10px; line-height:1.7; }
  .sp-form input:focus, .sp-form textarea:focus { border-color:var(--gold); }
  .sp-form textarea { min-height:130px; resize:vertical; }
  .sp-form .send { padding:13px 24px; background:var(--navy); color:#fff; border:0;
    border-radius:11px; font-size:15px; font-weight:700; cursor:pointer; font-family:inherit; }
  .sp-form .send:disabled { opacity:.5; cursor:default; }

  .sp-item { background:var(--card); border:1px solid var(--beige); border-radius:14px;
    padding:16px 18px; margin-bottom:9px; }
  .sp-item .h { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .sp-kind { font-size:11.5px; font-weight:700; color:#8A6F3C; background:#F4EFE3;
    padding:2px 9px; border-radius:5px; }
  .sp-item .ti { flex:1; min-width:0; font-size:15.5px; font-weight:700; }
  .sp-st { font-size:11px; font-weight:700; padding:3px 10px; border-radius:100px; white-space:nowrap; }
  .sp-st.wait { color:#8A6F3C; background:#F4EFE3; }
  .sp-st.done { color:#2E7D5B; background:#E8F3ED; }
  .sp-item .bd { margin-top:9px; font-size:14.5px; line-height:1.75; color:#4A4438;
    white-space:pre-wrap; word-break:keep-all; }
  .sp-item .dt { margin-top:9px; font-size:11.5px; color:#9A9384; }

  .sp-ans { margin-top:13px; padding:14px 16px; background:#FBF8F1;
    border-left:3px solid var(--gold); border-radius:0 10px 10px 0; }
  .sp-ans .lb { font-size:11.5px; font-weight:700; color:#8A6F3C; letter-spacing:.05em; margin-bottom:6px; }
  .sp-ans .tx { font-size:14.5px; line-height:1.8; color:var(--ink); white-space:pre-wrap; word-break:keep-all; }
  .sp-ans .dt { margin-top:8px; font-size:11.5px; color:#9A9384; }

  .sp-del { margin-top:10px; padding:7px 13px; border:1px solid var(--beige); background:var(--card);
    border-radius:8px; font-size:12.5px; color:#A8332B; cursor:pointer; font-family:inherit; }
.sp-imgs { display:flex; flex-wrap:wrap; gap:7px; margin-top:10px; }
  .sp-imgs img { width:84px; height:104px; object-fit:cover; border-radius:9px;
    border:1px solid var(--beige); background:#fff; cursor:zoom-in; display:block; }

  .sp-pick { border:1px dashed var(--beige); border-radius:11px; background:#fff;
    padding:16px; text-align:center; cursor:pointer; margin-bottom:10px; }
  .sp-pick:hover, .sp-pick.over { border-color:var(--gold); }
  .sp-pick .t { font-size:13.5px; font-weight:700; color:#4A4438; }
  .sp-pick .d { font-size:12px; color:#9A9384; margin-top:4px; }
  .sp-pick .picked { display:flex; flex-wrap:wrap; gap:7px; justify-content:center; }
  .sp-pick .pw { position:relative; }
  .sp-pick .picked img { width:70px; height:88px; object-fit:cover; border-radius:8px;
    border:1px solid var(--beige); display:block; }
  .sp-pick .pw .x { position:absolute; top:-6px; right:-6px; width:20px; height:20px;
    border-radius:50%; border:0; background:#A8332B; color:#fff; font-size:13px;
    line-height:1; cursor:pointer; padding:0; font-family:inherit; }

  .lbox { display:none; position:fixed; inset:0; z-index:9000;
    background:rgba(20,16,10,.92); align-items:center; justify-content:center; padding:20px; }
  .lbox.on { display:flex; }
  .lbox img { max-width:100%; max-height:100%; border-radius:10px; }
  .lbox .hint { position:fixed; bottom:18px; left:50%; transform:translateX(-50%);
    font-size:12.5px; color:rgba(255,255,255,.6); }

  .sp-empty { text-align:center; padding:44px 20px; color:#9A9384; font-size:14px; line-height:1.9; }
  .sp-h { font-size:15px; font-weight:800; margin:26px 0 12px; }
</style>

<div class="sp-note">
  <b>추가했으면 하는 기능, 불편한 점, 오류 무엇이든 남겨주세요.</b>
  남기신 글은 <b>본인과 관리자만</b> 볼 수 있습니다. 다른 교육생에게는 보이지 않습니다.
  답변이 달리면 알림으로 알려드립니다.
</div>

<div class="sp-form">
  <div class="sp-kinds" id="spKinds">
    <% kinds.forEach(function (k, i) { %>
      <button type="button" class="<%= i === 0 ? 'on' : '' %>" data-k="<%= k %>"><%= k %></button>
    <% }); %>
  </div>
  <input type="text" id="spTitle" placeholder="제목 — 어떤 내용인지 한 줄로">
  <textarea id="spBody" placeholder="자세히 적어주시면 더 빨리 도와드릴 수 있어요.&#10;오류라면 어느 화면에서, 무엇을 눌렀을 때 그랬는지 적어주세요."></textarea>

  <div class="sp-pick" id="spPick">
    <div id="spPickIn">
      <div class="t">📷 화면 캡처 넣기</div>
      <div class="d">누르거나 끌어다 놓으세요 · 붙여넣기(Ctrl+V)도 됩니다 · 5장까지</div>
    </div>
  </div>
  <input type="file" id="spFile" accept="image/*" multiple hidden>
  <button type="button" class="send" id="spSend">문의 남기기</button>
</div>

<div class="sp-h">내가 남긴 문의 <%= items.length %>건</div>

<% if (!items.length) { %>
  <div class="sp-empty">아직 남기신 문의가 없습니다.</div>
<% } else { %>
  <% items.forEach(function (it) { %>
    <div class="sp-item" data-id="<%= it.id %>">
      <div class="h">
        <span class="sp-kind"><%= it.kind %></span>
        <span class="ti"><%= it.title %></span>
        <span class="sp-st <%= it.answered_at ? 'done' : 'wait' %>">
          <%= it.answered_at ? '답변 완료' : '답변 기다리는 중' %>
        </span>
      </div>
      <div class="bd"><%= it.body %></div>
      <% if (it.imgs && it.imgs.length) { %>
        <div class="sp-imgs">
          <% it.imgs.forEach(function (u) { %><img src="<%= u %>" alt="첨부 사진"><% }); %>
        </div>
      <% } %>
      <div class="dt"><%= new Date(it.created_at).toLocaleString('ko-KR') %></div>

      <% if (it.answer) { %>
        <div class="sp-ans">
          <div class="lb">답변</div>
          <div class="tx"><%= it.answer %></div>
          <div class="dt"><%= new Date(it.answered_at).toLocaleString('ko-KR') %></div>
        </div>
      <% } else { %>
        <button type="button" class="sp-del">지우기</button>
      <% } %>
    </div>
  <% }); %>
<% } %>

<script>
(function () {
  var kind = document.querySelector('#spKinds button').dataset.k;

  document.getElementById('spKinds').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-k]');
    if (!b) return;
    kind = b.dataset.k;
    [].forEach.call(this.querySelectorAll('button'), function (x) {
      x.classList.toggle('on', x === b);
    });
  });

  /* ── 캡처 넣기 ── */
  var pick = document.getElementById('spPick');
  var pickIn = document.getElementById('spPickIn');
  var fileEl = document.getElementById('spFile');
  var imgList = [];

  function drawPick() {
    if (!imgList.length) {
      pickIn.innerHTML = '<div class="t">📷 화면 캡처 넣기</div>' +
        '<div class="d">누르거나 끌어다 놓으세요 · 붙여넣기(Ctrl+V)도 됩니다 · 5장까지</div>';
      return;
    }
    pickIn.innerHTML = '<div class="picked">' + imgList.map(function (u, i) {
      return '<div class="pw"><img src="' + u + '" alt="">' +
             '<button type="button" class="x" data-i="' + i + '">×</button></div>';
    }).join('') + '</div><div class="d">사진 ' + imgList.length + '장 · 눌러서 더 넣기</div>';
  }

  function addFiles(files) {
    [].slice.call(files || []).forEach(function (f) {
      if (!f || !/^image\//.test(f.type)) return;
      if (imgList.length >= 5) { alert('사진은 5장까지 넣을 수 있어요.'); return; }
      if (f.size > 3 * 1024 * 1024) { alert('사진이 너무 큽니다. 3MB 이하로 올려주세요.'); return; }
      var fr = new FileReader();
      fr.onload = function () { imgList.push(fr.result); drawPick(); };
      fr.readAsDataURL(f);
    });
  }

  pick.addEventListener('click', function (e) {
    if (e.target.closest('.pw .x')) {
      e.stopPropagation();
      imgList.splice(Number(e.target.closest('.pw .x').dataset.i), 1);
      drawPick();
      return;
    }
    fileEl.click();
  });
  fileEl.addEventListener('change', function () { addFiles(fileEl.files); fileEl.value = ''; });
  pick.addEventListener('dragover', function (e) { e.preventDefault(); pick.classList.add('over'); });
  pick.addEventListener('dragleave', function () { pick.classList.remove('over'); });
  pick.addEventListener('drop', function (e) {
    e.preventDefault(); pick.classList.remove('over'); addFiles(e.dataTransfer.files);
  });
  document.addEventListener('paste', function (e) {
    var it = (e.clipboardData || {}).items || [];
    for (var i = 0; i < it.length; i++) {
      if (/^image\//.test(it[i].type)) { addFiles([it[i].getAsFile()]); break; }
    }
  });

  var send = document.getElementById('spSend');
  send.addEventListener('click', function () {
    var title = document.getElementById('spTitle').value.trim();
    var body = document.getElementById('spBody').value.trim();
    if (!title) { alert('제목을 적어주세요.'); return; }
    if (!body) { alert('내용을 적어주세요.'); return; }

    send.disabled = true; send.textContent = '보내는 중...';
    fetch('/support/write', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ kind: kind, title: title, body: body, imgs: imgList })
    })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (!d.ok) throw new Error(d.error || '실패');
      location.reload();
    })
    .catch(function (err) {
      alert('보내지 못했습니다: ' + err.message);
      send.disabled = false; send.textContent = '문의 남기기';
    });
  });

  /* 답변 전인 글만 지울 수 있다 */
  document.addEventListener('click', function (e) {
    var b = e.target.closest('.sp-del');
    if (!b) return;
    var item = b.closest('.sp-item');
    if (!confirm('이 문의를 지울까요?')) return;
    fetch('/support/delete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: item.dataset.id })
    }).then(function (r) { return r.json(); })
      .then(function () { item.remove(); });
  });

/* 사진을 누르면 크게 본다 */
(function () {
  var box = document.createElement('div');
  box.className = 'lbox';
  box.innerHTML = '<img alt=""><span class="hint">아무 곳이나 누르면 닫힙니다</span>';
  document.body.appendChild(box);
  document.addEventListener('click', function (e) {
    var im = e.target.closest('.sp-imgs img');
    if (im) { box.querySelector('img').src = im.src; box.classList.add('on'); return; }
    if (box.classList.contains('on')) { box.classList.remove('on'); box.querySelector('img').src = ''; }
  });
})();
})();
</script>

<%- include('../partials/dash-bottom') %>
