// ── 출생지역 검색 자동완성 (외부 지도 API 없이 서버가 내려주는 내장 regions.ts 데이터만 사용) ──
let REGIONS = [];
async function loadRegions() {
  try {
    const res = await fetch('/api/manse/regions');
    const data = await res.json();
    REGIONS = data.regions || [];
  } catch (err) {
    REGIONS = [];
  }
}
function formatCorrection(n) {
  return (n > 0 ? '+' : '') + n + '분';
}

// 개인 모드(prefix='')와 궁합 모드 본인/상대(prefix='p1_'/'p2_')가 공유하는 출생지역 검색/보정(분) 위젯.
// 계산에 쓰이는 값은 오직 보정(분) 칸뿐이다. 출생지역 칸은 표시·기록용이며, 목록에서 항목을
// 클릭하면 보정(분) 칸에 그 값을 자동으로 채워줄 뿐이다(그 뒤에도 보정(분) 칸은 자유롭게 고칠 수 있고,
// 그렇게 고친 값이 그대로 우선 적용된다). 지역 칸에 글자만 있고 보정(분)이 비어 있으면(=선택을 안 한 것으로
// 간주) 보정이 적용되지 않으므로, 착각을 막기 위해 노란 테두리와 안내 문구로 표시한다.
function wireBirthRegion(prefix) {
  const searchEl = document.getElementById(prefix + 'birthRegionSearch');
  const suggestEl = document.getElementById(prefix + 'birthRegionSuggest');
  const manualEl = document.getElementById(prefix + 'birthCorrectionManual');
  const warnEl = document.getElementById(prefix + 'birthRegionWarning');

  const closeSuggest = () => { suggestEl.innerHTML = ''; suggestEl.classList.remove('open'); };

  const updateWarning = () => {
    const needsSelection = searchEl.value.trim() !== '' && manualEl.value.trim() === '';
    searchEl.classList.toggle('warn', needsSelection);
    if (warnEl) warnEl.classList.toggle('show', needsSelection);
  };

  const selectRegion = (region) => {
    searchEl.value = region.name;
    manualEl.value = String(region.correctionMinutes);
    closeSuggest();
    updateWarning();
  };

  const renderSuggestions = (query) => {
    const q = query.trim();
    if (!q) { closeSuggest(); return; }
    const matches = REGIONS.filter(r => r.name.includes(q)).slice(0, 20);
    if (!matches.length) { closeSuggest(); return; }
    suggestEl.innerHTML = '';
    matches.forEach(r => {
      const row = document.createElement('div');
      row.className = 'region-suggest-row';
      row.textContent = `${r.name} (${formatCorrection(r.correctionMinutes)})`;
      row.addEventListener('mousedown', (e) => { e.preventDefault(); selectRegion(r); });
      suggestEl.appendChild(row);
    });
    suggestEl.classList.add('open');
  };

  searchEl.addEventListener('input', () => {
    renderSuggestions(searchEl.value);
    updateWarning();
  });
  searchEl.addEventListener('focus', () => { if (searchEl.value.trim()) renderSuggestions(searchEl.value); });
  searchEl.addEventListener('blur', () => setTimeout(closeSuggest, 150));

  manualEl.addEventListener('input', updateWarning);
}

// 저장/전송용: 계산에는 보정(분) 칸의 값만 쓰고, 지역명은 그 값과 함께 표시·기록용으로만 실어 보낸다.
// 보정(분)이 비어있거나 0이면(기본값) undefined를 돌려줘 보정 없음으로 처리된다.
function getBirthRegionData(prefix) {
  const searchEl = document.getElementById(prefix + 'birthRegionSearch');
  const manualEl = document.getElementById(prefix + 'birthCorrectionManual');
  const manualVal = manualEl.value.trim();
  if (manualVal === '' || Number.isNaN(Number(manualVal)) || Number(manualVal) === 0) {
    return { correctionMinutes: undefined, birthRegionLabel: undefined };
  }
  return { correctionMinutes: Math.round(Number(manualVal)), birthRegionLabel: searchEl.value.trim() || undefined };
}

// 저장된 사주 불러오기용: p.correctionMinutes/birthRegionLabel로 두 칸을 그대로 복원한다.
