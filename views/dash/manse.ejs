}

function wireTimeControls(prefix) {
  const timeEl = document.getElementById(prefix + 'time');
  const hourUnknownEl = document.getElementById(prefix + 'hourUnknown');
  const ganjiEl = document.getElementById(prefix + 'ganjiSelect');
  hourUnknownEl.addEventListener('change', () => {
    const checked = hourUnknownEl.checked;
    timeEl.disabled = checked;
    ganjiEl.disabled = checked;
    if (checked) { timeEl.value = ''; ganjiEl.value = '선택안함'; }
  });
  ganjiEl.addEventListener('change', () => {
    const active = ganjiEl.value !== '선택안함';
    timeEl.disabled = active;
    if (active) timeEl.value = '';
  });
  timeEl.addEventListener('input', () => {
    if (timeEl.value.trim() && ganjiEl.value !== '선택안함') ganjiEl.value = '선택안함';
  });
}
