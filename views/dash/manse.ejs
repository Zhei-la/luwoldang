#manse-app .result-tabs { display: flex; gap: 6px; margin-top: 24px; }
#manse-app .tab-btn { padding: 8px 16px; border: 1px solid #ccc; border-bottom: none; border-radius: 8px 8px 0 0; background: #e4e4e7; color: #444; font-size: 13px; cursor: pointer; }
#manse-app .tab-btn.active { background: #fff; color: #111; font-weight: 700; }
#manse-app .result-box, #manse-app .pdf-view { margin-top: 0; border-radius: 0 12px 12px 12px; }
#manse-app .pdf-view { display: none; }
#manse-app .pdf-card { background: #fff; color: #000; padding: 20px; border-radius: 0 12px 12px 12px; border: 1px solid #ccc; font-family: 'Malgun Gothic', sans-serif; margin-bottom: 16px; }
#manse-app .pdf-card:last-child { margin-bottom: 0; }
#manse-app .pdf-header { padding: 0 2px 12px; margin-bottom: 14px; border-bottom: 1px solid #e4e4e7; }
#manse-app .pdf-header-name { font-size: 19px; font-weight: 700; color: #000; }
#manse-app .pdf-header-info { font-size: 12px; color: #666; margin-top: 3px; }
#manse-app .pdf-card-a { background: #f0f6ff; }
#manse-app .pdf-card-a .pdf-header-name { color: #1d4ed8; }
#manse-app .pdf-card-a .pdf-header { border-bottom-color: #c9dcfb; }
#manse-app .pdf-card-b { background: #fff4f0; }
#manse-app .pdf-card-b .pdf-header-name { color: #c2410c; }
#manse-app .pdf-card-b .pdf-header { border-bottom-color: #f7d9cc; }
#manse-app .pdf-table { border-collapse: collapse; width: 100%; margin-bottom: 22px; font-size: 13px; border: 1.5px solid #333; font-family: 'Malgun Gothic', sans-serif; }
#manse-app .pdf-table caption { caption-side: top; text-align: left; font-weight: 700; font-size: 14px; margin-bottom: 6px; color: #000; }
#manse-app .pdf-table th, #manse-app .pdf-table td { border: 0.5px solid #ccc; padding: 8px 10px; text-align: center; color: #000; background: #fff; }
#manse-app .pdf-table thead th { background: #f2f2f2; font-weight: 700; }
#manse-app .pdf-wonguk-label { background: #f2f2f2; font-weight: 700; text-align: left; white-space: nowrap; width: 1%; }
#manse-app .pdf-wonguk thead th:nth-child(3), #manse-app .pdf-wonguk tbody td:nth-child(3) { background: #fffbe8; }
#manse-app .pdf-big { font-size: 27px; font-weight: 700; }
#manse-app .pdf-hanja-main { line-height: 1.2; }
#manse-app .pdf-hanja-sub { font-size: 13px; font-weight: 400; color: #888; line-height: 1.3; margin-top: 2px; }
#manse-app .hide-hangul-sub .pdf-hanja-sub { display: none; }
#manse-app .hangul-toggle { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #444; margin-left: auto; cursor: pointer; user-select: none; }
#manse-app .color-tile { width: 52px; height: 52px; margin: 0 auto; border-radius: 4px; border: 1px solid #333; display: flex; align-items: center; justify-content: center; font-size: 30px; font-weight: 700; }
#manse-app .tile-mok { background: #2e9e4f; color: #fff; }
#manse-app .tile-hwa { background: #d23c3c; color: #fff; }
#manse-app .tile-to { background: #e0a92e; color: #fff; }
#manse-app .tile-geum { background: #fff; color: #333; border-width: 2px; }
#manse-app .tile-su { background: #3a3a3a; color: #fff; }
#manse-app .pdf-jijanggan-cell div { line-height: 1.5; }
#manse-app .pdf-jijanggan-cell div:not(:last-child) { border-bottom: 1px dashed #ccc; padding-bottom: 2px; margin-bottom: 2px; }
#manse-app tr.pdf-current td { background: #fff2b8; font-weight: 700; }
#manse-app .pdf-sgy td { text-align: left; }
#manse-app .pdf-gunghap td { text-align: left; }
#manse-app .pdf-gunghap td div:not(:last-child) { margin-bottom: 3px; }
#manse-app .gunghap-relation-label { font-weight: 700; font-size: 16px; margin-bottom: 10px; color: #000; }
#manse-app .gunghap-person-label { font-weight: 700; font-size: 15px; margin: 18px 0 6px; color: #000; }
#manse-app .el-mok { color: #2e7d32; }
#manse-app .el-hwa { color: #c62828; }
#manse-app .el-to { color: #a06a00; }
#manse-app .el-geum { color: #757575; }
#manse-app .el-su { color: #1a237e; }
#manse-app .pdf-gwiin { color: #1565c0; }
#manse-app .pdf-sal { color: #b71c1c; }
#manse-app .pdf-gongmang { color: #000; font-weight: 700; }
#manse-app .top-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
#manse-app #refreshBtn { background: #fff; color: #333; border: 1px solid #ccc; padding: 7px 14px; font-size: 13px; }
#manse-app #refreshBtn:hover { background: #f2f2f2; }
#manse-app .mode-tabs { display: flex; gap: 8px; margin: 14px 0; }
#manse-app .mode-tab-btn { padding: 8px 18px; border: 1px solid #ccc; border-radius: 8px; background: #fff; color: #444; font-size: 14px; font-weight: 600; cursor: pointer; }
#manse-app .mode-tab-btn.active { background: #0071e3; color: #fff; border-color: #0071e3; }
#manse-app .gunghap-person-block { border: 1px solid #e4e4e7; border-radius: 8px; padding: 12px; margin-bottom: 10px; }
#manse-app .gunghap-person-title { font-weight: 700; font-size: 13px; color: #333; margin-bottom: 8px; }
#manse-app .gunghap-block-a { background: #f0f6ff; border-color: #d6e6ff; }
#manse-app .gunghap-block-a .gunghap-person-title { color: #1d4ed8; }
#manse-app .gunghap-block-b { background: #fff4f0; border-color: #ffe0d3; }
#manse-app .gunghap-block-b .gunghap-person-title { color: #c2410c; }
@media (max-width: 860px) {
#manse-app .saved-side { max-width: none; }
}

#manse-app { margin: 0 auto; background: transparent; }

/* ══════════════════════════════════════════════════════
 * 루월당 대시보드용 레이아웃 조정
 *   PC   : 왼쪽 입력폼(고정폭) | 오른쪽 결과(남는 폭 전부)
 *   모바일: 위 입력폼 → 아래 결과 (세로로 쌓임)
 *   저장된 사주는 오른쪽 위 버튼을 누르면 열리는 서랍으로
 * ══════════════════════════════════════════════════════ */

#manse-app { max-width: 100%; padding: 0; }

/* ── 상단 바 ── */
#manse-app .top-bar { flex-wrap: wrap; gap: 8px; margin-bottom: 2px; }
#manse-app .top-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
#manse-app .top-bar h1 { font-size: 20px; }
#manse-app .desc { margin-bottom: 10px; }

/* ── 저장된 사주 서랍 ── */
#manse-app .saved-wrap { position: relative; }
#manse-app .saved-pop {
  display: none; position: absolute; right: 0; top: calc(100% + 6px); z-index: 40;
  width: 300px; max-height: 60vh; background: #fff; border: 1px solid #ddd;
  border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,.14);
  padding: 12px; flex-direction: column;
}
#manse-app .saved-pop.open { display: flex; }
#manse-app .saved-pop .saved-search-input { width: 100%; margin-bottom: 8px; }
#manse-app .saved-pop .saved-list { flex: 1 1 auto; overflow-y: auto; min-height: 60px; max-height: 40vh; }

/* ── 2단 배치 ── */
#manse-app .layout { display: flex; gap: 18px; align-items: flex-start; flex-wrap: nowrap; }
#manse-app .form-panel { flex: 0 0 430px; min-width: 0; width: 430px; }
#manse-app .result-col { flex: 1 1 auto; min-width: 0; }

/* 왼쪽 폼을 세로로 — 한 줄에 하나씩 쌓아 좁은 폭에서도 안 깨지게 */
#manse-app .form-panel .row { gap: 8px; }
#manse-app .form-panel .field { flex: 1 1 120px; min-width: 0; }
#manse-app .form-panel input,
#manse-app .form-panel select,
#manse-app .form-panel textarea { width: 100%; min-width: 0; }
/* 원본이 픽셀로 못박아둔 폭을 푼다 (좁은 칸에서 삐져나감) */
#manse-app .form-panel #name, #manse-app .form-panel #gender, #manse-app .form-panel #birth,
#manse-app .form-panel #calendar, #manse-app .form-panel #leap, #manse-app .form-panel #time,
#manse-app .form-panel #seyunRange, #manse-app .form-panel #wolunRange,
#manse-app .form-panel #loveStatus, #manse-app .form-panel #ganjiSelect,
#manse-app .form-panel .region-search-input,
#manse-app .form-panel .region-manual-input { width: 100%; }
#manse-app .form-panel .actions button { flex: 1 1 auto; }

/* ── 결과 칸 ── */
#manse-app .result-toolbar { margin-top: 0; flex-wrap: wrap; }
#manse-app #result { margin-top: 0; }
#manse-app .result-box, #manse-app .pdf-view { max-height: none; }
/* 표가 넘칠 때 세로 스크롤 대신 가로 스크롤 */
#manse-app .pdf-view, #manse-app .result-box { overflow-x: auto; }

/* ══════════ 모바일 ══════════ */
@media (max-width: 900px) {
  #manse-app .layout { flex-wrap: wrap; gap: 14px; }
  #manse-app .form-panel { flex: 1 1 100%; width: 100%; }
  #manse-app .result-col { flex: 1 1 100%; }

  /* 손가락으로 누르기 편하게 */
  #manse-app input, #manse-app select, #manse-app textarea {
    font-size: 16px;      /* 16px 미만이면 아이폰이 화면을 확대해버린다 */
    padding: 10px;
  }
  #manse-app .actions { gap: 8px; }
  #manse-app .actions button { flex: 1 1 calc(50% - 4px); padding: 12px 10px; font-size: 14px; }
  #manse-app .result-toolbar button { flex: 1 1 calc(50% - 5px); padding: 11px 8px; }
  #manse-app .hangul-toggle { flex: 1 1 100%; margin-left: 0; justify-content: flex-start; }

  #manse-app .top-bar h1 { font-size: 18px; }
  #manse-app .saved-pop { width: min(320px, calc(100vw - 40px)); }

  /* 명식 표는 폭이 좁으면 가로로 밀어서 본다 */
  #manse-app .pdf-table { font-size: 12px; }
  #manse-app .pdf-big { font-size: 22px; }
  #manse-app .color-tile { width: 42px; height: 42px; font-size: 24px; }
}

@media (max-width: 520px) {
  #manse-app .form-panel .field { flex: 1 1 100%; }
  #manse-app .actions button { flex: 1 1 100%; }
}

</style>

<div id="manse-app">

  <div class="top-bar">
    <h1>사주 명식 엔진</h1>
    <div class="top-actions">
      <div class="saved-wrap">
        <button type="button" id="savedToggle" class="secondary">저장된 사주</button>
        <div class="saved-pop" id="savedPop">
          <input type="text" id="savedSearch" class="saved-search-input" placeholder="이름 검색">
          <div class="saved-list" id="savedList"></div>
          <div class="saved-pagination" id="savedPagination"></div>
        </div>
      </div>
      <button type="button" id="refreshBtn">새로고침</button>
    </div>
  </div>
  <p class="desc">왼쪽에 입력하고 버튼을 누르면 오른쪽에 명식이 나옵니다.</p>

  <div class="mode-tabs">
    <button type="button" class="mode-tab-btn active" id="modeIndividual">개인 사주</button>
    <button type="button" class="mode-tab-btn" id="modeGunghap">궁합</button>
  </div>

  <div class="layout">
  <div class="form-panel">
  <form id="form">
    <div class="row">
      <div class="field">
        <label for="name">이름</label>
        <input type="text" id="name" placeholder="이름">
      </div>
      <div class="field">
        <label for="gender">성별</label>
        <select id="gender">
          <option value="male">남자</option>
          <option value="female">여자</option>
        </select>
      </div>
      <div class="field">
        <label for="birth">생일</label>
        <input type="text" id="birth" inputmode="numeric" maxlength="8" placeholder="YYYYMMDD">
      </div>
      <div class="field">
        <label for="calendar">달력</label>
        <select id="calendar">
          <option value="solar">양력</option>
          <option value="lunar">음력</option>
        </select>
      </div>
      <div class="field">
        <label for="leap">윤달</label>
        <select id="leap">
          <option value="false">평달</option>
          <option value="true">윤달</option>
        </select>
      </div>
      <div class="field">
        <label for="time">생시</label>
        <input type="text" id="time" inputmode="numeric" maxlength="4" placeholder="HHMM">
      </div>
      <div class="field or-field">
        <span class="or-text">또는</span>
      </div>
      <div class="field">
        <label for="ganjiSelect">간지선택</label>
        <select id="ganjiSelect">
          <option value="선택안함">선택안함</option>
          <option value="자시(子時) 23:30~01:30">자시(子時) 23:30~01:30</option>
          <option value="축시(丑時) 01:30~03:30">축시(丑時) 01:30~03:30</option>
          <option value="인시(寅時) 03:30~05:30">인시(寅時) 03:30~05:30</option>
          <option value="묘시(卯時) 05:30~07:30">묘시(卯時) 05:30~07:30</option>
          <option value="진시(辰時) 07:30~09:30">진시(辰時) 07:30~09:30</option>
          <option value="사시(巳時) 09:30~11:30">사시(巳時) 09:30~11:30</option>
          <option value="오시(午時) 11:30~13:30">오시(午時) 11:30~13:30</option>
          <option value="미시(未時) 13:30~15:30">미시(未時) 13:30~15:30</option>
          <option value="신시(申時) 15:30~17:30">신시(申時) 15:30~17:30</option>
