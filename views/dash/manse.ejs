<script>
/* ── 저장 기능 대체 ──
 * 원본 프로그램은 서버 폴더에 json 파일로 저장했다.
 * Railway는 배포할 때마다 파일이 초기화되므로 그대로 쓰면 저장한 게 사라진다.
 * 그래서 이 브라우저에만 저장한다(localStorage). 서버·DB를 건드리지 않는다.
 *   · 이 컴퓨터/이 브라우저에서만 보인다
 *   · 교육생별로 키를 나눠 계정이 섞이지 않게 한다
 * 나중에 여러 기기에서 공유하려면 DB로 옮기면 된다. */
const MS_STORE = (function () {
  const KEY = 'luwol_manse_saved_<%= user.id %>';

  const all = () => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; } };
  const put = (arr) => localStorage.setItem(KEY, JSON.stringify(arr));
  const today = () => { const d = new Date(); const p = (n) => String(n).padStart(2, '0');
    return String(d.getFullYear()).slice(2) + p(d.getMonth() + 1) + p(d.getDate()); };

  function nameOf(d) {
    if (d.kind === 'gunghap') {
      return ((d.person1 && d.person1.name) || '본인') + '_' + ((d.person2 && d.person2.name) || '상대') + '_궁합';
    }
    return d.name || '이름없음';
  }

  return {
    list() { return { ok: true, profiles: all() }; },

    save(data) {
      const overwrite = !!data.overwrite;
      const filename = nameOf(data) + '_' + today() + '.json';
      const arr = all();
      const at = arr.findIndex((x) => x.filename === filename);
      if (at >= 0 && !overwrite) return { ok: true, needsConfirm: true, filename };
      const row = Object.assign({}, data, { filename, savedAt: new Date().toISOString() });
      delete row.overwrite;
      if (at >= 0) arr[at] = row; else arr.unshift(row);
      put(arr);
      return { ok: true, filename };
    },

    del(filename) { put(all().filter((x) => x.filename !== filename)); return { ok: true }; },
  };
})();

/* 저장된 사주 서랍 열고 닫기 (바깥 누르면 닫힘) */
(function () {
  const btn = document.getElementById('savedToggle');
  const pop = document.getElementById('savedPop');
  if (!btn || !pop) return;
  btn.addEventListener('click', function (e) {
    e.stopPropagation();
    pop.classList.toggle('open');
  });
  pop.addEventListener('click', function (e) { e.stopPropagation(); });
  document.addEventListener('click', function () { pop.classList.remove('open'); });
})();
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
