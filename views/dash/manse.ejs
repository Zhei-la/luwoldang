function flashBtnMessage(btn, msg, ms) {
  const original = btn.dataset.label || btn.textContent;
  btn.dataset.label = original;
  btn.textContent = msg;
  clearTimeout(btn._resetTimer);
  btn._resetTimer = setTimeout(() => { btn.textContent = original; }, ms || 1500);
}

async function copyToButton(btn) {
  if (!lastText || btn.disabled) return;
  try {
    await navigator.clipboard.writeText(lastText);
  } catch (err) {
    const ta = document.createElement('textarea');
    ta.value = lastText;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
  }
  flashBtnMessage(btn, '복사됐습니다');
}

copyBtnTop.addEventListener('click', () => copyToButton(copyBtnTop));

downloadBtn.addEventListener('click', () => {
  if (!lastText || downloadBtn.disabled) return;
  const blob = new Blob([lastText], { type: 'text/plain;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = lastName ? ('명식표_' + lastName + '.txt') : '명식표.txt';
  a.click();
  URL.revokeObjectURL(url);
});

// ── PDF용 표 / 컬러 표 이미지 내보내기 (현재 활성 탭 기준) ──
function buildImageFilename() {
  const parts = [];
  if (lastName) parts.push(lastName);
  if (lastBirth) parts.push(lastBirth);
  parts.push(activeResultTab === 'color' ? '컬러명식표' : '명식표');
  return parts.join('_') + '.png';
}

function renderPdfCanvas() {
  const targetId = activeResultTab === 'color' ? 'colorCaptureArea' : 'pdfCaptureArea';
  const target = document.getElementById(targetId);
  return html2canvas(target, { backgroundColor: '#ffffff', scale: 2 });
}

function canvasToPngBlob(canvas) {
  return new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
}

async function copyPdfImage(btn) {
  if (btn.disabled) return;
  if (!(navigator.clipboard && window.ClipboardItem)) {
    flashBtnMessage(btn, '복사가 지원되지 않아요. 이미지 저장을 이용해주세요', 2500);
    return;
  }
  try {
    const canvas = await renderPdfCanvas();
    const blob = await canvasToPngBlob(canvas);
    await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
    flashBtnMessage(btn, '이미지가 복사됐습니다');
  } catch (err) {
    flashBtnMessage(btn, '복사가 지원되지 않아요. 이미지 저장을 이용해주세요', 2500);
  }
}

async function savePdfImage(btn) {
  if (btn.disabled) return;
  try {
    const canvas = await renderPdfCanvas();
    const blob = await canvasToPngBlob(canvas);
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = buildImageFilename();
    a.click();
    URL.revokeObjectURL(url);
  } catch (err) {
    alert('이미지 저장 중 오류: ' + err.message);
  }
}

pdfCopyImgBtn.addEventListener('click', () => copyPdfImage(pdfCopyImgBtn));
pdfSaveImgBtn.addEventListener('click', () => savePdfImage(pdfSaveImgBtn));

// ── 저장된 사주: 사이드 목록 패널 (모드별 분리 + 검색 + 페이지네이션) ──
const savedListEl = document.getElementById('savedList');
const savedPaginationEl = document.getElementById('savedPagination');
const savedSearchEl = document.getElementById('savedSearch');
const SAVED_PAGE_SIZE = 10;

let allSavedProfiles = [];
let savedSearchQuery = '';
let savedCurrentPage = 1;

function formatBirth(p) {
  return String(p.year) + String(p.month).padStart(2, '0') + String(p.day).padStart(2, '0');
}
function formatSavedAt(savedAt) {
  return savedAt.slice(0, 2) + '.' + savedAt.slice(2, 4) + '.' + savedAt.slice(4, 6);
}

// 개인 모드(prefix='')와 궁합 모드 본인/상대(prefix='p1_'/'p2_')가 공유하는 필드 채우기.
function loadPersonIntoFields(prefix, p) {
  document.getElementById(prefix + 'name').value = p.name || '';
  document.getElementById(prefix + 'gender').value = p.gender || 'male';
  document.getElementById(prefix + 'birth').value = formatBirth(p);
  document.getElementById(prefix + 'calendar').value = p.isLunar ? 'lunar' : 'solar';
  document.getElementById(prefix + 'leap').value = p.isLeapMonth ? 'true' : 'false';
  const hourUnknownEl = document.getElementById(prefix + 'hourUnknown');
  const ganjiEl = document.getElementById(prefix + 'ganjiSelect');
  const timeEl = document.getElementById(prefix + 'time');
  hourUnknownEl.checked = !!p.hourUnknown;
  const ganji = !p.hourUnknown && p.ganjiSelect ? p.ganjiSelect : '선택안함';
  ganjiEl.value = ganji;
  ganjiEl.disabled = !!p.hourUnknown;
  timeEl.disabled = !!p.hourUnknown || ganji !== '선택안함';
  timeEl.value = (p.hourUnknown || ganji !== '선택안함')
    ? ''
    : (String(p.hour).padStart(2, '0') + String(p.minute).padStart(2, '0'));
  setBirthRegionFields(prefix, p);
}

function loadProfileIntoForm(p) {
  loadPersonIntoFields('', p);
  document.getElementById('concern').value = p.concern || '';
  document.getElementById('seyunRange').value = String(p.세운년수 || 5);
  document.getElementById('wolunRange').value = String(p.월운개월수 || 12);
  document.getElementById('loveStatus').value = p.연애상태 || '선택안함';
  clearFormError();
}

function loadGunghapProfileIntoForm(p) {
  loadPersonIntoFields('p1_', p.person1 || {});
  loadPersonIntoFields('p2_', p.person2 || {});
  document.getElementById('relationType').value = p.relationType || '모자';
  document.getElementById('gConcern').value = p.concern || '';
  clearGFormError();
}

// 개인 모드에서는 type==='개인' 항목만, 궁합 모드에서는 type==='궁합' 항목만 보이도록 완전히 분리한다.
function currentSavedType() {
  return currentMode === 'gunghap' ? '궁합' : '개인';
}

function savedItemLabel(p) {
  if (p.type === '궁합') {
    const n1 = (p.person1 && p.person1.name) || '이름없음';
    const n2 = (p.person2 && p.person2.name) || '이름없음';
    return n1 + ' × ' + n2 + ' [' + (p.relationType || '') + '] · ' + formatSavedAt(p.savedAt);
  }
  return (p.name || '이름없음') + ' (' + formatBirth(p) + ') · ' + formatSavedAt(p.savedAt);
}

function filteredSavedProfiles() {
  const type = currentSavedType();
  const q = savedSearchQuery.trim();
  return allSavedProfiles.filter(p => {
    if (p.type !== type) return false;
    if (!q) return true;
    if (type === '궁합') {
      const n1 = (p.person1 && p.person1.name) || '';
      const n2 = (p.person2 && p.person2.name) || '';
      return n1.includes(q) || n2.includes(q);
    }
    return (p.name || '').includes(q);
  });
}

function renderSavedSide() {
  const list = filteredSavedProfiles();
  const totalPages = Math.max(1, Math.ceil(list.length / SAVED_PAGE_SIZE));
  if (savedCurrentPage > totalPages) savedCurrentPage = totalPages;
  const startIdx = (savedCurrentPage - 1) * SAVED_PAGE_SIZE;
  const pageItems = list.slice(startIdx, startIdx + SAVED_PAGE_SIZE);

  savedListEl.innerHTML = '';
  if (!pageItems.length) {
    const msg = allSavedProfiles.length === 0 ? '저장된 사주가 없습니다' : (list.length === 0 ? '검색 결과가 없습니다' : '해당 페이지에 항목이 없습니다');
    savedListEl.innerHTML = '<div class="saved-empty">' + msg + '</div>';
    renderSavedPagination(0);
    return;
  }

  pageItems.forEach(p => {
    const row = document.createElement('div');
    row.className = 'saved-item';

    const label = document.createElement('span');
    label.className = 'saved-item-label';
    label.textContent = savedItemLabel(p);
    label.addEventListener('click', () => {
      if (p.type === '궁합') loadGunghapProfileIntoForm(p);
      else loadProfileIntoForm(p);
    });

    const delBtn = document.createElement('button');
    delBtn.type = 'button';
    delBtn.className = 'saved-item-delete';
    delBtn.title = '삭제';
    delBtn.textContent = '🗑';
    delBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      if (!confirm(savedItemLabel(p) + ' 항목을 삭제할까요?')) return;
      MS_STORE.del(p.filename);
      await loadSavedList();
    });

    row.appendChild(label);
    row.appendChild(delBtn);
    savedListEl.appendChild(row);
  });

  renderSavedPagination(totalPages);
}

function renderSavedPagination(totalPages) {
  savedPaginationEl.innerHTML = '';
  if (totalPages <= 1) return;

  const mkBtn = (label, page, opts) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'saved-page-btn' + ((opts && opts.active) ? ' active' : '');
    btn.textContent = label;
    btn.disabled = !!(opts && opts.disabled);
    btn.addEventListener('click', () => { savedCurrentPage = page; renderSavedSide(); });
    return btn;
  };

  savedPaginationEl.appendChild(mkBtn('이전', savedCurrentPage - 1, { disabled: savedCurrentPage <= 1 }));
  for (let i = 1; i <= totalPages; i++) savedPaginationEl.appendChild(mkBtn(String(i), i, { active: i === savedCurrentPage }));
  savedPaginationEl.appendChild(mkBtn('다음', savedCurrentPage + 1, { disabled: savedCurrentPage >= totalPages }));
}

savedSearchEl.addEventListener('input', () => {
  savedSearchQuery = savedSearchEl.value;
  savedCurrentPage = 1;
  renderSavedSide();
});

async function loadSavedList() {
  try {
    const data = MS_STORE.list();
    allSavedProfiles = data.profiles || [];
    renderSavedSide();
  } catch (err) {
    savedListEl.innerHTML = '<div class="saved-empty">목록을 불러오지 못했습니다</div>';
  }
}

async function postSaveRequest(data, overwrite) {
  return MS_STORE.save({ ...data, overwrite });
}

document.getElementById('saveBtn').addEventListener('click', async () => {
  const data = collectFormData();
  if (!data) return;
  try {
    const result = await postSaveRequest(data, false);
    if (!result.ok) { alert('저장 실패: ' + (result.error || '알 수 없는 오류')); return; }
    if (result.needsConfirm) {
      if (!confirm('오늘 이미 저장된 파일이 있습니다. 덮어쓸까요?\n' + result.filename)) return;
      const overwritten = await postSaveRequest(data, true);
      if (!overwritten.ok) { alert('저장 실패: ' + (overwritten.error || '알 수 없는 오류')); return; }
      alert('덮어썼습니다: ' + overwritten.filename);
    } else {
      alert('저장했습니다: ' + result.filename);
    }
    loadSavedList();
  } catch (err) {
    alert('저장 중 오류: ' + err.message);
  }
});

document.getElementById('gSaveBtn').addEventListener('click', async () => {
  const data = collectGunghapFormData();
  if (!data) return;
  const payload = { kind: 'gunghap', ...data };
  try {
    const result = await postSaveRequest(payload, false);
    if (!result.ok) { alert('저장 실패: ' + (result.error || '알 수 없는 오류')); return; }
    if (result.needsConfirm) {
      if (!confirm('오늘 이미 저장된 파일이 있습니다. 덮어쓸까요?\n' + result.filename)) return;
      const overwritten = await postSaveRequest(payload, true);
      if (!overwritten.ok) { alert('저장 실패: ' + (overwritten.error || '알 수 없는 오류')); return; }
      alert('덮어썼습니다: ' + overwritten.filename);
    } else {
      alert('저장했습니다: ' + result.filename);
    }
    loadSavedList();
  } catch (err) {
    alert('저장 중 오류: ' + err.message);
  }
});

loadSavedList();
</script>

