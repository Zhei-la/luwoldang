}

// 궁합 모드: 본인(p1_)/상대(p2_) 필드셋 공용 수집. 세운/월운/연애상태는 궁합 모드에 없다.
function collectPersonFields(prefix, showErrorFn) {
  const bt = parseBirthAndTime(prefix, showErrorFn);
  if (!bt) return null;
  return {
    name: document.getElementById(prefix + 'name').value,
    ...bt,
    isLunar: document.getElementById(prefix + 'calendar').value === 'lunar',
