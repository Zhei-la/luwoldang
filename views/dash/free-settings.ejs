<%- include('../partials/dash-top', { user: user, active: active, title: '무료사주 웹사이트 설정' }) %>

<% var shareUrl = baseUrl + '/s/' + user.slug; %>

<% if (saved) { %><div class="save-toast">저장되었습니다.</div><% } %>

<!-- 공유 링크 -->
<div class="settings-block">
  <h2 class="section-h">내 웹사이트 링크</h2>
  <p class="block-desc">이 링크를 공유하면 내가 꾸민 랜딩 페이지가 열립니다. <a href="/builder">웹사이트 꾸미러 가기 →</a></p>
  <div class="share-row">
    <input class="fi share-input" id="shareUrl" type="text" value="<%= shareUrl %>" readonly>
    <button class="btn btn-approve" type="button" onclick="copyShare()">복사</button>
    <a class="btn btn-ghost" href="<%= shareUrl %>" target="_blank">미리보기</a>
  </div>

  <!-- 링크 주소 바꾸기 -->
  <label class="fl" style="margin-top:20px">링크 주소 바꾸기</label>
  <% if (slugError) { %><div class="free-error" style="margin-bottom:8px"><%= slugError %></div><% } %>
  <form method="post" action="/free-saju-settings/slug" class="share-row" onsubmit="return confirmSlug()">
    <span class="slug-pre"><%= baseUrl %>/s/</span>
    <input class="fi" type="text" name="slug" id="slugIn" value="<%= user.slug %>"
           pattern="[a-zA-Z0-9-]{3,24}" required
           placeholder="mysaju" style="flex:1;min-width:120px">
    <button class="btn btn-approve" type="submit">변경</button>
  </form>
  <p class="block-desc" style="margin-top:8px">
    영문·숫자·하이픈(-)만, 3~24자. 예: <b>mysaju</b>, <b>moon-saju</b>, <b>hong-gildong</b><br>
    ⚠️ 바꾸면 <b>예전 링크는 열리지 않습니다.</b> 이미 공유한 곳이 있으면 주의하세요.
  </p>
</div>

<!-- 무료 만세력 — 요금이 안 나가는 미끼 링크 -->
<div class="settings-block">
  <h2 class="section-h">무료 만세력 링크 <span style="font-size:12px;color:#2F7A55;font-weight:700">새로 생겼습니다</span></h2>
  <p class="block-desc">
    손님이 생년월일만 넣으면 <b>원국 네 기둥 · 오늘의 운세 · 짧은 풀이</b>가 바로 나오는 페이지입니다.
    다 보여준 다음 아래에서 상담을 권하고, 번호를 남기면 <b>내 신청자 목록</b>에 「만세력」으로 쌓입니다.
    <br><b>이 페이지는 AI 를 쓰지 않아 손님이 아무리 많이 와도 요금이 0원입니다.</b>
    무료사주(위 링크)는 볼 때마다 OpenAI 요금이 나가니, 널리 뿌리실 때는 이쪽이 낫습니다.
  </p>
  <div class="share-row">
    <input class="fi share-input" id="manseUrl" type="text"
           value="<%= msiteBase %>/<%= user.slug %>" readonly>
    <button class="btn btn-approve" type="button" onclick="copyManse()">복사</button>
    <a class="btn btn-ghost" href="<%= msiteBase %>/<%= user.slug %>" target="_blank">미리보기</a>
  </div>
  <p class="block-desc" style="margin-top:8px">
    <b><%= msiteBase %>/@<%= user.slug %></b> 와 <b><%= msiteBase %>/saju@<%= user.slug %></b> 로
    들어와도 같은 곳이 열립니다. 세 가지 모양 모두 지금 아이디(<b><%= user.slug %></b>)일 때만 됩니다.<br>
    <b style="color:#A8332B">⚠️ 아이디를 바꾸면 예전 링크는 열리지 않습니다.</b>
    이미 공유하신 곳이 있으면 주의하세요 — 스레드 글, 문자로 보낸 링크, 프로필에 걸어둔 주소가
    모두 안 열리게 됩니다.<br>
    상담 신청 뒤 넘어갈 곳은 아래 <b>카카오톡 상담 링크</b>를 씁니다. 비워두면 안내 문구만 나옵니다.
  </p>
</div>

<style>
  .th-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-top:4px}
  .th-grid label{position:relative;cursor:pointer;display:block}
  .th-grid input{position:absolute;opacity:0;width:0;height:0}
  .th-card{border:2px solid var(--beige);border-radius:12px;overflow:hidden;background:#fff}
  .th-grid input:checked + .th-card{border-color:var(--gold)}
  .th-grid input:focus-visible + .th-card{outline:2px solid var(--gold);outline-offset:2px}
  .th-top{height:58px;position:relative;display:flex;align-items:center;padding:0 11px;gap:7px}
  .th-dot{width:20px;height:20px;border-radius:6px;flex:none}
  .th-bar{height:7px;border-radius:100px;flex:1}
  .th-body{padding:9px 11px 11px}
  .th-body b{display:block;font-size:14px;font-weight:800;color:var(--ink)}
  .th-body span{display:block;font-size:11.5px;color:#9A9384;line-height:1.6;margin-top:2px}
  .th-on{position:absolute;top:7px;right:9px;font-size:11px;font-weight:800;color:#fff;
    background:rgba(0,0,0,.35);border-radius:100px;padding:2px 8px;display:none}
  .th-grid input:checked + .th-card .th-on{display:block}
</style>


<!-- 설정 폼 -->
<form method="post" action="/free-saju-settings" class="settings-form">
<div class="settings-block">
  <h2 class="section-h">무료 만세력 색</h2>
  <p class="block-desc">위 링크로 열리는 페이지의 색입니다.
    <b>다 똑같으면 금방 티가 나니</b> 자기 것으로 골라두세요.
    다섯 벌 다 글씨가 잘 읽히는지 확인해둔 것들입니다.
    <br>고른 뒤 아래 <b>저장</b>을 누르셔야 반영됩니다.</p>
  <div class="th-grid">
    <% themes.forEach(function(th){ %>
      <label>
        <input type="radio" name="msite_theme" value="<%= th.key %>"
               <%= themeNow === th.key ? 'checked' : '' %>>
        <div class="th-card">
          <div class="th-top" style="background:<%= th.bg %>">
            <span class="th-on">고름</span>
            <span class="th-dot" style="background:<%= th.gold %>"></span>
            <span class="th-bar" style="background:<%= th.ink %>;opacity:.75"></span>
          </div>
          <div class="th-body">
            <b><%= th.name %></b>
            <span><%= th.hint %></span>
          </div>
        </div>
      </label>
    <% }); %>
  </div>
</div>

<!-- 만세력 신청란 — 하루 정원과 할인 -->
<div class="settings-block">
  <h2 class="section-h">만세력 신청란 — 하루 정원</h2>
  <p class="block-desc">만세력을 본 손님이 신청하는 칸에
    <b>「하루 5명만 받습니다 · 오늘 3자리 남았습니다」</b> 안내를 띄웁니다.
    <br>정원 안에 드는 분께는 금액을 깎아드리고, 자리가 차면 안내가 바뀝니다.
    <br><b>남은 자리는 오늘 만세력으로 들어온 신청자 수를 세어 저절로 줄어듭니다.</b>
    자정이 지나면 다시 채워집니다.</p>

  <label class="chk-row">
    <input type="checkbox" name="q_on" value="on" <%= quotaNow.on ? 'checked' : '' %>>
    <span>하루 정원 안내를 켭니다</span>
  </label>

  <div class="q-grid">
    <div>
      <label for="qcap">하루 정원</label>
      <input type="number" id="qcap" name="q_cap" min="1" max="99" value="<%= quotaNow.cap %>">
      <small>하루에 몇 분까지 받을지</small>
    </div>
    <div>
      <label for="qseed">미리 채움</label>
      <input type="number" id="qseed" name="q_seed" min="0" max="98" value="<%= quotaNow.seed %>">
      <small>시작부터 몇 자리 찬 걸로 보이게 할지 (0이면 안 씀)</small>
    </div>
    <div>
      <label for="qdis">깎아줄 금액</label>
      <input type="number" id="qdis" name="q_discount" min="0" step="1000" value="<%= quotaNow.discount %>">
      <small>정원 안에 들면 이만큼 뺀 금액으로 안내합니다</small>
    </div>
  </div>

  <div class="q-full">
    <label>자리가 다 찼을 때</label>
    <label class="chk-row">
      <input type="radio" name="q_full" value="next" <%= quotaNow.full === 'next' ? 'checked' : '' %>>
      <span><b>다음날 순번으로 받기</b> — 신청은 계속 받되 「내일 순번으로 접수됩니다」라고 안내합니다</span>
    </label>
    <label class="chk-row">
      <input type="radio" name="q_full" value="block" <%= quotaNow.full === 'block' ? 'checked' : '' %>>
      <span><b>신청 막기</b> — 단추를 잠그고 「내일 0시에 다시 열립니다」만 보여줍니다</span>
    </label>
  </div>

  <p class="block-desc" style="margin-top:12px">
    깎아드린 금액은 신청자 메모에 남습니다. 얼마를 받아야 하는지 목록에서 바로 보입니다.
    <br>정원이 찬 뒤 들어온 신청에는 <b>할인이 붙지 않습니다.</b>
  </p>
</div>

<style>
  .q-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin:14px 0 4px}
  .q-grid label{display:block;font-size:13px;font-weight:700;margin-bottom:5px}
  .q-grid input{width:100%}
  .q-grid small{display:block;margin-top:5px;font-size:11.5px;color:#8a8574;line-height:1.5}
  .q-full{margin-top:16px}
  .q-full > label:first-child{display:block;font-size:13px;font-weight:700;margin-bottom:7px}
  .chk-row{display:flex;align-items:flex-start;gap:9px;font-size:13.5px;line-height:1.65;
    margin-bottom:7px;cursor:pointer}
  .chk-row input{margin-top:3px;flex:none}
</style>
  <div class="settings-block">
    <h2 class="section-h">사이트 정보</h2>

    <label class="fl">사이트 이름 (무료사주 첫 화면 제목)</label>
    <input class="fi" type="text" name="site_name" value="<%= user.site_name || '' %>" placeholder="예: 루월당">

    <label class="fl">OpenAI API 키 <% if (hasKey) { %><span class="key-ok">저장됨 ✓</span><% } %></label>
    <%# ⚠️ type=password 로 두면 크롬이 「저장된 로그인 비밀번호」를 밀어 넣는다.
        그 상태로 저장하면 진짜 키가 비밀번호로 덮여, 나중에
        「키가 맞지 않습니다」만 뜨고 이유를 알 수가 없다.
        type=text + name 없음 으로 두고, 눈에 안 보이게는 CSS 로 처리한다. %>
    <input class="fi key-in" type="text" id="oaKey" placeholder="<%= hasKey ? '변경하려면 새 키 입력 (비우면 그대로)' : 'sk-... 로 시작하는 키' %>"
           autocomplete="off" autocapitalize="off" spellcheck="false"
           autocorrect="off" data-lpignore="true" data-1p-ignore data-bwignore>
    <input type="hidden" name="openai_key" id="oaKeyReal">
    <% if (typeof keyErr !== 'undefined' && keyErr) { %>
      <p class="hint" style="color:#B4483C;font-weight:700">
        키 모양이 아니어서 저장하지 않았습니다. OpenAI 키는 <b>sk-</b> 로 시작합니다.<br>
        브라우저가 저장해둔 비밀번호를 대신 넣었을 수 있습니다. 직접 붙여넣어 주세요.</p>
    <% } %>
    <p class="hint">무료사주 · PDF · 스레드 글이 전부 이 키로 만들어집니다.
      <a href="https://platform.openai.com/api-keys" target="_blank">키 발급받기</a><br>
      지우시려면 이 칸에 <b>지우기</b> 라고 적고 저장하세요.</p>

    <%# 스레드 발행 키 — OpenAI 키와 헷갈리기 쉬워 여기 나란히 둔다.
        글을 「만드는」 것은 OpenAI, 「올리는」 것은 Zernio 다. %>
    <label class="fl" style="margin-top:22px">스레드 발행 키 (Zernio)
      <% if ((thAccounts || []).length) { %><span class="key-ok">연결됨 ✓</span><% } %></label>

    <% if ((thAccounts || []).length) { %>
      <div class="zn-list">
        <% thAccounts.forEach(function(a){ %>
          <div class="zn-row">
            <b>@<%= a.username || a.accountId %></b>
            <% if (a.active) { %><span class="zn-now">지금 올리는 곳</span><% } %>
          </div>
        <% }); %>
      </div>
    <% } %>

    <div class="zn-add">
      <input class="fi" type="password" id="znKey" placeholder="sk_ 로 시작하는 Zernio 열쇠" autocomplete="off">
      <button type="button" class="btn btn-ghost" id="znBtn">계정 연결</button>
    </div>
    <div id="znMsg" class="hint" style="min-height:20px"></div>
    <p class="hint">
      <b>OpenAI 키와 다른 것입니다.</b> OpenAI 는 글을 <b>만들고</b>,
      Zernio 는 그 글을 스레드에 <b>올립니다.</b> 둘 다 있어야 자동 발행이 됩니다.<br>
      <a href="https://zernio.com/dashboard/api-keys" target="_blank">Zernio 에서 키 발급받기</a>
      · 스레드 계정을 여러 개 쓰시면 계정마다 키를 하나씩 넣으시면 됩니다.
    </p>
  </div>

<style>
  /* 키는 어깨너머로 보이면 안 되니 글자를 가린다.
     type=password 를 쓰면 크롬이 비밀번호로 착각해 자동완성을 밀어 넣는다. */
  .key-in{-webkit-text-security:disc;text-security:disc}
  .zn-list{border:1px solid var(--bdr,#E9E0CF);border-radius:10px;overflow:hidden;margin-bottom:10px}
  .zn-row{display:flex;align-items:center;gap:9px;padding:10px 13px;font-size:14px;
    border-top:1px solid var(--bdr,#F0EADC)}
  .zn-row:first-child{border-top:0}
  .zn-now{font-size:11px;font-weight:700;color:#2F7A55;background:#E8F0EA;
    border-radius:100px;padding:2px 9px}
  .zn-add{display:flex;gap:8px;align-items:stretch}
  .zn-add .fi{flex:1;margin:0}
  .zn-add button{flex:0 0 auto;white-space:nowrap;padding:0 18px;cursor:pointer}
  @media(max-width:480px){ .zn-add{flex-direction:column} }
</style>

<script>
(function () {
  /* 눈에 보이는 칸(oaKey)의 값을 저장 직전에 hidden(openai_key)으로 옮긴다.
     보이는 칸에는 name 을 안 붙여 두어 크롬이 비밀번호 칸으로 보지 않는다. */
  var vis = document.getElementById('oaKey');
  var real = document.getElementById('oaKeyReal');
  if (vis && real) {
    var f = vis.closest('form');
    if (f) f.addEventListener('submit', function () { real.value = vis.value.trim(); });
  }
})();

(function () {
  var btn = document.getElementById('znBtn');
  var key = document.getElementById('znKey');
  var msg = document.getElementById('znMsg');
  if (!btn || !key) return;

  btn.addEventListener('click', async function () {
    var v = (key.value || '').trim();
    if (!v) { msg.textContent = 'Zernio 열쇠를 넣어주세요.'; return; }
    btn.disabled = true; btn.textContent = '연결하는 중...';
    msg.textContent = '';
    try {
      var r = await fetch('/api/threads/accounts/connect', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: v }),
      });
      var d = await r.json();
      if (!d.ok) throw new Error((d.error || '연결하지 못했습니다.') + (d.hint ? ' — ' + d.hint : ''));
      key.value = '';
      msg.textContent = d.message + ' 새로고침하면 목록에 나옵니다.';
      setTimeout(function () { location.reload(); }, 1200);
    } catch (e) {
      msg.textContent = e.message;
    }
    btn.disabled = false; btn.textContent = '계정 연결';
  });
})();
</script>

  <div class="settings-block">
    <h2 class="section-h">입금 계좌 안내
      <% if (user.bank_account) { %><span class="key-ok">사용 중 ✓</span><% } %>
    </h2>
    <p class="block-desc">
      유료 신청이 접수되면 <b>신청 완료 화면에 이 계좌가 바로 뜹니다.</b>
      신청한 상품의 금액도 자동으로 함께 표시됩니다.<br>
      비워두면 계좌 안내가 나오지 않고 기존 완료 문구만 보입니다.
    </p>

    <label class="fl">은행</label>
    <input class="fi" type="text" name="bank_name" value="<%= user.bank_name || '' %>" placeholder="예: 국민은행">

    <label class="fl">계좌번호</label>
    <input class="fi" type="text" name="bank_account" value="<%= user.bank_account || '' %>"
           inputmode="numeric" placeholder="예: 123456-01-234567">

    <label class="fl">예금주</label>
    <input class="fi" type="text" name="bank_holder" value="<%= user.bank_holder || '' %>" placeholder="예: 홍길동">

    <label class="fl">추가 안내 문구 (선택)</label>
    <textarea class="fi" name="bank_notice" rows="3"
              placeholder="예: 입금자명은 신청하신 분 성함으로 부탁드립니다. 확인되는 대로 작업을 시작합니다."><%= user.bank_notice || '' %></textarea>
    <p class="hint">비워두면 기본 안내 문구가 자동으로 들어갑니다.</p>
  </div>

  <div class="settings-block">
    <h2 class="section-h">이메일 발송 설정
      <% if (mailReady) { %><span class="key-ok">사용 가능 ✓</span><% } %>
    </h2>

    <% if (!mailDomain) { %>
      <div class="warn-box" style="margin-bottom:16px">
        메일 발송이 아직 준비되지 않았습니다. 관리자에게 문의해주세요.
      </div>
    <% } else { %>
      <p class="block-desc">
        무료사주와 사주 리포트를 <b>내 이름으로</b> 보냅니다. 별도 가입이나 비용 없이 바로 사용할 수 있습니다.
      </p>

      <!-- 발신 미리보기 -->
      <div class="mail-preview">
        <div class="mp-label">받는 사람에게 이렇게 보입니다</div>
        <div class="mp-box">
          <b id="pvName"><%= user.mail_name || user.site_name || user.name || '사주 풀이' %></b>
          <span id="pvAddr">&lt;<%= (user.mail_local || 'noreply') %>@<%= mailDomain %>&gt;</span>
        </div>
      </div>

      <label class="fl">발신인 이름</label>
      <input class="fi" type="text" id="mailNameInput" name="mail_name"
             value="<%= user.mail_name || '' %>" placeholder="<%= user.site_name || '예: 운명삼문' %>">
      <p class="hint">받는 사람 메일함에 <b>크게 표시되는 이름</b>입니다.</p>

