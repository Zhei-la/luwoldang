<%- include('../partials/dash-top', { user: user, active: active, title: '교육생 자료집' }) %>

<style>
  /* 위쪽 버튼 줄 — 머리말 바로 아래에 붙어 화면을 내려도 계속 보인다 */
  /* 머리말 바로 아래에 이어 붙는 줄 — 두 겹처럼 보이지 않게
     머리말과 같은 바탕을 쓰고, 글씨만 있는 버튼으로 가볍게 둔다. */
  .gv-bar {
    position:sticky; top:57px; z-index:25;
    display:flex; align-items:center; gap:2px;
    max-width:1100px; margin:0 auto 22px; padding:0;
    background:transparent; border-bottom:1px solid var(--beige);
  }
    .gv-bar a,   .gv-bar button {
    padding:11px 10px; border:0; background:none; border-radius:0;
    font-size:13.5px; font-weight:700; color:#8A8574; text-decoration:none;
    cursor:pointer; font-family:inherit; white-space:nowrap;
    border-bottom:2px solid transparent;
  }
    .gv-bar a:hover,   .gv-bar button:hover { color:var(--ink); }
    .gv-bar .edit { color:#8A6F3C; }
    .gv-bar .edit:hover { color:#8A6F3C; border-bottom-color:var(--gold); }
    .gv-bar .sp { flex:1; }

  @media (max-width:760px) {
    .gv-bar { top:53px; margin:0 auto 16px; }
    .gv-bar a, .gv-bar button { padding:10px 6px; font-size:13px; }
  }

  .gv-head { max-width:1100px; margin-left:auto; margin-right:auto; border-bottom:1px solid var(--beige); padding-bottom:16px; margin-bottom:22px; }
  .gv-head h1 { font-family:"Nanum Myeongjo", serif; font-size:25px; line-height:1.4;
    margin:0 0 10px; word-break:keep-all; }
  .gv-meta { font-size:12px; color:#9A9384; display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
  .gv-tag { background:#F4EFE3; color:#8A6F3C; padding:3px 9px; border-radius:5px; font-weight:600; }

  /* 본문 — 읽기 편한 폭과 줄간격 */
  /* 본문은 흰 종이처럼 — 베이지 배경 위에서는 캡처와 글이 잘 안 보인다 */
  .gv-body {
    max-width:1100px; margin:0 auto; font-size:16px; line-height:1.85; color:var(--ink); word-break:keep-all;
    background:#fff; border:1px solid var(--beige); border-radius:16px;   /* 본문은 늘 흰 종이 */
    padding:34px 38px; box-shadow:0 2px 10px rgba(24,34,52,.04);
  }
  @media (max-width:760px) {
    .gv-body { padding:22px 18px; border-radius:12px; }
  }
  .gv-body h2 { font-family:"Nanum Myeongjo", serif; font-size:21px; margin:34px 0 12px;
    padding-bottom:8px; border-bottom:1px solid var(--beige); }
  .gv-body h3 { font-size:17.5px; margin:26px 0 10px; color:#8A6F3C; }
  .gv-body h4 { font-size:16px; margin:20px 0 8px; }
  .gv-body p { margin:0 0 15px; }
  .gv-body ul, .gv-body ol { margin:0 0 15px; padding-left:22px; }
  .gv-body li { margin-bottom:6px; }
  .gv-body blockquote { margin:0 0 16px; padding:13px 16px; background:#FBF8F1;
    border-left:3px solid var(--gold); border-radius:0 8px 8px 0; }
  .gv-body blockquote p { margin:0; font-size:15px; color:#4A4438; }
  .gv-body pre { background:#F4EFE3; border:1px solid var(--beige); border-radius:10px;
    padding:14px 16px; margin:0 0 16px; white-space:pre-wrap; word-break:break-all;
    font-size:14.5px; line-height:1.75; font-family:inherit; color:#252522; }
  .gv-body code { background:#F4EFE3; padding:2px 6px; border-radius:4px; font-size:14px; }
  .gv-body hr { border:0; border-top:1px solid var(--beige); margin:28px 0; }
  .gv-body a { color:#3B6EA5; }
    .gv-body table { width:100%; border-collapse:collapse; margin:0 0 16px; font-size:14.5px; }
    .gv-body th,   .gv-body td { border:1px solid var(--beige); padding:9px 12px; text-align:left;
    word-break:keep-all; vertical-align:top; }
    .gv-body th { background:#F4EFE3; font-weight:700; }
  .gv-body figure { margin:0 0 18px; }
  .gv-body img { max-width:100%; height:auto; display:block; border-radius:10px;
    border:1px solid var(--beige); }
  /* 사진 크기 — 세로로 긴 휴대폰 캡처가 화면을 다 차지하지 않도록 기본을 중간으로 둔다 */
  /* 사진 크기 — 화면 폭도 함께 따진다.
     px 만 쓰면 폰에서 화면 밖으로 넘쳐서 '중간'이 '크게'보다 커 보인다. */
  .gv-body figure img { max-width:min(420px, 80%); }
  .gv-body figure.sz-s img { max-width:min(240px, 55%); }
  .gv-body figure.sz-m img { max-width:min(420px, 80%); }
  .gv-body figure.sz-l img { max-width:100%; }

  /* 정렬 */
  .gv-body .al-c { text-align:center; }
  .gv-body .al-r { text-align:right; }
  .gv-body .al-l { text-align:left; }
  .gv-body figure.al-c img { margin-left:auto; margin-right:auto; }
  .gv-body figure.al-r img { margin-left:auto; margin-right:0; }
  .gv-body strong { font-weight:800; }
  /* 복사상자 — 글 전체 복사는 막혀 있으므로 여기만 버튼으로 복사하게 한다 */
    .gv-body .cbx { position:relative; }
    .gv-body .cbx pre { margin:0; padding-top:40px; }
    .gv-body .cbx-btn {
    position:absolute; top:8px; right:8px; z-index:2;
    padding:6px 13px; border:1px solid var(--beige); background:var(--card);
    border-radius:8px; font-size:12.5px; font-weight:700; color:#6B6656;
    cursor:pointer; font-family:inherit;
    -webkit-user-select:none; user-select:none;
  }
    .gv-body .cbx-btn:hover { border-color:var(--gold); color:#8A6F3C; }
    .gv-body .cbx-btn.done { background:var(--gold); border-color:var(--gold); color:#fff; }

  .gv-foot { max-width:1100px; margin-left:auto; margin-right:auto; margin-top:36px; padding-top:18px; border-top:1px solid var(--beige);
    display:flex; gap:8px; flex-wrap:wrap; }
  .gv-btn { padding:11px 18px; border:1px solid var(--beige); background:var(--card); border-radius:10px;
    font-size:14px; font-weight:600; color:#6B6656; text-decoration:none; }
  .gv-btn.main { background:var(--navy); border-color:var(--navy); color:#fff; }

  /* ── 복사 막기 ──
     완벽하지는 않지만 긁어가는 대부분을 막는다. */
  .lock .gv-body {
    -webkit-user-select:none; -moz-user-select:none; -ms-user-select:none; user-select:none;
    -webkit-touch-callout:none;   /* 폰에서 길게 눌러도 복사 메뉴가 안 뜨게 */
  }
  .lock .gv-body img { -webkit-user-drag:none; user-drag:none; }
  /* ── 사진 크게 보기 ──
     워터마크(z-index 9999)보다 아래에 두어, 크게 봐도 이름이 계속 남는다. */
    .gv-body figure img { cursor:zoom-in; }
  .lbox { display:none; position:fixed; inset:0; z-index:9000;
    background:rgba(20,16,10,.92); align-items:center; justify-content:center; padding:20px; }
  .lbox.on { display:flex; }
  .lbox img { max-width:100%; max-height:100%; width:auto; height:auto;
    border-radius:10px; box-shadow:0 10px 40px rgba(0,0,0,.5);
    -webkit-user-drag:none; user-drag:none; }
  .lbox .x { position:fixed; top:16px; right:16px; width:44px; height:44px; border-radius:50%;
    border:0; background:rgba(255,255,255,.16); color:#fff; font-size:24px; line-height:1;
    cursor:pointer; font-family:inherit; }
  .lbox .x:hover { background:rgba(255,255,255,.3); }
  .lbox .hint { position:fixed; bottom:18px; left:50%; transform:translateX(-50%);
    font-size:12.5px; color:rgba(255,255,255,.6); }

  /* 인쇄나 PDF 저장으로 빼가는 것도 막는다 */
  @media print {
    .lock .gv-body, .lock .gv-head { display:none !important; }
    .lock .print-warn { display:block !important; font-size:18px; padding:40px; text-align:center; }
  }
  .print-warn { display:none; }

  /* ── 화면에 고정되는 이름 ──
     화면 전체가 아니라 '본문 영역'을 기준으로 잡는다.
     그러지 않으면 넓은 화면에서 창 맨 끝으로 밀려난다.
     (사이드바 260px + 본문 최대 1000px) */
  .gv-marks {
    position:fixed; top:0; bottom:0;
    left:0; width:100vw;
    z-index:9999; pointer-events:none; user-select:none; overflow:hidden;
  }
  .gv-marks .m {
    position:absolute; white-space:nowrap;
    font-size:12.5px; font-weight:800; letter-spacing:.02em;
    color:rgba(70,60,42,.42);
    text-shadow:0 0 3px rgba(255,255,255,.9), 0 1px 0 rgba(255,255,255,.9);
  }
  /* 왼쪽 위 */
  .gv-marks .mL { top:118px; left:16px; }
  /* 오른쪽 세로 — 글자를 세로로 흐르게 해 잘리지 않는다 */
  .gv-marks .mR {
    top:50%; right:8px;
    writing-mode:vertical-rl; transform:translateY(-50%) rotate(180deg);
  }

  /* 글이 화면 폭을 다 쓰므로, 오른쪽 세로 워터마크가 놓일 자리를 비워둔다 */
  @media (min-width:769px) {
    .gv-stage { padding-right:30px; }
  }

  @media (max-width:768px) {
    .gv-marks { width:100vw; }
    .gv-marks .m { font-size:11px; }
    .gv-marks .mL { top:106px; left:10px; }
    .gv-marks .mR { right:4px; }
  }

  .gv-copyright { max-width:1100px; margin-left:auto; margin-right:auto; margin-top:26px; padding:14px 16px; background:#FBF8F1;
    border:1px solid var(--beige); border-radius:10px; font-size:12.5px; color:#6B6656;
    line-height:1.75; word-break:keep-all; }
</style>

<div class="gv-bar">
  <a href="/guide">← 목록</a>
  <% if (user.role === 'admin') { %>
    <a href="/admin/guide/edit/<%= post.id %>" class="edit">수정하기</a>
    <a href="/admin/guide">관리</a>
  <% } %>
</div>

<% if (lock) { %>
<script>
(function () {
  document.body.classList.add('lock');

  /* ── 복사·저장 막기 ── */
  var body = document.querySelector('.gv-body');

  function stop(e) { e.preventDefault(); return false; }
  if (body) {
    body.addEventListener('copy', stop);
    body.addEventListener('cut', stop);
    body.addEventListener('dragstart', stop);
    body.addEventListener('selectstart', stop);
  }
  document.addEventListener('contextmenu', function (e) {
    if (e.target.closest('.gv-body')) stop(e);
  });

  document.addEventListener('keydown', function (e) {
    var k = (e.key || '').toLowerCase();
    /* 복사·전체선택·저장·인쇄·소스보기 */
    if ((e.ctrlKey || e.metaKey) && ['c', 'x', 'a', 's', 'p', 'u'].indexOf(k) > -1) return stop(e);
    /* 개발자 도구 */
    if (k === 'f12') return stop(e);
    if ((e.ctrlKey || e.metaKey) && e.shiftKey && ['i', 'j', 'c'].indexOf(k) > -1) return stop(e);
  });
})();
</script>
<% } %>

<div class="gv-head">
  <h1><%= post.title %></h1>
  <div class="gv-meta">
    <% if (post.cat_name) { %><span class="gv-tag"><%= post.cat_name %></span><% } %>
    <span><%= new Date(post.created_at).toLocaleDateString('ko-KR') %></span>
    <span><%= post.views %>번 읽음</span>
    <% if (!post.published) { %><span style="color:#A8332B;font-weight:700">비공개</span><% } %>
  </div>
</div>

<div class="gv-marks" aria-hidden="true">
  <span class="m mL"><%= markShort %></span>
  <span class="m mR"><%= mark %></span>
</div>

<div class="gv-stage">
  <div class="gv-body">
    <%- bodyHtml %>
  </div>
</div>

<div class="print-warn">이 자료는 인쇄할 수 없습니다.</div>

<script>
(function () {
  /* 복사상자에 복사 버튼을 붙인다.
     글 전체는 복사를 막아두었지만, 이 상자는 교육생이 그대로 쓰라고 만든 것이다. */
  var box = document.querySelector('.gv-body');
  if (!box) return;

  [].forEach.call(box.querySelectorAll('pre'), function (pre) {
    if (pre.parentNode.classList.contains('cbx')) return;

    var wrap = document.createElement('div');
    wrap.className = 'cbx';
    pre.parentNode.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'cbx-btn';
    btn.textContent = '복사';
    wrap.appendChild(btn);

    btn.addEventListener('click', async function (e) {
      e.stopPropagation();
      var txt = pre.innerText || pre.textContent || '';
      var ok = false;

      if (navigator.clipboard && window.isSecureContext) {
        try { await navigator.clipboard.writeText(txt); ok = true; } catch (err) {}
      }
      if (!ok) {
        /* 옛 브라우저·아이폰 대비 — 글 영역 밖에 임시 칸을 만들어 복사한다 */
        try {
          var ta = document.createElement('textarea');
          ta.value = txt;
          ta.setAttribute('readonly', '');
          ta.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0';
          document.body.appendChild(ta);
          ta.contentEditable = 'true'; ta.readOnly = false;
          var r = document.createRange(); r.selectNodeContents(ta);
          var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
          ta.setSelectionRange(0, txt.length); ta.focus();
          ok = document.execCommand('copy');
          ta.remove();
          window.getSelection().removeAllRanges();
        } catch (err) {}
      }

      btn.textContent = ok ? '복사했어요 ✓' : '복사 실패';
      btn.classList.toggle('done', ok);
      setTimeout(function () {
        btn.textContent = '복사'; btn.classList.remove('done');
      }, 1600);
    });
  });
})();
</script>

<script>
(function () {
  /* 사진을 누르면 크게 보여준다. 다시 누르면 닫힌다. */
  var body = document.querySelector('.gv-body');
  if (!body) return;

  var box = document.createElement('div');
  box.className = 'lbox';
  box.innerHTML = '<img alt=""><button type="button" class="x" aria-label="닫기">&times;</button>' +
                  '<span class="hint">아무 곳이나 누르면 닫힙니다</span>';
  document.body.appendChild(box);
  var big = box.querySelector('img');

  function open(src) {
    big.src = src;
    box.classList.add('on');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    box.classList.remove('on');
    big.src = '';
    document.body.style.overflow = '';
  }

  body.addEventListener('click', function (e) {
    var img = e.target.closest('figure img');
    if (!img || !img.getAttribute('src')) return;
    e.preventDefault();
    open(img.getAttribute('src'));
  });

  box.addEventListener('click', close);
  box.addEventListener('contextmenu', function (e) { e.preventDefault(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && box.classList.contains('on')) close();
  });
})();
</script>

<div class="gv-copyright">
  이 자료의 저작권은 루월당에 있습니다. 정식 등록된 교육생 본인만 이용하실 수 있으며,
  캡처·복사·공유·재배포·2차 가공을 금합니다.
  위반 시 저작권법 제136조에 따라 5년 이하의 징역 또는 5천만원 이하의 벌금에 처해질 수 있습니다.
  <% if (lock) { %>
    <br><b>이 화면에는 <%= user.name %> 님의 정보가 표시되어 있으며, 열람 기록이 남습니다.</b>
  <% } %>
</div>

<div class="gv-foot">
  <a href="/guide" class="gv-btn">목록으로</a>
  <% if (user.role === 'admin') { %>
    <a href="/admin/guide/edit/<%= post.id %>" class="gv-btn main">이 글 고치기</a>
  <% } %>
</div>

