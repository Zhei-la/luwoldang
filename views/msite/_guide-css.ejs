<style>
  .eyebrow{display:block;font-size:12px;letter-spacing:.12em;color:var(--gold-d);
    font-weight:800;margin:0 0 9px}
  .eyebrow a{color:inherit;text-decoration:none}
  .eyebrow a:hover{text-decoration:underline}
  .sec-t{font-size:19px;font-weight:800;margin:0 0 10px;line-height:1.45}
  .sec-lead{font-size:14px;color:var(--dim);margin:0 0 14px}
  .sub-t{font-size:14px;font-weight:800;margin:16px 0 5px;color:var(--gold-d)}
  .bd{font-size:14.5px;line-height:1.9;margin:0;color:var(--ink2)}
  .tiny{font-size:12.5px;color:var(--faint)}
  .tiny a{color:var(--gold-d);font-weight:700}

  /* 천간·지지 타일 */
  .pair{display:flex;gap:10px;margin-bottom:18px}
  .pair .col{flex:1;text-align:center}
  .pair .lb{font-size:11px;letter-spacing:.06em;color:var(--faint);font-weight:700;margin-bottom:5px}
  .pair .tile{border-radius:12px;padding:14px 0;font-size:34px;font-weight:800;
    line-height:1.1;font-family:serif}
  .pair .ko{font-size:12.5px;color:var(--dim);margin-top:5px}
  .tile.mok{background:var(--mok-bg);color:var(--mok)}
  .tile.hwa{background:var(--hwa-bg);color:var(--hwa)}
  .tile.to{background:var(--to-bg);color:var(--to)}
  .tile.geum{background:var(--geum-bg);color:var(--geum)}
  .tile.su{background:var(--su-bg);color:var(--su)}

  /* 목록 */
  .list{display:flex;flex-direction:column;gap:8px}
  .list .it{display:flex;align-items:baseline;gap:10px;background:var(--card);
    border:1px solid var(--line);border-radius:11px;padding:12px 14px;
    text-decoration:none;color:inherit}
  .list .it:hover{border-color:var(--gold)}
  .list .gz{font-size:15px;font-weight:800;flex:none}
  .list .al{font-size:13.5px;color:var(--gold-d);font-weight:700;flex:none}
  .list .tg{font-size:12.5px;color:var(--faint);overflow:hidden;
    text-overflow:ellipsis;white-space:nowrap}

  /* 60갑자를 열 개씩 묶어 보여준다 */
  .grp{margin-bottom:22px}
  .grp h3{font-size:15px;font-weight:800;margin:0 0 9px;color:var(--ink)}
  .grp h3 small{font-weight:600;color:var(--faint);font-size:12.5px;margin-left:6px}

  /* 돌아오기 칸 */
  .backbox{border:1px solid var(--gold);border-radius:15px;background:var(--card);
    padding:24px 20px;text-align:center}
  .backbox h3{font-size:18px;font-weight:800;margin:0 0 8px}
  .backbox p{font-size:14px;color:var(--dim);margin:0 0 16px;line-height:1.85}
  .backbox .btn{display:inline-block;width:auto;padding:13px 26px;background:var(--gold);
    color:#fff;border-radius:11px;font-weight:800;text-decoration:none}

  /* 위쪽 차림표 */
  .mnav{border-bottom:1px solid var(--line);background:var(--card)}
  .mnav .wrap{display:flex;gap:16px;padding-top:11px;padding-bottom:11px;overflow-x:auto;
    -webkit-overflow-scrolling:touch}
  .mnav a{font-size:13.5px;font-weight:700;color:var(--dim);text-decoration:none;
    white-space:nowrap}
  .mnav a:hover{color:var(--gold-d)}

  /* 개념 해설 글 */
  .art h2{font-size:17px;font-weight:800;margin:26px 0 9px;color:var(--ink)}
  .art h2:first-child{margin-top:0}
  .art p{font-size:15px;line-height:1.95;color:var(--ink2);margin:0 0 14px}
  .art ul{margin:0 0 14px;padding:0;list-style:none}
  .art li{font-size:14.5px;line-height:1.9;color:var(--ink2);padding-left:15px;
    position:relative;margin-bottom:8px}
  .art li:before{content:'·';position:absolute;left:3px;color:var(--gold);font-weight:800}

  /* 일간 열 개 */
  .chips{display:grid;grid-template-columns:repeat(auto-fill,minmax(84px,1fr));gap:8px}
  .chip{display:block;text-align:center;padding:12px 8px;border:1px solid var(--line);
    border-radius:11px;background:var(--card);text-decoration:none}
  .chip b{display:block;font-size:17px;font-family:serif;font-weight:800}
  .chip span{display:block;font-size:11px;color:var(--faint);margin-top:3px}
  .chip:hover{border-color:var(--gold)}
  .chip.mok b{color:var(--mok)} .chip.hwa b{color:var(--hwa)} .chip.to b{color:var(--to)}
  .chip.geum b{color:var(--geum)} .chip.su b{color:var(--su)}
</style>
