<%
  var EL = { 목:'mok', 화:'hwa', 토:'to', 금:'geum', 수:'su' };
  var c = consult;
  var 기둥 = ['년', '월', '일', '시'];
%>
<%- include('_head', {
  siteName: siteName, themeVars: themeVars, base: base,
  pageTitle: (reading.alias ? reading.alias + ' · ' : '') + siteName,
  pageDesc: reading.tagline || '내 사주 원국과 오늘의 운세를 무료로 봅니다.',
}) %>

<style>
  .eyebrow{display:block;font-size:11.5px;letter-spacing:.12em;color:var(--gold-d);
    font-weight:800;margin:0 0 6px}
  .sec-t{font-size:19px;font-weight:800;margin:0 0 12px;line-height:1.45}

  .hero{padding:26px 0 8px}
  .hero .al{font-size:13px;letter-spacing:.1em;color:var(--gold-d);font-weight:800;margin:0 0 6px}
  .hero h1{font-size:26px;margin:0 0 9px}
  .hero .tg{font-size:15px;color:var(--dim);margin:0}
  .hero .bt{font-size:12.5px;color:var(--faint);margin:12px 0 0}

  /* 원국 */
  .wg-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:0 -20px;padding:0 20px}
  table.wg{width:100%;min-width:344px;border-collapse:separate;border-spacing:5px 0}
  table.wg th{font-size:11.5px;color:var(--faint);font-weight:700;padding:0 0 7px;text-align:center}
  table.wg td{text-align:center;vertical-align:top}
  .gz{border-radius:12px;padding:11px 4px}
  /* 한자를 못 읽는 분도 한글만 보고 알 수 있게, 한글을 조금 키우고
     한자는 조금 줄여 둘의 차이를 좁혔다. */
  .rd-more{margin:22px 0 0;padding:16px 17px;border-radius:12px;
    background:var(--line2);font-size:14px;line-height:1.9;color:var(--dim)}
  .rd-more b{color:var(--ink2)}
  .gz .h{font-size:27px;font-weight:800;line-height:1.15;font-family:serif}
  .gz .k{font-size:14px;font-weight:700;margin-top:3px;opacity:.95}
  .gz .t{font-size:11.5px;margin-top:5px;font-weight:700;opacity:.9}
  .gz .t .me{display:inline-block;margin-left:4px;padding:0 5px;border-radius:100px;
    background:var(--gold);color:#fff;font-size:10px;font-weight:800;vertical-align:1px}
  .gz.mok{background:var(--mok-bg);color:var(--mok)}
  .gz.hwa{background:var(--hwa-bg);color:var(--hwa)}
  .gz.to{background:var(--to-bg);color:var(--to)}
  .gz.geum{background:var(--geum-bg);color:var(--geum)}
  .gz.su{background:var(--su-bg);color:var(--su)}
  .gz.non{background:var(--line2);color:var(--faint)}
  .gz.day{outline:2px solid var(--gold);outline-offset:1px}
  .wg .gap{height:6px}
  .wg .jj{font-size:11px;color:var(--faint);line-height:1.7;padding-top:7px}
  .hero .jn{margin-top:7px;line-height:1.75}
  .hero .jn b{color:var(--ink2)}
  .wg .un{font-size:11px;color:var(--dim);padding-top:5px;font-weight:600}
  /* 줄 이름 칸 — 좁은 화면에서도 자리를 많이 안 먹게 */
  table.wg .rl{width:42px;min-width:42px;text-align:right;padding-right:2px;
    font-size:10px;color:var(--faint);font-weight:700;line-height:1.35;
    vertical-align:middle;white-space:nowrap}
  table.wg .rl span{font-weight:600;opacity:.85}
  table.wg th.rl{padding-bottom:7px}

  /* 오늘의 운세 */
  .td{background:linear-gradient(160deg,#2C2620,#3D352B);color:#fff;border-radius:15px;
    padding:22px 20px;margin-bottom:14px}
  .td .dl{font-size:12px;color:#C9BFAE;margin:0 0 3px}
  .td .gz2{font-size:13px;color:#C9BFAE;margin:0 0 14px}
  .td .band{display:flex;align-items:baseline;gap:9px;margin-bottom:12px}
  .td .band b{font-size:26px;font-weight:800}
  .td .band span{font-size:13px;color:#C9BFAE}
  .td .bar{height:7px;border-radius:100px;background:rgba(255,255,255,.16);overflow:hidden;
    margin-bottom:14px}
  .td .bar i{display:block;height:100%;border-radius:100px;background:#C9A469}
  .td p{color:#EDE7DC;margin:0 0 12px;font-size:14.5px;line-height:1.85}
  .td .lucky{display:flex;gap:7px;flex-wrap:wrap;margin-top:14px}
  .td .lucky span{background:rgba(255,255,255,.1);border-radius:100px;padding:5px 12px;
    font-size:12.5px;color:#EDE7DC}

  /* 오행 막대 */
  .els{display:flex;flex-direction:column;gap:9px}
  .el{display:flex;align-items:center;gap:10px}
  .el .n{width:22px;font-size:14px;font-weight:800;flex:none;text-align:center}
  .el .b{flex:1;height:9px;background:var(--line2);border-radius:100px;overflow:hidden}
  .el .b i{display:block;height:100%;border-radius:100px}
  .el .v{width:66px;font-size:12px;color:var(--faint);text-align:right;flex:none}
  .el.mok .n{color:var(--mok)}  .el.mok .b i{background:var(--mok)}
  .el.hwa .n{color:var(--hwa)}  .el.hwa .b i{background:var(--hwa)}
  .el.to  .n{color:var(--to)}   .el.to  .b i{background:var(--to)}
  .el.geum .n{color:var(--geum)} .el.geum .b i{background:var(--geum)}
  .el.su  .n{color:var(--su)}   .el.su  .b i{background:var(--su)}

  .kv{display:flex;flex-wrap:wrap;gap:7px}
  .kv span{background:var(--bg);border:1px solid var(--line2);border-radius:100px;
    padding:5px 12px;font-size:12.5px;color:var(--ink2)}
  .kv span b{color:var(--ink)}
  .kv span.on{background:var(--navy);color:var(--card);border-color:var(--navy)}
  .kv span.on b{color:var(--card)}

  /* 신살 */
  .sal{display:flex;flex-direction:column;gap:10px}
  .sal .row{display:flex;gap:10px;align-items:flex-start}
  .sal .k{flex:none;width:34px;font-size:12px;font-weight:800;color:var(--faint);padding-top:5px}
  .sal .v{display:flex;flex-wrap:wrap;gap:6px}
  .sal .v span{background:var(--bg);border:1px solid var(--line2);border-radius:7px;
    padding:4px 10px;font-size:12.5px;color:var(--ink2)}
  .sal .v span.none{color:var(--faint);border-style:dashed}

  /* 흐름 표 */
  .flow{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:0 -20px;padding:0 20px}
  .flow .in{display:flex;gap:7px;padding-bottom:4px}
  .flow .cell{flex:none;width:72px;border:1px solid var(--line);border-radius:11px;
    padding:10px 6px;text-align:center;background:var(--card)}
  .flow .cell.on{border-color:var(--gold);background:var(--bg)}
  .flow .cell .w{font-size:11px;color:var(--faint);font-weight:700}
  .flow .cell .g{font-size:16px;font-weight:800;margin:4px 0 3px}
  .flow .cell .s{font-size:10.5px;color:var(--dim);line-height:1.5}
  .flow .cell.on .w{color:var(--gold-d)}

  .blk{border-top:1px solid var(--line2);padding-top:16px;margin-top:16px}
  .blk:first-of-type{border-top:0;padding-top:0;margin-top:0}
  .blk .no{font-size:11px;letter-spacing:.12em;color:var(--gold-d);font-weight:800}
  .blk h3{font-size:16px;font-weight:800;margin:3px 0 8px}
  .blk .bd{font-size:14.5px;color:var(--ink2);line-height:1.9}
  .blk .bd b{color:var(--ink)}

  /* 이어지는 곳 — 여기서부터는 사람이 읽어야 한다 */
  .more-box{background:var(--card);border:1px solid var(--line);border-radius:15px;
    padding:22px 20px;margin-bottom:14px;position:relative;overflow:hidden}
  .more-box .tz{font-size:14.5px;line-height:1.9;color:var(--dim);margin:0;
    max-height:96px;overflow:hidden;position:relative}
  .more-box .tz:after{content:'';position:absolute;left:0;right:0;bottom:0;height:56px;
    background:linear-gradient(to bottom,transparent,var(--card))}
  /* 신청칸은 색마다 따로 정해둔 색을 쓴다.
     var(--navy) 를 그냥 쓰면 「밤」에서 금색 위에 금색이 돼 아무것도 안 보인다. */
  .cta{background:var(--cta-bg);color:var(--cta-fg);border-radius:15px;padding:24px 20px;
    margin-bottom:14px}
  .cta h2{color:var(--cta-fg);font-size:19px;margin:0 0 9px;line-height:1.5}
  .cta p{color:var(--cta-fg);opacity:.72;font-size:14px;margin:0 0 16px;line-height:1.85}
  .cta ul{margin:0 0 18px;padding:0;list-style:none}
  .cta li{color:var(--cta-fg);opacity:.9;font-size:14px;padding-left:20px;position:relative;
    margin-bottom:7px}
  .cta li:before{content:'✓';position:absolute;left:0;color:var(--cta-ac);font-weight:800;opacity:1}
  .cta label{color:var(--cta-fg);opacity:.6}
  .cta input,.cta textarea{background:rgba(127,127,127,.14);
    border-color:rgba(127,127,127,.32);color:var(--cta-fg)}
  .cta input::placeholder,.cta textarea::placeholder{color:var(--cta-fg);opacity:.4}
  .cta .chk{color:var(--cta-fg);opacity:.8}
  .cta .chk b{opacity:1}
  .cta .chk input{accent-color:var(--cta-ac)}
  .cta .fine{font-size:12px;color:var(--cta-fg);opacity:.5;line-height:1.8;margin:12px 0 0}
  .cta .btn.gold{background:var(--cta-ac);color:var(--cta-ac-fg)}
  /* 신청란 — 웹사이트 상담 신청과 같은 칸들 */
  .cta label i{color:var(--cta-ac);font-style:normal;opacity:1}
  .cta select{width:100%;padding:12px 13px;border-radius:10px;font-size:15px;font-family:inherit;
    background:rgba(127,127,127,.14);border:1px solid rgba(127,127,127,.32);color:var(--cta-fg)}
  .cta .g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px}
  .cta .seg{display:grid;grid-template-columns:1fr 1fr;gap:7px}
  .cta .seg.c3{grid-template-columns:1fr 1fr 1fr}
  .cta .seg label{display:block;margin:0;opacity:1}
  .cta .seg input{position:absolute;opacity:0;width:0;height:0}
  .cta .seg span{display:block;text-align:center;padding:11px 4px;border-radius:10px;
    border:1px solid rgba(127,127,127,.32);font-size:14.5px;font-weight:600;
    color:var(--cta-fg);opacity:.72;cursor:pointer}
  .cta .seg input:checked + span{background:var(--cta-ac);color:var(--cta-ac-fg);
    border-color:var(--cta-ac);opacity:1}
  .cta .chk.sm{margin-top:9px;font-size:13px}
  .cta .hint{font-size:12.5px;color:var(--cta-fg);opacity:.5;line-height:1.75;margin:6px 0 0}
  .cta .ptf{display:flex;flex-direction:column;gap:7px;margin-top:10px}
  .cta .ptf[hidden]{display:none}   /* display 를 준 칸은 hidden 이 안 먹는다 */
  .cta .ptw{margin-bottom:14px}

  /* 입금 계좌 안내 — 웹사이트 상담 신청과 같은 모양 */
  .cta .bk-done{font-size:15px;font-weight:700;color:var(--cta-fg);line-height:1.8;margin-bottom:14px}
  .cta .bk-card{background:rgba(127,127,127,.14);border:1px solid rgba(127,127,127,.32);
    border-radius:13px;padding:18px 17px}
  .cta .bk-hd{font-size:12px;font-weight:800;letter-spacing:.1em;color:var(--cta-ac);
    margin-bottom:14px}
  .cta .bk-amt{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 9px;
    padding-bottom:14px;margin-bottom:12px;border-bottom:1px solid rgba(127,127,127,.28)}
  .cta .bk-amt .lb{font-size:12.5px;color:var(--cta-fg);opacity:.6;width:100%}
  .cta .bk-amt .num{font-size:25px;font-weight:800;color:var(--cta-ac)}
  .cta .bk-amt .pd{font-size:13px;color:var(--cta-fg);opacity:.7}
  .cta .bk-row{display:flex;align-items:center;gap:9px;margin-bottom:9px;font-size:14.5px}
  .cta .bk-row .k{flex:0 0 62px;font-size:12.5px;color:var(--cta-fg);opacity:.55}
  .cta .bk-row .v{color:var(--cta-fg);font-weight:700;word-break:break-all}
  .cta .bk-row .v.acc{font-size:16px;letter-spacing:.02em}
  .cta .bk-copy{flex:none;margin-left:auto;padding:6px 12px;border-radius:8px;
    border:1px solid rgba(127,127,127,.4);background:transparent;color:var(--cta-fg);
    font-size:12.5px;font-weight:700;font-family:inherit;cursor:pointer}
  .cta .bk-copy:hover{border-color:var(--cta-ac);color:var(--cta-ac)}
  /* 입금 계좌 팝업 — 한눈에 들어오게 화면 위에 띄운다 */
  .bkpop{position:fixed;inset:0;z-index:120;background:rgba(20,16,12,.62);
    display:flex;align-items:center;justify-content:center;padding:20px;
    overflow-y:auto;-webkit-overflow-scrolling:touch}
  .bkpop-in{position:relative;width:100%;max-width:400px;margin:auto;
    background:var(--cta-bg);color:var(--cta-fg);border-radius:17px;
    padding:26px 20px 20px;box-shadow:0 18px 50px rgba(0,0,0,.45)}
  .bkpop-x{position:absolute;top:10px;right:10px;width:36px;height:36px;
    border:0;border-radius:50%;background:rgba(127,127,127,.2);color:var(--cta-fg);
    font-size:22px;line-height:1;cursor:pointer;font-family:inherit}
  .bkpop-x:hover{background:rgba(127,127,127,.34)}
  .bkpop-done{font-size:15.5px;font-weight:800;line-height:1.75;margin:0 30px 16px 0;
    color:var(--cta-fg)}
  /* 팝업 안에서도 카드 모양이 그대로 나오게 */
  .bkpop .bk-card{background:rgba(127,127,127,.14);border:1px solid rgba(127,127,127,.32);
    border-radius:13px;padding:18px 17px}
  .bkpop .bk-hd{font-size:12px;font-weight:800;letter-spacing:.1em;color:var(--cta-ac);margin-bottom:14px}
  .bkpop .bk-amt{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 9px;
    padding-bottom:14px;margin-bottom:12px;border-bottom:1px solid rgba(127,127,127,.28)}
  .bkpop .bk-amt .lb{font-size:12.5px;opacity:.6;width:100%}
  .bkpop .bk-amt .num{font-size:27px;font-weight:800;color:var(--cta-ac)}
  .bkpop .bk-amt .pd{font-size:13px;opacity:.7}
  .bkpop .bk-row{display:flex;align-items:center;gap:9px;margin-bottom:9px;font-size:14.5px}
  .bkpop .bk-row .k{flex:0 0 62px;font-size:12.5px;opacity:.55}
  .bkpop .bk-row .v{font-weight:700;word-break:break-all}
  .bkpop .bk-row .v.acc{font-size:16.5px;letter-spacing:.02em}
  .bkpop .bk-copy{flex:none;margin-left:auto;padding:6px 12px;border-radius:8px;
    border:1px solid rgba(127,127,127,.4);background:transparent;color:var(--cta-fg);
    font-size:12.5px;font-weight:700;font-family:inherit;cursor:pointer}
  .bkpop .bk-note{margin-top:12px;padding-top:12px;border-top:1px solid rgba(127,127,127,.28);
    font-size:13px;line-height:1.85;opacity:.72;word-break:keep-all}
  .bkpop .bk-ok{display:block;width:100%;margin-top:16px;padding:15px;border:0;
    border-radius:11px;background:var(--cta-ac);color:var(--cta-ac-fg);
    font-size:16px;font-weight:800;font-family:inherit;cursor:pointer}
  .cta .bk-ok{display:block;width:100%;margin-top:14px;padding:15px;border:0;
    border-radius:11px;background:var(--cta-ac);color:var(--cta-ac-fg);
    font-size:16px;font-weight:800;font-family:inherit;cursor:pointer}
  .cta .bk-stay{margin:12px 0 0;font-size:12.5px;line-height:1.85;
    color:var(--cta-fg);opacity:.55;text-align:center}
  .cta .bk-again{margin:14px 0 22px;padding:13px 15px;border-radius:11px;
    background:rgba(127,127,127,.12);border:1px dashed rgba(127,127,127,.34);
    font-size:13.5px;line-height:1.85;color:var(--cta-fg);opacity:.85;word-break:keep-all}
  .cta .bk-again b{opacity:1}
  .cta .bk-thanks{padding:22px 4px;text-align:center;font-size:15.5px;font-weight:700;
    line-height:1.9;color:var(--cta-fg)}
  .cta .bk-note{margin-top:12px;padding-top:12px;border-top:1px solid rgba(127,127,127,.28);
    font-size:13px;line-height:1.85;color:var(--cta-fg);opacity:.72;word-break:keep-all}
  .cta .err{background:rgba(200,60,40,.16);color:var(--cta-fg)}
  .cta .ok{background:rgba(60,160,100,.18);color:var(--cta-fg)}
</style>

<main class="wrap">
  <section class="hero">
    <% if (reading.alias) { %><p class="al"><%= reading.alias %></p><% } %>
    <h1><%= reading.tagline || ((name ? name + '님' : '이 사주') + '의 사주') %></h1>
    <% if (reading.iljuBody) { %><p class="tg"><%= reading.iljuBody %></p><% } %>
    <p class="bt"><%= name ? name + ' · ' : '' %><%= birthLabel %></p>
    <% if (typeof jasiNote !== 'undefined' && jasiNote) { %>
      <p class="bt jn">밤 11시 이후에 태어나셨습니다. 이 만세력은 <b>밤 11시부터를 다음 날</b>로 보고
        계산합니다. <a href="<%= base %>/guide/manseryeok">왜 그런가요</a></p>
    <% } %>
  </section>

  <% if (today) { %>
    <div class="td">
      <p class="dl">오늘의 운세 · <%= today.dateLabel %></p>
      <p class="gz2">오늘은 <b><%= today.ganzhi %></b> 일입니다<%= today.ganzhiHanja ? ' (' + today.ganzhiHanja + ')' : '' %></p>
      <div class="band">
        <b><%= today.band %></b>
        <span><%= today.score %>점 · <%= today.keyword %></span>
      </div>
      <div class="bar"><i style="width:<%= Math.max(4, Math.min(100, today.score)) %>%"></i></div>
      <% if (today.bandLine) { %><p><%= today.bandLine %></p><% } %>
      <% if (today.text) { %><p><%= today.text %></p><% } %>
      <% if (today.relText) { %><p><%= today.relText %></p><% } %>
      <% if (today.lucky) { %>
        <div class="lucky">
          <% if (today.lucky.color) { %><span>행운의 색 <b><%= today.lucky.color %></b></span><% } %>
          <% if (today.lucky.direction) { %><span>방위 <b><%= today.lucky.direction %></b></span><% } %>
          <% if (today.lucky.hour) { %><span>시간 <b><%= today.lucky.hour %></b></span><% } %>
          <% if (today.lucky.item) { %><span>지니면 좋은 것 <b><%= today.lucky.item %></b></span><% } %>
        </div>
      <% } %>
    </div>
  <% } %>

  <div class="card">
    <span class="eyebrow">원국</span>
    <h2 class="sec-t">만세력 원국</h2>
    <div class="wg-wrap">
      <%# 줄 이름을 왼쪽에 붙였다. 없으면 아래 작은 글씨 줄들이 무엇인지 알 수 없다. %>
      <table class="wg">
        <tr><th class="rl"></th><% wonguk.forEach(function(p){ %><th><%= p.key %>주</th><% }); %></tr>
        <tr>
          <td class="rl">천간</td>
          <% wonguk.forEach(function(p){ %>
            <td><div class="gz <%= p.unknown ? 'non' : (EL[p.stemElem] || '') %> <%= p.key === '일' ? 'day' : '' %>">
              <div class="h"><%= p.unknown ? '?' : p.stemHanja %></div>
              <div class="k"><%= p.unknown ? '모름' : p.stemKo %></div>
              <%# 엔진은 일간 자리에 십성 대신 「일간」이라고 적는다.
                  다른 만세력처럼 십성(비견)도 같이 보여준다 — 일간은 저와 같은
                  천간이니 십성으로는 늘 비견이다. 「나」는 그 옆에 작게 붙인다. %>
              <div class="t"><% if (!p.unknown) { %><%= p.stemTenGod === '일간' ? '비견' : p.stemTenGod %><% if (p.key === '일') { %><span class="me">나</span><% } %><% } %></div>
            </div></td>
          <% }); %>
        </tr>
        <tr><td class="gap" colspan="<%= wonguk.length + 1 %>"></td></tr>
        <tr>
          <td class="rl">지지</td>
          <% wonguk.forEach(function(p){ %>
            <td><div class="gz <%= p.unknown ? 'non' : (EL[p.branchElem] || '') %>">
              <div class="h"><%= p.unknown ? '?' : p.branchHanja %></div>
              <div class="k"><%= p.unknown ? '모름' : p.branchKo %></div>
              <div class="t"><%= p.unknown ? '' : p.branchTenGod %></div>
            </div></td>
          <% }); %>
        </tr>
        <tr>
          <td class="rl">지장간</td>
          <% wonguk.forEach(function(p){ %>
            <td class="jj"><% if (!p.unknown) { (p.jijanggan || []).forEach(function(j){ %><div><%= j %></div><% }); } %></td>
          <% }); %>
        </tr>
        <tr>
          <td class="rl">십이운성</td>
          <% wonguk.forEach(function(p){ %>
            <td class="un"><%= p.unknown ? '' : (p.unseong || '') %></td>
          <% }); %>
        </tr>
        <%# 원본 만세력이 보여주는 두 줄인데 여기서만 빠져 있었다.
            같은 십이신살을 년지 기준·일지 기준으로 각각 본 것이다. %>
        <% if (wonguk.some(function(p){ return p.yearSal; })) { %>
          <tr>
            <td class="rl">신살<br><span>사회·환경</span></td>
            <% wonguk.forEach(function(p){ %>
              <td class="un"><%= p.unknown ? '' : (p.yearSal || '') %></td>
            <% }); %>
          </tr>
        <% } %>
        <% if (wonguk.some(function(p){ return p.daySal; })) { %>
          <tr>
            <td class="rl">신살<br><span>내면·심리</span></td>
            <% wonguk.forEach(function(p){ %>
              <td class="un"><%= p.unknown ? '' : (p.daySal || '') %></td>
            <% }); %>
          </tr>
        <% } %>
      </table>
    </div>
    <div class="kv" style="margin-top:16px">
      <span>일간 <b><%= c.일간 %> (<%= c.일간오행 %>)</b></span>
      <span>일주 <b><%= c.일주 %></b></span>
      <span>격국 <b><%= c.격국 %></b></span>
      <% if (c.공망일 && c.공망일.length) { %><span>공망 <b><%= c.공망일.join('·') %></b></span><% } %>
    </div>
  </div>

  <% if (c.신살 || (c.합 && c.합.length) || (c.충형파해 && c.충형파해.length)) { %>
    <div class="card">
      <span class="eyebrow">신살</span>
      <h2 class="sec-t">신살과 관계</h2>
      <div class="sal">
        <% 기둥.forEach(function(k){ var v = (c.신살 || {})[k] || []; %>
          <div class="row">
            <span class="k"><%= k %>주</span>
            <span class="v">
              <% if (v.length) { v.forEach(function(x){ %><span><%= x %></span><% }); }
                 else { %><span class="none">없음</span><% } %>
            </span>
          </div>
        <% }); %>
        <% if (c.합 && c.합.length) { %>
          <div class="row"><span class="k">합</span>
            <span class="v"><% c.합.forEach(function(x){ %><span><%= x %></span><% }); %></span></div>
        <% } %>
        <% if (c.충형파해 && c.충형파해.length) { %>
          <div class="row"><span class="k">충형</span>
            <span class="v"><% c.충형파해.forEach(function(x){ %><span><%= x %></span><% }); %></span></div>
        <% } %>
      </div>
    </div>
  <% } %>

  <div class="card">
    <span class="eyebrow">오행</span>
    <h2 class="sec-t">오행과 십성</h2>
    <div class="els">
      <% reading.elements.forEach(function(e){ %>
        <div class="el <%= EL[e.name] || '' %>">
          <span class="n"><%= e.name %></span>
          <span class="b"><i style="width:<%= Math.max(2, e.pct) %>%"></i></span>
          <span class="v"><%= e.count %>개 · <%= e.state %></span>
        </div>
      <% }); %>
    </div>
    <% if (c.십성분포) { %>
      <div class="kv" style="margin-top:16px">
        <% Object.keys(c.십성분포).forEach(function(k){ %>
          <span><%= k %> <b><%= c.십성분포[k] %></b></span>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="card">
    <span class="eyebrow">신강·신약과 용신</span>
    <h2 class="sec-t">내 힘과, 나에게 이로운 기운</h2>
    <div class="kv">
      <span class="on"><b><%= c.신강약 %></b></span>
      <% if (c.득령) { %><span>득령 <b><%= c.득령 %></b></span><% } %>
      <% if (c.득지) { %><span>득지 <b><%= c.득지 %></b></span><% } %>
      <% if (c.득세) { %><span>득세 <b><%= c.득세 %></b></span><% } %>
    </div>
    <div class="kv" style="margin-top:9px">
      <span>용신 <b><%= c.용신 %></b></span>
      <% if (c.희신) { %><span>희신 <b><%= c.희신 %></b></span><% } %>
      <% if (c.기신) { %><span>기신 <b><%= c.기신 %></b></span><% } %>
      <% if (c.구신) { %><span>구신 <b><%= c.구신 %></b></span><% } %>
      <% if (c.한신) { %><span>한신 <b><%= c.한신 %></b></span><% } %>
      <% if (c.조후) { %><span>조후 <b><%= c.조후 %></b></span><% } %>
    </div>
  </div>

  <% if (c.대운목록 && c.대운목록.length) { %>
    <div class="card">
      <span class="eyebrow">대운</span>
      <h2 class="sec-t">십 년 단위의 큰 흐름</h2>
      <p style="font-size:13.5px;color:var(--dim);margin:0 0 13px">
        <%= c.대운수 %>세부터 <%= c.대운방향 %>합니다. 금색이 지금 지나고 있는 대운입니다.</p>
      <div class="flow"><div class="in">
        <% c.대운목록.forEach(function(d){ %>
          <div class="cell <%= d.현재 ? 'on' : '' %>">
            <div class="w"><%= d.나이 %>세</div>
            <div class="g"><%= d.간지 %></div>
            <div class="s"><%= d.천간십성 %><br><%= d.지지십성 %></div>
          </div>
        <% }); %>
      </div></div>
    </div>
  <% } %>

  <% if (c.세운목록 && c.세운목록.length) { %>
    <div class="card">
      <span class="eyebrow">세운</span>
      <h2 class="sec-t">해마다의 흐름</h2>
      <div class="flow"><div class="in">
        <% c.세운목록.forEach(function(d){ %>
          <div class="cell <%= d.현재 ? 'on' : '' %>">
            <div class="w"><%= d.년도 %></div>
            <div class="g"><%= d.간지 %></div>
            <div class="s"><%= d.천간십성 %><br><%= d.지지십성 %></div>
          </div>
        <% }); %>
      </div></div>
    </div>
  <% } %>

  <% if (wolun && wolun.length) { %>
    <div class="card">
      <span class="eyebrow">월운</span>
      <h2 class="sec-t">달마다의 흐름</h2>
      <div class="flow"><div class="in">
        <% wolun.forEach(function(d){ %>
          <div class="cell <%= d.현재 ? 'on' : '' %>">
            <div class="w"><%= d.월 %>월</div>
            <div class="g"><%= d.간지 %></div>
            <div class="s"><%= d.천간십성 %><br><%= d.지지십성 %></div>
          </div>
        <% }); %>
      </div></div>
    </div>
  <% } %>

  <% if ((reading.blocks || []).length) { %>
    <div class="card">
      <span class="eyebrow">풀어 쓴 해석</span>
      <h2 class="sec-t">사주 풀이</h2>
      <% reading.blocks.forEach(function(b){ %>
        <div class="blk">
          <div class="no"><%= b.no %></div>
          <h3><%= b.title %></h3>
          <div class="bd"><%- b.html %></div>
        </div>
      <% }); %>
      <%# 여기까지가 계산이 해준 것이라는 걸 분명히 해 둔다 %>
      <p class="rd-more">여기까지는 <b>계산이 뽑아낸 것</b>입니다.
        사주를 신청하시면 이 여덟 글자를 사람이 직접 읽고,
        <b>지금 무엇을 결정해야 하는지</b>까지 훨씬 자세히 풀어 적어 보내드립니다.</p>
    </div>
  <% } %>

  <div class="more-box">
    <span class="eyebrow">여기서부터는 사람이 읽습니다</span>
    <h2 class="sec-t">대운 해석 · 직업 적성 · 올해 월별 운</h2>
    <p class="tz"><%= teaser %></p>
  </div>

  <div class="cta" id="join">
    <% if (joined) { %>
      <h2>신청하셨습니다</h2>
      <p>남겨주신 번호로 연락드리겠습니다. 감사합니다.</p>
    <% } else { %>
      <h2>대운 해석 · 직업 적성 · 올해 월별 운은<br>사주 신청에서 이어집니다</h2>
      <p>위까지는 계산이 해준 것입니다.
        여기서부터는 원국을 직접 읽고 <%= name ? name + '님' : '이 사주' %>에 맞춰 풀어 드립니다.</p>
      <ul>
        <li>지금 대운이 어떤 십 년인지, 무엇을 준비해야 하는지</li>
        <li>어떤 일이 맞고 어떤 자리에서 힘이 빠지는지</li>
        <li>올해 달마다의 흐름과 조심할 달</li>
      </ul>

      <%# 웹사이트 「상담 신청」과 같은 칸을 받는다. 그래야 사주 신청자 목록으로
          바로 넘어간다. 방금 만세력에 넣으신 값은 미리 채워 둔다. %>
      <%# ⚠️ onsubmit="return false" 를 태그에 직접 건다.
          아래 스크립트가 한 번이라도 실패하면 폼이 그대로 전송돼
          만세력 입력 화면으로 튕겨 나간다. 그때도 안 넘어가게 막는 자물쇠다. %>
      <form id="jf" onsubmit="return false">
        <div class="fld">
          <label for="jn">이름 <i>*</i></label>
          <input type="text" name="name" id="jn" maxlength="30" required
                 placeholder="홍길동" value="<%= pre.name %>" autocomplete="name">
        </div>

        <div class="fld">
          <label>성별 <i>*</i></label>
          <div class="seg">
            <label><input type="radio" name="gender" value="남" <%= pre.gender === '남' ? 'checked' : '' %> required><span>남성</span></label>
            <label><input type="radio" name="gender" value="여" <%= pre.gender === '여' ? 'checked' : '' %>><span>여성</span></label>
          </div>
        </div>

        <div class="fld">
          <label>생년월일 <i>*</i></label>
          <div class="g3">
            <input type="number" name="year" value="<%= pre.year %>" min="1900" max="2100" required aria-label="년">
            <input type="number" name="month" value="<%= pre.month %>" min="1" max="12" required aria-label="월">
            <input type="number" name="day" value="<%= pre.day %>" min="1" max="31" required aria-label="일">
          </div>
        </div>

        <div class="fld">
          <label>달력 <i>*</i></label>
          <div class="seg c3">
            <% ['양력','음력','윤달'].forEach(function(cv){ %>
              <label><input type="radio" name="cal" value="<%= cv %>" <%= pre.cal === cv ? 'checked' : '' %>><span><%= cv %></span></label>
            <% }); %>
          </div>
        </div>

        <div class="fld">
          <label for="jh">태어난 시각</label>
          <input type="time" name="hour" id="jh" step="60" value="<%= pre.hour %>">
          <label class="chk sm"><input type="checkbox" id="jhu" <%= pre.hourUnknown ? 'checked' : '' %>>
            <span>태어난 시간을 몰라요</span></label>
        </div>

        <div class="fld">
          <label for="jr">태어난 지역</label>
          <select name="region" id="jr">
            <option value="">모르겠어요</option>
            <% regions.forEach(function(r){ %>
              <option value="<%= r.name %>" <%= pre.region === r.name ? 'selected' : '' %>><%= r.name %></option>
            <% }); %>
          </select>
          <label class="chk sm"><input type="checkbox" name="useLocalSolarTime" value="on" <%= pre.localTime ? 'checked' : '' %>>
            <span>지역시(진태양시) 보정 적용</span></label>
        </div>

        <div class="fld">
          <label for="jp">연락처 <i>*</i></label>
          <input type="tel" name="phone" id="jp" maxlength="20" required
                 placeholder="010-0000-0000" inputmode="numeric" autocomplete="tel">
        </div>

        <div class="fld">
          <label for="je">이메일 <i>*</i></label>
          <input type="email" name="email" id="je" maxlength="120" required
                 placeholder="example@naver.com" autocomplete="email">
          <p class="hint">완성된 PDF 사주 리포트를 이 메일로 보내드립니다.</p>
        </div>

        <% if (af.products.length) { %>
          <div class="fld">
            <label for="jpr">상품 <i>*</i></label>
            <select name="product" id="jpr" required>
              <option value="">선택해주세요</option>
              <% af.products.forEach(function(pr){ %><option><%= pr %></option><% }); %>
            </select>
          </div>
        <% } %>

        <div class="fld">
          <label for="jm">묻고 싶은 것</label>
          <textarea name="memo" id="jm" maxlength="500" placeholder="가장 궁금한 한 가지를 적어주세요"></textarea>
        </div>

        <div class="fld ptw">
          <label class="chk"><input type="checkbox" id="jpt">
            <span>💑 <b>연인궁합 · 재회운</b>인가요? 상대방 정보도 넣어주세요</span></label>
          <div class="ptf" id="jptf" hidden>
            <input type="text" name="partner_name" maxlength="30" placeholder="상대방 이름 (선택)">
            <div class="seg">
              <label><input type="radio" name="partner_gender" value="남"><span>남</span></label>
              <label><input type="radio" name="partner_gender" value="여"><span>여</span></label>
            </div>
            <input type="text" name="partner_birth" maxlength="20" placeholder="상대방 생년월일 (예: 1992-05-05)" inputmode="numeric">
            <select name="partner_calendar">
              <option value="양력">양력</option><option value="음력">음력</option><option value="윤달">윤달</option>
            </select>
            <input type="text" name="partner_hour" maxlength="20" placeholder="상대방 태어난 시각 (모르면 비워두세요)">
          </div>
        </div>

        <label class="chk">
          <input type="checkbox" name="agree" id="ja" required>
          <span><b>[필수] 개인정보 수집 및 이용 동의</b><br><%= af.agree %></span>
        </label>

        <div id="jmsg"></div>
        <button class="btn gold" type="submit"><%= af.submit %></button>
        <p class="fine">만 14세 이상만 신청하실 수 있습니다.
          <% if (t.kakao_consult_link && !t.bank_account) { %>보내시면 곧바로 카카오톡 상담창이 열립니다.<% } %></p>
      </form>
    <% } %>
  </div>

  <p style="font-size:12.5px;color:var(--faint);line-height:1.85;margin:0 0 10px">
    이 풀이는 사주 명리의 일반적인 해석을 계산해 보여드리는 것입니다.
    의료·법률·투자 판단의 근거로 쓰지 마세요.</p>
  <a class="btn ghost" href="<%= base || '/' %>">다른 사주 보기</a>
  <% if (reading.alias) { %>
    <p style="text-align:center;margin:14px 0 0;font-size:13px">
      <a href="<%= base %>/guide/ilju/<%= encodeURIComponent(c.일주) %>"
         style="color:var(--gold-d);font-weight:700"><%= c.일주 %> 일주 자세히 보기 →</a></p>
  <% } %>
</main>

<footer class="foot">
  <div class="wrap">
    <%= siteName %><br>
    무료 만세력 · 오늘의 운세
  </div>
</footer>

<script>
(function(){
  var f = document.getElementById('jf');
  if (!f) return;
  var msg = document.getElementById('jmsg');
  /* ⚠️ 교육생이 적은 글이라 따옴표나 줄바꿈이 들어 있을 수 있다.
     스크립트 안에 그대로 박으면 그 한 글자에 화면 전체가 죽는다.
     JSON 으로 넘겨 글자 그대로만 쓴다. */
  var DONE = <%- JSON.stringify(af.done || '접수되었습니다.').split('<').join('\\u003c') %>;
  function say(kind, t){
    msg.innerHTML = '<div class="' + kind + '">' +
      String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;')
        .split(String.fromCharCode(10)).join('<br>') + '</div>';
  }

  /* 시간을 모른다고 하면 시각 칸을 비우고 잠근다 */
  var hu = document.getElementById('jhu'), hi = document.getElementById('jh');
  function syncHour(){ if (!hu || !hi) return; hi.disabled = hu.checked; if (hu.checked) hi.value = ''; }
  if (hu) { hu.addEventListener('change', syncHour); syncHour(); }

  /* 궁합 칸은 눌렀을 때만 편다 */
  var pt = document.getElementById('jpt'), ptf = document.getElementById('jptf');
  if (pt && ptf) pt.addEventListener('change', function(){ ptf.hidden = !pt.checked; });

  /* 보낸 뒤에도 다시 보낼 수 있게 단추를 되살린다 */
  function again(btn, was) {
    btn.disabled = false;
    btn.textContent = '고쳐서 다시 보내기';
  }

  f.addEventListener('submit', function(e){
    e.preventDefault();
    var b = f.querySelector('button[type=submit]');
    var was = b.textContent;
    b.disabled = true; b.textContent = '보내는 중…';

    /* 웹사이트 상담 신청과 같은 칸을 그대로 보낸다 */
    var body = new URLSearchParams();
    var one = ['name','phone','email','memo','product','region','hour','year','month','day',
               'partner_name','partner_birth','partner_hour','partner_calendar'];
    one.forEach(function(k){ var el = f.elements[k]; if (el) body.set(k, el.value || ''); });
    ['gender','cal','partner_gender'].forEach(function(k){
      var el = f.elements[k]; if (!el) return;
      var v = el.value;
      if (el.length !== undefined && el.value === undefined) {
        v = ''; for (var i = 0; i < el.length; i++) if (el[i].checked) v = el[i].value;
      }
      body.set(k, v || '');
    });
    var lt = f.elements.useLocalSolarTime;
    body.set('useLocalSolarTime', lt && lt.checked ? 'on' : '');
    body.set('agree', f.elements.agree.checked ? 'on' : '');

    fetch('<%= joinTo %>', {
      method:'POST', headers:{'content-type':'application/x-www-form-urlencoded'}, body:body
    }).then(function(r){ return r.json(); }).then(function(j){
      if (!j.ok) {
        b.disabled = false; b.textContent = was;
        say('err', j.error || '보내지 못했습니다. 잠시 뒤 다시 해주세요.');
        return;
      }
      /* 계좌를 넣어 두셨으면 입금 안내를 그 자리에 펼친다 —
         웹사이트 상담 신청과 같은 카드다. 초록 글 한 줄로는 눈에 안 들어온다. */
      if (j.bank) {
        var k = j.bank;
        var esc2 = function (v) {
          return String(v == null ? '' : v).replace(/&/g, '&amp;')
            .replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        };
        var row = function (name, val, acc) {
          if (!val) return '';
          return '<div class="bk-row"><span class="k">' + name + '</span>' +
            '<span class="v' + (acc ? ' acc" data-acc' : '"') + '>' + esc2(val) + '</span>' +
            (acc ? '<button type="button" class="bk-copy" data-copy>복사</button>' : '') + '</div>';
        };
        /* 계좌 카드는 팝업과 아래쪽 두 곳에 똑같이 들어간다 */
        var card = function () {
          return '<div class="bk-card">' +
            '<div class="bk-hd">입금 계좌 안내</div>' +
            (k.amount ? '<div class="bk-amt"><span class="lb">입금하실 금액</span>' +
              '<span class="num">' + k.amount.toLocaleString('ko-KR') + '원</span>' +
              (k.product ? '<span class="pd">' + esc2(k.product) + '</span>' : '') + '</div>' : '') +
            row('은행', k.bankName) +
            row('계좌번호', k.account, true) +
            row('예금주', k.holder) +
            (k.notice ? '<div class="bk-note">' + esc2(k.notice) + '</div>' : '') +
            '</div>';
        };

        var box = f.parentNode;
        /* ⚠️ 폼을 지우지 않는다. 고칠 것이 있으면 다시 보내야 하기 때문이다.
           안내는 폼 위에 끼워 넣고, 폼은 값이 담긴 채 그대로 아래에 남는다.
           팝업을 닫아도 계좌를 다시 볼 수 있게 여기에도 같은 카드를 둔다. */
        var done = box.querySelector('#jdone');
        if (!done) {
          done = document.createElement('div');
          done.id = 'jdone';
          box.insertBefore(done, f);
        }
        done.innerHTML = '<div class="bk">' +
          '<div class="bk-done">' + esc2(DONE) + '</div>' + card() + '</div>' +
          '<p class="bk-again">고치실 것이 있으면 <b>아래에서 다시 넣어</b> 보내주세요. ' +
          '마지막에 보내주신 것으로 봐 드립니다.</p>';
        again(b, was);

        /* 한눈에 들어오도록 화면 위에 띄운다 */
        var pop = document.createElement('div');
        pop.className = 'bkpop';
        pop.innerHTML = '<div class="bkpop-in" role="dialog" aria-label="입금 계좌 안내">' +
          '<button type="button" class="bkpop-x" data-x aria-label="닫기">×</button>' +
          '<div class="bkpop-done">' + esc2(DONE) + '</div>' + card() +
          '<button type="button" class="bk-ok" data-x>확인</button>' +
          '</div>';
        box.appendChild(pop);

        /* 팝업이 떠 있는 동안 뒤쪽이 밀려 움직이지 않게 */
        var html = document.documentElement;
        var lock = html.style.overflow;
        html.style.overflow = 'hidden';
        var close = function () {
          if (!pop.parentNode) return;
          pop.parentNode.removeChild(pop);
          html.style.overflow = lock;
          document.removeEventListener('keydown', onKey);
        };
        var onKey = function (e) { if (e.key === 'Escape') close(); };
        document.addEventListener('keydown', onKey);
        pop.addEventListener('click', function (e) {
          /* X·확인을 누르거나, 팝업 바깥 어두운 곳을 눌러도 닫힌다 */
          if (e.target === pop || (e.target.hasAttribute && e.target.hasAttribute('data-x'))) close();
        });

        /* 계좌번호 복사 — 숫자만 남겨야 바로 붙여넣어진다.
           팝업과 아래쪽 두 곳에 다 걸어 준다. */
        Array.prototype.forEach.call(box.querySelectorAll('[data-copy]'), function (cp) {
          cp.addEventListener('click', function () {
            var wrap = cp.closest('.bk-card');
            var txt = ((wrap && wrap.querySelector('[data-acc]').textContent) || '').replace(/[^0-9]/g, '');
            var done2 = function () {
              cp.textContent = '복사됨';
              setTimeout(function () { cp.textContent = '복사'; }, 1600);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(txt).then(done2, function () { alert(txt); });
            } else { alert(txt); }
          });
        });
        return;
      }
      /* ⚠️ 예전에는 여기서 카톡으로 바로 넘겼다. 그러면 손님이 방금 본
         만세력을 잃는다. 화면은 그대로 두고 눌러서 갈 수 있게만 한다. */
      var box2 = f.parentNode;
      var done2 = box2.querySelector('#jdone');
      if (!done2) {
        done2 = document.createElement('div');
        done2.id = 'jdone';
        box2.insertBefore(done2, f);
      }
      again(b, was);
      if (j.kakao) {
        done2.innerHTML = '<div class="bk">' +
          '<div class="bk-done">' + (function (v) {
            return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          })(DONE) + '</div>' +
          '<a class="bk-ok" href="' + String(j.kakao).replace(/"/g, '&quot;') +
          '" target="_blank" rel="noopener" style="text-align:center;text-decoration:none">' +
          '카카오톡으로 상담하기</a>' +
          '<p class="bk-stay">이 창은 그대로 두셔도 됩니다. 방금 보신 만세력은 여기 남아 있습니다.</p>' +
          '</div>';
        return;
      }
      done2.innerHTML = '<div class="bk"><div class="bk-thanks">' +
        String(DONE).replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</div></div>' +
        '<p class="bk-again">고치실 것이 있으면 <b>아래에서 다시 넣어</b> 보내주세요. ' +
        '마지막에 보내주신 것으로 봐 드립니다.</p>';
    }).catch(function(){
      b.disabled = false; b.textContent = was;
      say('err', '연결이 끊겼습니다. 잠시 뒤 다시 해주세요.');
    });
  });
})();
</script>
</body>
</html>
