<%- include('_head', {
  siteName: siteName, themeVars: themeVars, base: base,
  pageTitle: a.title, pageDesc: a.summary,
}) %>

<%- include('_guide-css') %>
<main>
  <section class="wrap sec">
    <span class="eyebrow"><a href="<%= base %>/guide">사주 공부</a></span>
    <h1><%= a.title %></h1>
    <p class="lead" style="margin-bottom:0"><%= a.summary %></p>
  </section>

  <section class="wrap" style="padding-bottom:8px">
    <div class="card art">
      <%
        /* 'h' 로 시작하면 소제목, 'l' 로 시작하면 목록. 나머지는 문단이다.
           fmt() 가 글자를 먼저 escape 하고 **굵게**·[[슬러그|글자]] 만 되살린다.
           그래서 그대로 내보내도 글 속 꺾쇠가 태그로 실행되지 않는다.
           (주석 안에도 ejs 여는 표시를 적으면 안 된다. 화면이 통째로 깨진다) */
        var open = false;
        a.body.forEach(function(line){
          var kind = line[0];
          var text = (kind === 'h' || kind === 'l') ? line.slice(1) : line;
          if (kind === 'l') {
            if (!open) { %><ul><% open = true; }
            %><li><%- fmt(text, base) %></li><%
          } else {
            if (open) { %></ul><% open = false; }
            if (kind === 'h') { %><h2><%- fmt(text, base) %></h2><% }
            else { %><p><%- fmt(text, base) %></p><% }
          }
        });
        if (open) { %></ul><% }
      %>
    </div>
  </section>

  <%- include('_back') %>

  <% if (others.length) { %>
    <section class="wrap sec">
      <h2 class="sec-t">이어서 읽기</h2>
      <div class="list">
        <% others.forEach(function(o){ %>
          <a class="it" href="<%= base %>/guide/<%= o.slug %>" style="display:block">
            <b style="font-size:14.5px;display:block;margin-bottom:3px"><%= o.title %></b>
            <span style="font-size:12.5px;color:var(--faint);line-height:1.7"><%= o.summary %></span>
          </a>
        <% }); %>
      </div>
    </section>
  <% } %>
</main>

<%- include('_guide-foot') %>
