    <%# 사업자 정보 — 전자상거래법에 따라 손님이 볼 수 있는 곳에 적어야 한다.
        환경변수를 하나도 안 채우면 이 칸은 통째로 안 나온다. %>
    <% if (biz && biz.has) { %>
      <div class="biz">
        <button type="button" class="biz-tog" id="bizTog" aria-expanded="false" aria-controls="bizBox">
          사업자정보 <span aria-hidden="true">▾</span>
        </button>
        <dl class="biz-box" id="bizBox" hidden>
          <% biz.rows.forEach(function(r){ %>
            <div><dt><%= r.label %></dt><dd><%= r.value %></dd></div>
          <% }); %>
        </dl>
      </div>
    <% } %>

    <div class="copy">© <%= (biz && biz.name) || '루월당' %> · 무단 복제·배포 금지</div>
  </div>
</footer>

<script>
  (function () {
    // 사업자정보 펼치기
    var t = document.getElementById('bizTog'), b = document.getElementById('bizBox');
    if (t && b) t.addEventListener('click', function () {
      var open = b.hasAttribute('hidden');
      if (open) b.removeAttribute('hidden'); else b.setAttribute('hidden', '');
      t.setAttribute('aria-expanded', open ? 'true' : 'false');
      t.querySelector('span').textContent = open ? '▴' : '▾';
    });

    // 폰 메뉴
    var mt = document.getElementById('menuTog'), m = document.getElementById('menu');
    mt.addEventListener('click', function () {
      var open = m.classList.toggle('open');
      mt.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    m.addEventListener('click', function (e) {
      if (e.target.closest('a')) { m.classList.remove('open'); mt.setAttribute('aria-expanded', 'false'); }
    });

    // 스크롤하면 떠오르기
    var els = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('on'); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      els.forEach(function (el) { io.observe(el); });
    } else {
      els.forEach(function (el) { el.classList.add('on'); });
    }

    /* 일진첩 예시 — 한국 시간 기준 날짜의 일진.
       일진첩은 밤 11시에 다음날로 넘어가므로 여기서도 23시부터 다음날을 보여준다.
       2000-01-01 은 戊午日(60갑자 54번째)이다. */
    var HAN_S = '甲乙丙丁戊己庚辛壬癸', HAN_B = '子丑寅卯辰巳午未申酉戌亥';
    var KO_S = '갑을병정무기경신임계', KO_B = '자축인묘진사오미신유술해', DOW = '일월화수목금토';
    var k = new Date(Date.now() + 9 * 3600e3);
    var day = Date.UTC(k.getUTCFullYear(), k.getUTCMonth(), k.getUTCDate()) + (k.getUTCHours() >= 23 ? 864e5 : 0);
    var d = new Date(day);
    var n = Math.round((day - Date.UTC(2000, 0, 1)) / 864e5);
    var i = ((54 + n) % 60 + 60) % 60;
    document.getElementById('iljinDate').textContent =
      d.getUTCFullYear() + '. ' + (d.getUTCMonth() + 1) + '. ' + d.getUTCDate() + ' (' + DOW[d.getUTCDay()] + ')';
    document.getElementById('iljinHan').textContent = HAN_S[i % 10] + HAN_B[i % 12] + '日';
    document.getElementById('iljinKo').textContent = KO_S[i % 10] + KO_B[i % 12] + '일';
  })();
</script>

</body>
