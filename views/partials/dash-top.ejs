<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : '홈' %> · 루월당</title>
  <!-- 홈 화면에 추가하면 앱처럼 쓸 수 있고, 아이폰에서도 알림을 받을 수 있다 -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#B59A62">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="루월당">
  <link rel="apple-touch-icon" href="/img/logo-luwol-180.png">
  <link rel="icon" href="/img/favicon.png">
  <link rel="stylesheet" href="/css/dashboard.css">
  <style>
    /* 사이드바 로고 — 남색 배경 위에 얹힌다 */
    .brand-mini{ display:flex; align-items:center; gap:10px; }
    .brand-logo{ width:34px; height:34px; flex:0 0 auto; display:block; }
    .brand-name{ font-family:"Nanum Myeongjo", serif; }

    /* 머리말 로고 — 사이드바를 접어도 늘 보인다 */
    .top-brand { display:flex; align-items:center; gap:8px; text-decoration:none;
      color:var(--ink); flex:0 0 auto; }
    .top-logo { width:28px; height:28px; display:block; flex:0 0 auto; }
    .top-name { font-family:"Nanum Myeongjo", serif; font-size:16px; font-weight:700;
      letter-spacing:-.01em; }
    .topbar .page-title { padding-left:14px; margin-left:2px; border-left:1px solid var(--beige); }

    @media (max-width:560px) {
      .top-name { display:none; }
    }

    /* 머리말 바로가기 버튼 */
    .topgo { display:flex; gap:6px; flex:0 0 auto; }
    .topgo a {
      padding:8px 13px; border:1px solid var(--beige); border-radius:100px;
      background:var(--card); color:#4A4438; font-size:13px; font-weight:700;
      text-decoration:none; white-space:nowrap;
    }
    .topgo a:hover { border-color:var(--gold); color:#8A6F3C; }
    .topgo a.on { background:var(--navy); border-color:var(--navy); color:#fff; }

    /* 좁은 화면에서는 자리를 아낀다 */
    @media (max-width:900px) {
      .topgo a { padding:8px 11px; font-size:12.5px; }
      .topbar .who { display:none; }
    }
    @media (max-width:560px) {
      /* 여백은 .topbar-in 이 준다. 여기서 또 주면 머리말이 두 겹으로 두꺼워져
         그 아래 붙는 줄(주차 목록 등)이 머리말에 가려진다. */
      .topbar .page-title { font-size:16px; }
      .topgo { gap:4px; }
      .topgo a { padding:7px 9px; font-size:12px; }
    }
  </style>
</head>
<body>
<% if (typeof adminAs !== 'undefined' && adminAs) { %>
  <div class="as-bar">
    <span class="as-txt">👤 <b><%= adminAs.viewing %></b> 님 계정으로 보는 중입니다</span>
    <a class="as-back" href="/auth/back">관리자로 돌아가기</a>
  </div>
  <style>
    .as-bar{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap;
      background:#5b4a8a;color:#fff;padding:9px 14px;font-size:13.5px}
    .as-txt b{color:#ffe9a8}
    .as-back{background:var(--card);color:#4a3d6b;padding:5px 13px;border-radius:20px;
      font-size:12.5px;font-weight:800;text-decoration:none;white-space:nowrap}
    .as-back:hover{background:#ffe9a8}
  </style>
<% } %>
<% if (typeof testSwitch !== 'undefined' && testSwitch) { %>
  <div class="test-switch-bar">
    <span class="tsb-label">🧪 테스트</span>
    <% testSwitch.accounts.forEach(function (u) { %>
      <% if (u === testSwitch.current) { %>
        <span class="tsb-chip on"><%= u %></span>
      <% } else { %>
        <a class="tsb-chip" href="/auth/switch?to=<%= encodeURIComponent(u) %>"><%= u %></a>
      <% } %>
    <% }); %>
  </div>
  <style>
    .test-switch-bar{position:sticky;top:0;z-index:200;display:flex;align-items:center;gap:6px;
      flex-wrap:wrap;padding:7px 12px;background:#241a06;color:#e8e3d6;font-size:12.5px;
      font-family:-apple-system,'Malgun Gothic',sans-serif}
    .tsb-label{font-weight:800;color:#c8a45c;margin-right:4px}
    .tsb-chip{padding:4px 11px;border-radius:20px;background:#3a3527;color:#e8e3d6;
      text-decoration:none;font-weight:600}
    .tsb-chip.on{background:#c8a45c;color:#241a06;font-weight:800}
    .tsb-chip:hover{background:#4a4436}
    .tsb-chip.on:hover{background:#c8a45c}
  </style>
<% } %>

<div class="layout">
  <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="brand-mini">
      <img src="/img/logo-luwol-96.png" alt="" class="brand-logo">
      <span class="brand-name">루월당</span>
    </div>
    <nav>
      <%
        const menu = [
          { key: 'home',    href: '/home',               label: '홈' },
          { key: 'guide',   href: '/guide',              label: '교육생 자료집' },
          { key: 'notice',  href: '/notice',             label: '공지사항' },
          { key: 'manse',   href: '/manse',              label: '만세력 계산기' },
          { key: 'threads', href: '/threads',            label: '스레드 자동화' },
          { key: 'free',    href: '/builder',            label: '내 웹사이트 만들기' },
          { key: 'leads',   href: '/leads',              label: '사주 신청자' },
          { key: 'pdf',     href: '/pdf/create',         label: 'PDF 만들기' },
          { key: 'chat',    href: '/chat',               label: '내담자 추가질문' },
          { key: 'reviews', href: '/reviews',            label: '후기' },
          { key: 'covers',  href: '/covers',             label: 'PDF 표지 꾸미기' },
          { key: 'records', href: '/records',            label: 'PDF · 이메일 발송 기록' },
          { key: 'settings',href: '/free-saju-settings', label: '무료사주 · API 설정' },
          { key: 'support', href: '/support',            label: '문의하기' },
          { key: 'account', href: '/account',            label: '내 계정' }
        ];
      %>
      <% menu.forEach(function (m) { %>
        <a href="<%= m.href %>" class="nav-item <%= active === m.key ? 'active' : '' %>"><%= m.label %></a>
      <% }); %>

      <% if (user.role === 'admin') { %>
        <div class="nav-sep">관리자</div>
        <a href="/admin/approvals" class="nav-item <%= active === 'admin' ? 'active' : '' %>">회원 승인 · 관리</a>
        <a href="/admin/covers" class="nav-item <%= active === 'admin-covers' ? 'active' : '' %>">기본 표지 관리</a>
        <a href="/admin/guide" class="nav-item <%= active === 'admin-guide' ? 'active' : '' %>">자료집 관리</a>
        <a href="/admin/notice" class="nav-item <%= active === 'admin-notice' ? 'active' : '' %>">공지 관리</a>
        <a href="/admin/support" class="nav-item <%= active === 'admin-support' ? 'active' : '' %>">문의 관리</a>
        <a href="/admin/lp-reviews" class="nav-item <%= active === 'admin-lp' ? 'active' : '' %>">판매 페이지 후기</a>
        <a href="/admin/manse" class="nav-item <%= active === 'admin-manse' ? 'active' : '' %>">만세력 연동</a>
        <a href="/admin/accounts" class="nav-item <%= active === 'admin-accounts' ? 'active' : '' %>">계정 전환</a>
      <% } %>
    </nav>
    <form method="post" action="/logout" class="logout-form">
      <button type="submit" class="logout-btn">로그아웃</button>
    </form>
  </aside>

  <div class="content">
    <header class="topbar">
      <div class="topbar-in">
      <button class="hamburger" onclick="openSidebar()" aria-label="메뉴">☰</button>
      <a class="top-brand" href="/home">
        <img src="/img/logo-luwol-96.png" alt="" class="top-logo">
        <span class="top-name">루월당</span>
      </a>
      <h1 class="page-title"><%= typeof title !== 'undefined' ? title : '홈' %></h1>

      <!-- 자주 쓰는 곳으로 바로 가는 버튼 -->
      <nav class="topgo">
        <a href="/notice"  class="<%= active === 'notice'  ? 'on' : '' %>">공지사항</a>
        <a href="/guide"   class="<%= active === 'guide'   ? 'on' : '' %>">자료집</a>
        <a href="/support" class="<%= active === 'support' ? 'on' : '' %>">문의하기</a>
      </nav>

      <span class="who"><%= user.name %> · <%= user.role === 'admin' ? '관리자' : '교육생' %></span>
      </div>
    </header>
    <main class="main">
