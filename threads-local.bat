@echo off
REM ============================================================
REM  threads-local.bat — 내 PC 에서 스레드 글 만들기
REM
REM  OpenAI 를 한 번도 안 부릅니다. Claude Code 로 씁니다.
REM
REM  자동으로 돌리려면 윈도우 「작업 스케줄러」에 이 파일을 겁니다.
REM    제어판 → 작업 스케줄러 → 작업 만들기
REM    트리거: 매일 오전 9시
REM    동작:   프로그램 시작 → 이 파일을 고릅니다
REM
REM  3일치를 미리 채우므로 하루에 한 번이면 넉넉합니다.
REM  PC 를 며칠 꺼둬도 그 사이 글은 예약대로 올라갑니다.
REM ============================================================

cd /d "%~dp0"

echo.
node scripts\threads-local.js %*

REM 스케줄러가 아니라 손으로 눌러 실행했으면 창을 남겨둔다
if "%1"=="" (
  echo.
  echo  아무 키나 누르면 닫힙니다.
  pause > nul
)
